<local:DarkWindow x:Class="AiteBar.TelegramPostEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AiteBar"
        Icon="pack://application:,,,/AiteBar;component/Resources/app.ico"
        Title="{local:Loc ResourceKey=TelegramPostEditor_Title}"
        WindowClass="Workspace"
        Width="1360" Height="840"
        MinWidth="1060" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource PrimaryText}"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        ShowInTaskbar="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AiteBar;component/SettingsWindowResources.xaml"/>
                <ResourceDictionary Source="/AiteBar;component/FormControlsResources.xaml"/>
                <ResourceDictionary Source="/AiteBar;component/UtilityWindowResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="EditorCardBrush" Color="#20252D"/>
            <SolidColorBrush x:Key="EditorSurfaceBrush" Color="#171A20"/>
            <SolidColorBrush x:Key="EditorItemHoverBrush" Color="#262D38"/>
            <SolidColorBrush x:Key="EditorBorderBrush" Color="#2E3744"/>
            <SolidColorBrush x:Key="EditorMutedTextBrush" Color="#9EA9B7"/>
            <FontFamily x:Key="EditorIconFont">pack://application:,,,/Resources/#FluentSystemIcons-Regular</FontFamily>

            <local:TelegramWorkflowStatusConverter x:Key="WorkflowStatusConverter"/>
            <local:TelegramUtcToLocalConverter x:Key="UtcToLocalConverter"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <Style x:Key="EditorTabItemStyle" TargetType="TabItem" BasedOn="{StaticResource UnderlineTabItemStyle}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Bd"
                                    Background="Transparent"
                                    BorderThickness="0,0,0,2"
                                    BorderBrush="Transparent"
                                    Margin="0,0,14,0"
                                    Padding="4,6">
                                <ContentPresenter ContentSource="Header"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  TextElement.FontSize="13"
                                                  TextElement.FontWeight="SemiBold"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                    <Setter Property="Foreground" Value="#F4F7FA"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource EditorMutedTextBrush}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Foreground" Value="#F4F7FA"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="EditorToolbarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
                <Setter Property="Background" Value="{StaticResource EditorSurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource EditorBorderBrush}"/>
                <Setter Property="Foreground" Value="#E8EDF2"/>
                <Setter Property="Height" Value="{StaticResource ToolbarControlHeight}"/>
                <Setter Property="MinWidth" Value="28"/>
                <Setter Property="Padding" Value="8,0"/>
                <Setter Property="Margin" Value="0,0,4,0"/>
            </Style>

            <Style x:Key="TelegramPostListItemStyle" TargetType="ListBoxItem">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="ItemBorder"
                                    Background="{StaticResource EditorSurfaceBrush}"
                                    BorderBrush="{StaticResource EditorBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,8">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource EditorItemHoverBrush}"/>
                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#3E4C5E"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="#1E3144"/>
                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Action Bar -->
        <Border Grid.Row="0"
                Background="{StaticResource EditorCardBrush}"
                BorderBrush="{StaticResource EditorBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,8"
                Margin="0,0,0,10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnNewPost"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="34"
                            Padding="12,0"
                            Margin="0,0,8,0"
                            Click="BtnNewPost_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xF10A;" FontFamily="{StaticResource EditorIconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{local:Loc ResourceKey=TelegramPostEditor_NewPost}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnFromTemplate"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="34"
                            Padding="12,0"
                            Margin="0,0,8,0"
                            Click="BtnFromTemplate_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE4DA;" FontFamily="{StaticResource EditorIconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{local:Loc ResourceKey=TelegramPostEditor_FromTemplate}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnSavePost"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="34"
                            Padding="12,0"
                            Margin="0,0,8,0"
                            Click="BtnSavePost_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE4DF;" FontFamily="{StaticResource EditorIconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{local:Loc ResourceKey=Common_Save}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnExportJson"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="34"
                            Padding="12,0"
                            Click="BtnExportJson_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xF401;" FontFamily="{StaticResource EditorIconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{local:Loc ResourceKey=TelegramPostEditor_ExportJson}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border DockPanel.Dock="Right"
                        Background="{StaticResource EditorSurfaceBrush}"
                        BorderBrush="{StaticResource EditorBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10,5"
                        VerticalAlignment="Center"
                        ToolTip="{local:Loc ResourceKey=TelegramPostEditor_LocalModeTooltip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEAC3;" FontFamily="{StaticResource EditorIconFont}" FontSize="14" Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TxtModeBadge"
                                   Text="{local:Loc ResourceKey=TelegramPostEditor_LocalModeBadge}"
                                   Foreground="{StaticResource EditorMutedTextBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Main Three-Pane Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" MinWidth="240"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*" MinWidth="460"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="380" MinWidth="330"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Library -->
            <Border Grid.Column="0"
                    Background="{StaticResource EditorCardBrush}"
                    BorderBrush="{StaticResource EditorBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="&#xE8AF;" FontFamily="{StaticResource EditorIconFont}" FontSize="15" Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{local:Loc ResourceKey=TelegramPostEditor_LibraryHeader}" FontSize="14" FontWeight="SemiBold" Foreground="#F4F7FA" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <TextBox x:Name="TxtSearchPosts"
                                 Padding="30,0,10,0"
                                 VerticalContentAlignment="Center"
                                 TextChanged="TxtSearchPosts_TextChanged"/>
                        <TextBlock Text="&#xF690;"
                                   FontFamily="{StaticResource EditorIconFont}"
                                   FontSize="15"
                                   Foreground="{StaticResource EditorMutedTextBrush}"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                        <TextBlock x:Name="TxtSearchPlaceholder"
                                   Text="{local:Loc ResourceKey=TelegramPostEditor_SearchPlaceholder}"
                                   Foreground="{StaticResource EditorMutedTextBrush}"
                                   FontSize="12"
                                   Margin="34,0,10,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="0.9*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="CmbLibraryFilter" Grid.Column="0" SelectionChanged="CmbLibraryFilter_SelectionChanged"/>
                        <ComboBox x:Name="CmbLibrarySort" Grid.Column="2" SelectionChanged="CmbLibrarySort_SelectionChanged"/>
                    </Grid>

                    <ListBox x:Name="LstPosts"
                             Grid.Row="3"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource TelegramPostListItemStyle}"
                             SelectionChanged="LstPosts_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="&#xF3DC;"
                                               FontFamily="{StaticResource EditorIconFont}"
                                               FontSize="15"
                                               Foreground="{StaticResource EditorMutedTextBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="#F4F7FA"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,2"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding WorkflowStatus, Converter={StaticResource WorkflowStatusConverter}}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource EditorMutedTextBrush}"/>
                                            <TextBlock Text=" · " FontSize="11" Foreground="{StaticResource EditorMutedTextBrush}"/>
                                            <TextBlock Text="{Binding UpdatedUtc, Converter={StaticResource UtcToLocalConverter}}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource EditorMutedTextBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="4" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnDuplicatePost"
                                Grid.Column="0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="34"
                                Padding="8,0"
                                Click="BtnDuplicatePost_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xF32C;" FontFamily="{StaticResource EditorIconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{local:Loc ResourceKey=TelegramPostEditor_Duplicate}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnDeleteOrRestorePost"
                                Grid.Column="2"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="34"
                                Padding="8,0"
                                Click="BtnDeleteOrRestorePost_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xF34D;" FontFamily="{StaticResource EditorIconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtDeleteOrRestoreLabel" Text="{local:Loc ResourceKey=TelegramPostEditor_MoveToTrash}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Center: Editor + AI Panel -->
            <Border Grid.Column="2"
                    Background="{StaticResource EditorCardBrush}"
                    BorderBrush="{StaticResource EditorBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="&#xF3DC;" FontFamily="{StaticResource EditorIconFont}" FontSize="15" Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{local:Loc ResourceKey=TelegramPostEditor_EditorHeader}" FontSize="14" FontWeight="SemiBold" Foreground="#F4F7FA" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Single Clean Draft Title -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <TextBox x:Name="TxtPostTitle" VerticalContentAlignment="Center" Padding="10,0" TextChanged="EditorMetadata_Changed"/>
                        <TextBlock x:Name="TxtPostTitlePlaceholder"
                                   Text="{local:Loc ResourceKey=TelegramPostEditor_DraftTitleLabel}"
                                   Foreground="{StaticResource EditorMutedTextBrush}"
                                   FontSize="12"
                                   Margin="12,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>

                    <!-- Formatting Toolbar -->
                    <Border Grid.Row="2"
                            Background="{StaticResource EditorSurfaceBrush}"
                            BorderBrush="{StaticResource EditorBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="6,5"
                            Margin="0,0,0,8">
                        <WrapPanel VerticalAlignment="Center">
                            <Button Style="{StaticResource EditorToolbarIconButtonStyle}"
                                    Width="32" Padding="0"
                                    ToolTip="{local:Loc ResourceKey=QuickNote_Bold}"
                                    Click="BtnBold_Click">
                                <TextBlock Text="&#xF7A5;" FontFamily="{StaticResource EditorIconFont}" FontSize="15"/>
                            </Button>
                            <Button Style="{StaticResource EditorToolbarIconButtonStyle}"
                                    Width="32" Padding="0"
                                    ToolTip="{local:Loc ResourceKey=QuickNote_Italic}"
                                    Click="BtnItalic_Click">
                                <TextBlock Text="&#xF7F4;" FontFamily="{StaticResource EditorIconFont}" FontSize="15"/>
                            </Button>
                            <Button Style="{StaticResource EditorToolbarIconButtonStyle}"
                                    Width="32" Padding="0"
                                    ToolTip="{local:Loc ResourceKey=QuickNote_Underline}"
                                    Click="BtnUnderline_Click">
                                <TextBlock Text="&#xF80A;" FontFamily="{StaticResource EditorIconFont}" FontSize="15"/>
                            </Button>
                            <Button Style="{StaticResource EditorToolbarIconButtonStyle}"
                                    Width="32" Padding="0" Margin="0,0,8,0"
                                    ToolTip="{local:Loc ResourceKey=QuickNote_Strikethrough}"
                                    Click="BtnStrike_Click">
                                <TextBlock Text="&#xED60;" FontFamily="{StaticResource EditorIconFont}" FontSize="15"/>
                            </Button>
                            <Border Width="1" Background="{StaticResource EditorBorderBrush}" Margin="0,4,8,4"/>
                            <Button Content="{local:Loc ResourceKey=TelegramPostEditor_Spoiler}" Style="{StaticResource EditorToolbarIconButtonStyle}" Padding="10,0" Click="BtnSpoiler_Click"/>
                            <Button Style="{StaticResource EditorToolbarIconButtonStyle}" Padding="10,0" Click="BtnInlineCode_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xF2EF;" FontFamily="{StaticResource EditorIconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="{local:Loc ResourceKey=TelegramPostEditor_InlineCode}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource EditorToolbarIconButtonStyle}" Padding="10,0" Click="BtnQuote_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xF800;" FontFamily="{StaticResource EditorIconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="{local:Loc ResourceKey=TelegramPostEditor_Quote}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource EditorToolbarIconButtonStyle}" Padding="10,0" Margin="0" Click="BtnAddMedia_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xF48C;" FontFamily="{StaticResource EditorIconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="{local:Loc ResourceKey=TelegramPostEditor_AddMedia}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </Border>

                    <!-- Structured AI Bar -->
                    <Border Grid.Row="3"
                            Background="{StaticResource EditorSurfaceBrush}"
                            BorderBrush="{StaticResource EditorBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="6"
                            Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" MinWidth="130"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="1.1*" MinWidth="130"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="1.1*" MinWidth="130"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CmbAiModel" Grid.Column="0"/>
                            <ComboBox x:Name="CmbInstruction" Grid.Column="2" DisplayMemberPath="Title"/>
                            <ComboBox x:Name="CmbAiAction" Grid.Column="4" DisplayMemberPath="DisplayName"/>
                            <StackPanel Grid.Column="6" Orientation="Horizontal">
                                <Button x:Name="BtnRunAi"
                                        Padding="12,0"
                                        Height="36"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="BtnRunAi_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xF7DA;" FontFamily="{StaticResource EditorIconFont}" FontSize="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{local:Loc ResourceKey=TelegramPostEditor_AiProcess}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnStopAi"
                                        Content="{local:Loc ResourceKey=TelegramPostEditor_AiStop}"
                                        Padding="10,0"
                                        Height="36"
                                        Margin="6,0,0,0"
                                        Visibility="Collapsed"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="BtnStopAi_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- RichTextBox with Rounded Surface Container & Placeholder -->
                    <Border Grid.Row="4"
                            Background="{StaticResource EditorSurfaceBrush}"
                            BorderBrush="{StaticResource EditorBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid>
                            <RichTextBox x:Name="PostEditorRichTextBox"
                                         Background="Transparent"
                                         Foreground="#F4F7FA"
                                         CaretBrush="#F4F7FA"
                                         BorderThickness="0"
                                         Padding="14"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         FontSize="14"
                                         TextChanged="PostEditorRichTextBox_TextChanged"/>
                            <TextBlock x:Name="TxtEditorPlaceholder"
                                       Text="{local:Loc ResourceKey=TelegramPostEditor_EditorPlaceholder}"
                                       Foreground="{StaticResource EditorMutedTextBrush}"
                                       FontSize="14"
                                       Margin="19,16,14,14"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </Border>

                    <!-- Attached Media List -->
                    <ItemsControl x:Name="LstAttachedMedia" Grid.Row="5" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource EditorSurfaceBrush}"
                                        BorderBrush="{StaticResource EditorBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8,4"
                                        Margin="0,0,6,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xF48C;" FontFamily="{StaticResource EditorIconFont}" FontSize="13" Foreground="{StaticResource EditorMutedTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding FileName}" Foreground="#F4F7FA" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <Button Tag="{Binding Id}" Width="20" Height="20" Padding="0" Style="{StaticResource SecondaryButtonStyle}" Click="BtnRemoveMedia_Click">
                                            <TextBlock Text="&#xF36A;" FontFamily="{StaticResource EditorIconFont}" FontSize="11"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- AI Suggestion Drawer -->
                    <Border x:Name="AiSuggestionPanel"
                            Grid.Row="6"
                            Visibility="Collapsed"
                            Background="{StaticResource EditorSurfaceBrush}"
                            BorderBrush="{DynamicResource AccentColor}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            Margin="0,8,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="120"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="TxtAiMeta" Grid.Row="0" FontSize="11" Foreground="{StaticResource EditorMutedTextBrush}" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtAiSuggestion"
                                     Grid.Row="1"
                                     Height="Auto"
                                     Padding="8"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"
                                     AcceptsReturn="True"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="{local:Loc ResourceKey=TelegramPostEditor_AiApply}" Style="{StaticResource PrimaryCompactButtonStyle}" Margin="0,0,8,0" Click="BtnApplyAi_Click"/>
                                <Button Content="{local:Loc ResourceKey=TelegramPostEditor_AiDismiss}" Style="{StaticResource SecondaryCompactButtonStyle}" Click="BtnDismissAi_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Editor Footer: Autosave + Char Counter -->
                    <DockPanel Grid.Row="7" Margin="2,10,2,0">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE89C;" FontFamily="{StaticResource EditorIconFont}" FontSize="13" Foreground="{StaticResource EditorMutedTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtStatusBar" Foreground="{StaticResource EditorMutedTextBrush}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtCharCounter"
                                   DockPanel.Dock="Right"
                                   HorizontalAlignment="Right"
                                   Foreground="{StaticResource EditorMutedTextBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Width="10" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Right: Preview, Channels, Queue -->
            <Border Grid.Column="4"
                    Background="{StaticResource EditorCardBrush}"
                    BorderBrush="{StaticResource EditorBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">
                <TabControl x:Name="RightTabs" Style="{StaticResource UnderlineTabControlStyle}">
                    <TabItem Header="{local:Loc ResourceKey=TelegramPostEditor_TabPreview}" Style="{StaticResource EditorTabItemStyle}">
                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Channel summary bar -->
                            <Border Grid.Row="0"
                                    Background="{StaticResource EditorSurfaceBrush}"
                                    BorderBrush="{StaticResource EditorBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,7"
                                    Margin="0,0,0,10">
                                <DockPanel>
                                    <TextBlock x:Name="TxtSelectedChannelsSummary" DockPanel.Dock="Left" Foreground="#E8EDF2" FontSize="12" VerticalAlignment="Center"/>
                                    <Button DockPanel.Dock="Right"
                                            HorizontalAlignment="Right"
                                            Content="{local:Loc ResourceKey=TelegramPostEditor_TabChannels}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Height="26"
                                            Padding="10,0"
                                            Click="BtnChooseChannels_Click"/>
                                </DockPanel>
                            </Border>

                            <!-- Telegram Message Bubble Preview -->
                            <Border Grid.Row="1"
                                    Background="{StaticResource EditorSurfaceBrush}"
                                    BorderBrush="{StaticResource EditorBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <Border Background="#1D2733"
                                            BorderBrush="#2C3E50"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12"
                                            VerticalAlignment="Top">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource AccentColor}" Margin="0,0,10,0">
                                                    <TextBlock Text="&#xF69A;" FontFamily="{StaticResource EditorIconFont}" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtPreviewChannel" FontWeight="SemiBold" FontSize="13" Foreground="#F4F7FA"/>
                                                    <TextBlock x:Name="TxtPreviewSubtitle" FontSize="11" Foreground="{StaticResource EditorMutedTextBrush}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <Border x:Name="PreviewMediaBadge"
                                                    Visibility="Collapsed"
                                                    Background="#263342"
                                                    CornerRadius="6"
                                                    Padding="12,18"
                                                    Margin="0,0,0,10">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="&#xF48C;" FontFamily="{StaticResource EditorIconFont}" FontSize="24" Foreground="{StaticResource EditorMutedTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                    <TextBlock x:Name="TxtPreviewMediaCount" FontSize="11" Foreground="{StaticResource EditorMutedTextBrush}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <TextBlock x:Name="TxtPreviewBody" FontSize="13" LineHeight="20" Foreground="#F4F7FA" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </ScrollViewer>
                            </Border>

                            <!-- Validation status -->
                            <TextBlock x:Name="TxtValidationStatus"
                                       Grid.Row="2"
                                       FontSize="12"
                                       Foreground="{StaticResource EditorMutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,10"/>

                            <!-- Publish Actions -->
                            <StackPanel Grid.Row="3">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnTestPublish"
                                            Grid.Column="0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Height="36"
                                            Padding="10,0"
                                            Click="BtnTestPublish_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xF69A;" FontFamily="{StaticResource EditorIconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{local:Loc ResourceKey=TelegramPostEditor_TestPublish}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnSchedulePost"
                                            Grid.Column="2"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Height="36"
                                            Padding="12,0"
                                            Click="BtnSchedulePost_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xF47E;" FontFamily="{StaticResource EditorIconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{local:Loc ResourceKey=TelegramPostEditor_Schedule}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Button x:Name="BtnPublishNow"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Height="38"
                                        Click="BtnPublishNow_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xF69A;" FontFamily="{StaticResource EditorIconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{local:Loc ResourceKey=TelegramPostEditor_PublishNow}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem x:Name="TabChannelsItem" Header="{local:Loc ResourceKey=TelegramPostEditor_TabChannels}" Style="{StaticResource EditorTabItemStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                            <StackPanel>
                                <!-- Connected bots status -->
                                <Border Background="{StaticResource EditorSurfaceBrush}"
                                        BorderBrush="{StaticResource EditorBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,8"
                                        Margin="0,0,0,10">
                                    <TextBlock x:Name="TxtConnectedBotsSummary"
                                               FontSize="12"
                                               Foreground="#E8EDF2"
                                               TextWrapping="Wrap"/>
                                </Border>

                                <TextBlock Text="{local:Loc ResourceKey=TelegramPostEditor_ChannelsSelectHeader}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Foreground="#F4F7FA"
                                           Margin="0,0,0,6"/>

                                <TextBlock x:Name="TxtNoChannelsHint"
                                           Text="{local:Loc ResourceKey=TelegramSettings_NoChannels}"
                                           FontSize="12"
                                           Foreground="{StaticResource EditorMutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8"/>

                                <ItemsControl x:Name="LstChannels" Margin="0,0,0,12">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource EditorSurfaceBrush}"
                                                    BorderBrush="{StaticResource EditorBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="10,8"
                                                    Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding IsSelected}"
                                                              Checked="ChannelSelection_Changed"
                                                              Unchecked="ChannelSelection_Changed"
                                                              Margin="0"
                                                              VerticalContentAlignment="Center">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       Foreground="#F4F7FA"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="13"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Subtitle}"
                                                                       Foreground="{Binding SubtitleBrush}"
                                                                       FontSize="11"
                                                                       TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </CheckBox>
                                                    <Button Grid.Column="1"
                                                            Tag="{Binding Channel.Id}"
                                                            Width="26" Height="26" Padding="0"
                                                            Margin="6,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            ToolTip="{local:Loc ResourceKey=Common_Delete}"
                                                            Click="BtnInlineDeleteChannel_Click">
                                                        <TextBlock Text="&#xF36A;" FontFamily="{StaticResource EditorIconFont}" FontSize="12"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Height="1" Background="{StaticResource EditorBorderBrush}" Margin="0,2,0,12"/>

                                <!-- Inline Quick Connect Bot & Channel -->
                                <TextBlock Text="{local:Loc ResourceKey=TelegramPostEditor_QuickConnectBotTitle}"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           Foreground="#F4F7FA"
                                           Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0">
                                        <PasswordBox x:Name="PwdQuickBotToken" Padding="8,0" PasswordChanged="PwdQuickBotToken_PasswordChanged"/>
                                        <TextBlock x:Name="TxtQuickBotTokenPlaceholder"
                                                   Text="{local:Loc ResourceKey=TelegramPostEditor_BotTokenPlaceholder}"
                                                   Foreground="{StaticResource EditorMutedTextBrush}"
                                                   FontSize="11"
                                                   Margin="10,0"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"/>
                                    </Grid>
                                    <Button x:Name="BtnQuickConnectBot"
                                            Grid.Column="2"
                                            Content="{local:Loc ResourceKey=TelegramPostEditor_ConnectButton}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Height="36"
                                            Padding="12,0"
                                            Click="BtnQuickConnectBot_Click"/>
                                </Grid>

                                <TextBlock Text="{local:Loc ResourceKey=TelegramPostEditor_QuickConnectChannelTitle}"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           Foreground="#F4F7FA"
                                           Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0">
                                        <TextBox x:Name="TxtQuickChannelInput" Padding="8,0" TextChanged="TxtQuickChannelInput_TextChanged"/>
                                        <TextBlock x:Name="TxtQuickChannelPlaceholder"
                                                   Text="{local:Loc ResourceKey=TelegramPostEditor_ChannelInputPlaceholder}"
                                                   Foreground="{StaticResource EditorMutedTextBrush}"
                                                   FontSize="11"
                                                   Margin="10,0"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"/>
                                    </Grid>
                                    <Button x:Name="BtnQuickConnectChannel"
                                            Grid.Column="2"
                                            Content="{local:Loc ResourceKey=TelegramPostEditor_ConnectButton}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Height="36"
                                            Padding="12,0"
                                            Click="BtnQuickConnectChannel_Click"/>
                                </Grid>

                                <CheckBox x:Name="ChkQuickTestChannel"
                                          Content="{local:Loc ResourceKey=TelegramSettings_IsTestChannel}"
                                          FontSize="12"
                                          Margin="0,2,0,12"/>

                                <Button x:Name="BtnOpenTelegramSettings"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Height="36"
                                        Padding="12,0"
                                        Click="BtnOpenTelegramSettings_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xF6A8;" FontFamily="{StaticResource EditorIconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{local:Loc ResourceKey=TelegramSettings_OpenSettings}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem x:Name="TabQueueItem" Header="{local:Loc ResourceKey=TelegramPostEditor_TabQueue}" Style="{StaticResource EditorTabItemStyle}">
                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="{local:Loc ResourceKey=TelegramPostEditor_QueueUrlLabel}" FontSize="11" Foreground="{StaticResource EditorMutedTextBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtServerUrl" VerticalContentAlignment="Center" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtPairingCode" Grid.Column="0" VerticalContentAlignment="Center" Margin="0,0,6,0" ToolTip="{local:Loc ResourceKey=TelegramPostEditor_QueuePairCodePlaceholder}"/>
                                    <Button Grid.Column="1" Content="{local:Loc ResourceKey=TelegramPostEditor_QueuePairButton}" Style="{StaticResource SecondaryButtonStyle}" Click="BtnPairServer_Click"/>
                                </Grid>
                                <TextBlock Text="{local:Loc ResourceKey=TelegramPostEditor_QueueDateLabel}" FontSize="11" Foreground="{StaticResource EditorMutedTextBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtScheduleLocal" VerticalContentAlignment="Center" Margin="0,0,0,8"/>
                                <Button Content="{local:Loc ResourceKey=TelegramPostEditor_QueueSubmitButton}" Style="{StaticResource PrimaryButtonStyle}" Click="BtnQueueServer_Click"/>
                            </StackPanel>

                            <ListBox x:Name="LstEvents"
                                     Grid.Row="1"
                                     Background="{StaticResource EditorSurfaceBrush}"
                                     BorderBrush="{StaticResource EditorBorderBrush}"
                                     BorderThickness="1">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="6,4">
                                            <TextBlock Text="{Binding EventType}" Foreground="#F4F7FA" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Text="{Binding DetailsSanitized}" FontSize="11" Foreground="{StaticResource EditorMutedTextBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</local:DarkWindow>
