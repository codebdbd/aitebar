<local:DarkWindow x:Class="AiteBar.TelegramPostEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AiteBar"
    Icon="pack://application:,,,/AiteBar;component/Resources/app.ico"
    Title="{local:Loc ResourceKey=TelegramPostEditor_Title}"
    WindowClass="Workspace" Width="1000" Height="690" MinWidth="720" MinHeight="540"
    WindowStartupLocation="CenterScreen" ResizeMode="CanResize" ShowInTaskbar="True"
    Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryText}"
    Closing="Window_Closing">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AiteBar;component/FormControlsResources.xaml"/>
                <ResourceDictionary Source="/AiteBar;component/UtilityWindowResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="ComposerSurface" Color="#252526"/>
            <SolidColorBrush x:Key="ComposerLine" Color="#37373B"/>
            <SolidColorBrush x:Key="ComposerMuted" Color="#ACACB3"/>
            <SolidColorBrush x:Key="ComposerError" Color="#F0A1A1"/>
            <local:TelegramUtcToLocalConverter x:Key="DraftDateConverter"/>
            <Style x:Key="ComposerCommand" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="MinWidth" Value="30"/>
                <Setter Property="Padding" Value="9,0"/>
                <Setter Property="Margin" Value="0,0,4,0"/>
            </Style>
            <Style x:Key="ComposerHeading" TargetType="TextBlock">
                <Setter Property="FontSize" Value="24"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,0,14"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="ComposerIcon" TargetType="Button" BasedOn="{StaticResource ComposerCommand}">
                <Setter Property="FontFamily" Value="pack://application:,,,/AiteBar;component/Resources/#FluentSystemIcons-Regular"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="Width" Value="30"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,3,0"/>
                <Style.Triggers>
                    <Trigger Property="Tag" Value="Active">
                        <Setter Property="Background" Value="{StaticResource ComposerSurface}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource ComposerLine}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ComposerCaption" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource ComposerMuted}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="ComposerMenu" TargetType="ContextMenu" BasedOn="{StaticResource DarkContextMenu}">
                <Setter Property="Background" Value="{StaticResource ComposerSurface}"/>
                <Setter Property="MinWidth" Value="190"/>
            </Style>
            <Style x:Key="ComposerNavigation" TargetType="Button" BasedOn="{StaticResource ComposerCommand}">
                <Style.Triggers>
                    <Trigger Property="Tag" Value="Active">
                        <Setter Property="Background" Value="#203242"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ComposerDraftItem" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="DraftRow" Background="Transparent" BorderBrush="{StaticResource ComposerLine}"
                                    BorderThickness="0,0,0,1" Padding="8,1">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="DraftRow" Property="Background" Value="{StaticResource ComposerSurface}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="DraftRow" Property="Background" Value="#203242"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="DraftRow" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <DataTemplate x:Key="PublicationRow">
                <Border BorderBrush="{StaticResource ComposerLine}" BorderThickness="0,0,0,1" Padding="0,10">
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Status}" FontSize="13" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding Details}" Style="{StaticResource ComposerCaption}" Margin="0,2,0,0"/>
                            <WrapPanel>
                                <Button Content="{local:Loc ResourceKey=TelegramComposer_OpenPublished}" Style="{StaticResource ComposerCommand}"
                                        Tag="{Binding Link}" Click="OpenPublished_Click" Visibility="{Binding LinkVisibility}"/>
                                <Button Content="{local:Loc ResourceKey=TelegramComposer_Reschedule}" Style="{StaticResource ComposerCommand}"
                                        Tag="{Binding Target}" Click="Reschedule_Click" Visibility="{Binding RescheduleVisibility}"/>
                            </WrapPanel>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="{StaticResource ComposerSurface}" BorderBrush="{StaticResource ComposerLine}"
                BorderThickness="0,0,0,1" Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel x:Name="WorkspaceNavigation" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="108" Margin="0,0,10,0">
                        <TextBlock x:Name="EditorLocation" Text="{local:Loc ResourceKey=TelegramComposer_Editor}"
                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="9,0"/>
                        <Button x:Name="BackNavigationButton" Style="{StaticResource ComposerCommand}" Click="BackNavigation_Click"
                                AutomationProperties.Name="{local:Loc ResourceKey=TelegramComposer_Back}" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="←" Margin="0,0,6,0"/>
                                <TextBlock Text="{local:Loc ResourceKey=TelegramComposer_Back}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Button x:Name="DraftsNavigationButton" Content="{local:Loc ResourceKey=TelegramComposer_Drafts}"
                            Style="{StaticResource ComposerNavigation}" Click="ShowDrafts_Click"/>
                    <Button x:Name="QueueNavigationButton" Content="{local:Loc ResourceKey=TelegramPostEditor_TabQueue}"
                            Style="{StaticResource ComposerNavigation}" Click="ShowQueue_Click"/>
                </StackPanel>
                <Grid Grid.Column="1" Margin="12,0,0,0">
                    <Button x:Name="RetryPublicationButton" Content="{local:Loc ResourceKey=TelegramComposer_RetryFailed}"
                            Style="{StaticResource PrimaryButtonStyle}" Click="RetryPublication_Click" Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid x:Name="EditorPage">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="ComposerDocument" Margin="36,24,36,10" MaxWidth="740">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0">
                            <TextBlock x:Name="TxtStatusBar" DockPanel.Dock="Right" Style="{StaticResource ComposerCaption}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="160" AutomationProperties.LiveSetting="Polite"/>
                            <TextBlock Text="{local:Loc ResourceKey=TelegramPostEditor_DraftTitleLabel}" Style="{StaticResource ComposerCaption}"/>
                        </DockPanel>
                        <Grid Grid.Row="1" Margin="0,1,0,12">
                            <TextBox x:Name="TxtPostTitle" Background="Transparent" BorderThickness="0" Padding="0,2"
                                     Height="Auto" FontSize="28" FontWeight="SemiBold" TextChanged="EditorMetadata_Changed"
                                     AutomationProperties.Name="{local:Loc ResourceKey=TelegramPostEditor_DraftTitleLabel}">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border x:Name="TitleFocus" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,1">
                                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="TitleFocus" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                            <TextBlock x:Name="TxtPostTitlePlaceholder" Text="{local:Loc ResourceKey=TelegramPostEditor_NewPost}"
                                       Foreground="{StaticResource ComposerMuted}" FontSize="28" IsHitTestVisible="False"/>
                        </Grid>
                        <Border Grid.Row="2" BorderBrush="{StaticResource ComposerLine}" BorderThickness="0,1,0,1" Padding="0,4">
                            <WrapPanel>
                                <Button x:Name="BoldButton" Content="&#xECD2;" Style="{StaticResource ComposerIcon}"
                                        AutomationProperties.Name="{local:Loc ResourceKey=QuickNote_Bold}" ToolTip="{local:Loc ResourceKey=QuickNote_Bold}" Click="BtnBold_Click"/>
                                <Button x:Name="ItalicButton" Content="&#xED36;" Style="{StaticResource ComposerIcon}"
                                        AutomationProperties.Name="{local:Loc ResourceKey=QuickNote_Italic}" ToolTip="{local:Loc ResourceKey=QuickNote_Italic}" Click="BtnItalic_Click"/>
                                <Button x:Name="UnderlineButton" Content="&#xED67;" Style="{StaticResource ComposerIcon}"
                                        AutomationProperties.Name="{local:Loc ResourceKey=QuickNote_Underline}" ToolTip="{local:Loc ResourceKey=QuickNote_Underline}" Click="BtnUnderline_Click"/>
                                <Button x:Name="StrikethroughButton" Content="&#xED5E;" Style="{StaticResource ComposerIcon}"
                                        AutomationProperties.Name="{local:Loc ResourceKey=QuickNote_Strikethrough}" ToolTip="{local:Loc ResourceKey=QuickNote_Strikethrough}" Click="BtnStrike_Click"/>
                                <Button x:Name="SpoilerButton" Content="&#xE5F4;" Style="{StaticResource ComposerIcon}"
                                        AutomationProperties.Name="{local:Loc ResourceKey=TelegramPostEditor_Spoiler}" ToolTip="{local:Loc ResourceKey=TelegramPostEditor_Spoiler}" Click="BtnSpoiler_Click"/>
                                <Button x:Name="CodeButton" Content="&#xF339;" Style="{StaticResource ComposerIcon}"
                                        AutomationProperties.Name="{local:Loc ResourceKey=TelegramPostEditor_InlineCode}" ToolTip="{local:Loc ResourceKey=TelegramPostEditor_InlineCode}" Click="BtnInlineCode_Click"/>
                                <Button x:Name="QuoteButton" Content="&#xED59;" Style="{StaticResource ComposerIcon}"
                                        AutomationProperties.Name="{local:Loc ResourceKey=TelegramPostEditor_Quote}" ToolTip="{local:Loc ResourceKey=TelegramPostEditor_Quote}" Click="BtnQuote_Click"/>
                                <Border Width="1" Height="20" Background="{StaticResource ComposerLine}" Margin="2,0,6,0" VerticalAlignment="Center"/>
                                <Button x:Name="AttachMediaButton" Content="&#xF1A8;" Style="{StaticResource ComposerIcon}"
                                        AutomationProperties.Name="{local:Loc ResourceKey=TelegramPostEditor_AddMedia}" ToolTip="{local:Loc ResourceKey=TelegramPostEditor_AddMedia}" Click="BtnAddMedia_Click"/>
                                <Button x:Name="PreviewButton" Content="&#xE5F1;" Style="{StaticResource ComposerIcon}"
                                        AutomationProperties.Name="{local:Loc ResourceKey=TelegramPostEditor_TabPreview}" ToolTip="{local:Loc ResourceKey=TelegramPostEditor_TabPreview}" Click="TogglePreview_Click"/>
                                <Button x:Name="AiToggleButton" Content="&#xEB32;" Style="{StaticResource ComposerIcon}"
                                        AutomationProperties.Name="{local:Loc ResourceKey=TelegramComposer_Assistant}" ToolTip="{local:Loc ResourceKey=TelegramComposer_Assistant}" Click="BtnToggleAi_Click"/>
                                <Button x:Name="DraftActionsButton" Content="&#xE823;" Style="{StaticResource ComposerIcon}" Click="OpenButtonMenu_Click"
                                        AutomationProperties.Name="{local:Loc ResourceKey=TelegramComposer_DraftActions}" ToolTip="{local:Loc ResourceKey=TelegramComposer_DraftActions}">
                                    <Button.ContextMenu>
                                        <ContextMenu Style="{StaticResource ComposerMenu}">
                                            <MenuItem Header="{local:Loc ResourceKey=Common_Save}" Click="BtnSavePost_Click"/>
                                            <MenuItem Header="{local:Loc ResourceKey=TelegramPostEditor_ExportJson}" Click="BtnExportJson_Click"/>
                                            <MenuItem x:Name="DuplicateDraftMenuItem" Header="{local:Loc ResourceKey=TelegramPostEditor_Duplicate}" Click="BtnDuplicatePost_Click"/>
                                            <MenuItem x:Name="DeleteDraftMenuItem" Header="{local:Loc ResourceKey=TelegramPostEditor_MoveToTrash}" Click="BtnDeleteOrRestorePost_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </WrapPanel>
                        </Border>
                        <Grid Grid.Row="3" Margin="0,10,0,0">
                            <RichTextBox x:Name="PostEditorRichTextBox" Background="Transparent" BorderThickness="0" Padding="0,3"
                                         Foreground="{DynamicResource PrimaryText}" CaretBrush="{DynamicResource PrimaryText}"
                                         SelectionChanged="PostSelection_Changed" IsInactiveSelectionHighlightEnabled="True"
                                         FontSize="16" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                         AutomationProperties.Name="{local:Loc ResourceKey=TelegramComposer_PostText}"
                                         TextChanged="PostEditorRichTextBox_TextChanged"/>
                            <TextBlock x:Name="TxtEditorPlaceholder" Text="{local:Loc ResourceKey=TelegramPostEditor_EditorPlaceholder}"
                                       Foreground="{StaticResource ComposerMuted}" FontSize="16" Margin="4,7,0,0" IsHitTestVisible="False"/>
                        </Grid>
                        <ScrollViewer Grid.Row="4" MaxHeight="80" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="LstAttachedMedia">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource ComposerSurface}" CornerRadius="4" Padding="8,2" Margin="0,4,6,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding FileName}" ToolTip="{Binding FileName}" MaxWidth="185"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                <Button Content="×" Tag="{Binding Id}" Style="{StaticResource ComposerCommand}"
                                                        AutomationProperties.Name="{local:Loc ResourceKey=Common_Delete}" Click="BtnRemoveMedia_Click"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Border x:Name="AiOptionsPanel" Grid.Row="5" Visibility="Collapsed" Background="{StaticResource ComposerSurface}"
                                CornerRadius="6" Padding="12" Margin="0,8,0,0">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="×" VerticalAlignment="Top" Margin="6,0,0,0"
                                        Style="{StaticResource ComposerCommand}" Click="BtnToggleAi_Click"
                                        AutomationProperties.Name="{local:Loc ResourceKey=Common_Close}" ToolTip="{local:Loc ResourceKey=Common_Close}"/>
                                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock x:Name="AiScopeLabel" Style="{StaticResource ComposerCaption}" Margin="0,0,0,5"/>
                                        <TextBox x:Name="AiPromptBox" TextWrapping="Wrap" AcceptsReturn="True" Height="62"
                                                 AutomationProperties.Name="{local:Loc ResourceKey=TelegramComposer_AiBrief}"
                                                 ToolTip="{local:Loc ResourceKey=TelegramComposer_AiBrief}" Margin="0,0,0,6"/>
                                        <WrapPanel Margin="0,0,0,6">
                                            <Button x:Name="AiDraftButton" Tag="CreateFromBrief" Content="{local:Loc ResourceKey=TelegramComposer_AiDraft}"
                                                    Click="QuickAi_Click" Margin="0,0,6,0"/>
                                            <Button x:Name="AiShortenButton" Tag="Shorten" Content="{local:Loc ResourceKey=TelegramPostEditor_AiAction_Shorten}"
                                                    Click="QuickAi_Click" Margin="0,0,6,0"/>
                                            <Button x:Name="AiRewriteButton" Tag="Improve" Content="{local:Loc ResourceKey=TelegramComposer_AiRewrite}"
                                                    Click="QuickAi_Click" Margin="0,0,6,0"/>
                                            <Button x:Name="BtnStopAi" Content="{local:Loc ResourceKey=TelegramPostEditor_AiStop}"
                                                    Click="BtnStopAi_Click" Visibility="Collapsed"/>
                                        </WrapPanel>
                                        <Expander Foreground="{DynamicResource PrimaryText}" Header="{local:Loc ResourceKey=TelegramComposer_AiOptions}">
                                            <WrapPanel Margin="0,6,0,0">
                                            <StackPanel Margin="0,0,8,6" Width="148">
                                                <TextBlock Text="{local:Loc ResourceKey=TelegramPostEditor_AiActionLabel}" Style="{StaticResource ComposerCaption}"/>
                                                <ComboBox x:Name="CmbAiAction" DisplayMemberPath="DisplayName" AutomationProperties.Name="{local:Loc ResourceKey=TelegramPostEditor_AiActionLabel}"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,8,6" Width="148">
                                                <TextBlock Text="{local:Loc ResourceKey=TelegramPostEditor_AiInstructionLabel}" Style="{StaticResource ComposerCaption}"/>
                                                <ComboBox x:Name="CmbInstruction" DisplayMemberPath="Title" AutomationProperties.Name="{local:Loc ResourceKey=TelegramPostEditor_AiInstructionLabel}"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,8,6" Width="148">
                                                <TextBlock Text="{local:Loc ResourceKey=TelegramPostEditor_AiModelLabel}" Style="{StaticResource ComposerCaption}"/>
                                                <ComboBox x:Name="CmbAiModel" AutomationProperties.Name="{local:Loc ResourceKey=TelegramPostEditor_AiModelLabel}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,6">
                                                <Button x:Name="BtnRunAi" Content="{local:Loc ResourceKey=TelegramPostEditor_AiProcess}" Click="BtnRunAi_Click"/>
                                            </StackPanel>
                                            </WrapPanel>
                                        </Expander>
                                        <StackPanel x:Name="AiSuggestionPanel" Visibility="Collapsed" Margin="0,8,0,0">
                                            <TextBlock x:Name="TxtAiMeta" Style="{StaticResource ComposerCaption}"/>
                                            <TextBlock x:Name="AiOriginalText" Style="{StaticResource ComposerCaption}" MaxHeight="42"
                                                       TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                                            <TextBox x:Name="TxtAiSuggestion" Height="76" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,5,0,6"/>
                                            <WrapPanel>
                                                <Button x:Name="ApplyAiButton" Content="{local:Loc ResourceKey=TelegramPostEditor_AiApply}" Click="BtnApplyAi_Click" Margin="0,0,8,0"/>
                                                <Button Content="{local:Loc ResourceKey=TelegramPostEditor_AiDismiss}" Style="{StaticResource ComposerCommand}" Click="BtnDismissAi_Click"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                    <Border x:Name="SidebarDivider" Grid.Column="1" HorizontalAlignment="Left" Width="1" Margin="-16,0,0,0"
                            Background="{StaticResource ComposerLine}" Visibility="Collapsed" IsHitTestVisible="False"/>
                    <Border x:Name="PreviewPane" Grid.Column="1" Visibility="Collapsed" Width="300"
                            Background="{StaticResource ComposerSurface}" BorderBrush="{StaticResource ComposerLine}" BorderThickness="1,0,0,0" Padding="16">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource ComposerCommand}"
                                        AutomationProperties.Name="{local:Loc ResourceKey=Common_Close}" Click="TogglePreview_Click"/>
                                <TextBlock Text="{local:Loc ResourceKey=TelegramPostEditor_TabPreview}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Border Background="{DynamicResource WindowBackground}" CornerRadius="8" Padding="12" VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtPreviewChannel" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="TxtPreviewSubtitle" Style="{StaticResource ComposerCaption}"/>
                                        <ItemsControl x:Name="PreviewMediaList" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,6">
                                                        <Image Source="{Binding Image}" MaxHeight="130" Stretch="Uniform" HorizontalAlignment="Left"/>
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource ComposerCaption}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <FlowDocumentScrollViewer x:Name="PreviewDocument" VerticalScrollBarVisibility="Disabled" FontSize="14"
                                                                  Foreground="{DynamicResource PrimaryText}" Margin="0,5,0,0"/>
                                        <ItemsControl x:Name="PreviewButtonsList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Text}" ToolTip="{Binding Url}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <Grid x:Name="PublishPage" Grid.Column="1" Visibility="Collapsed" Width="334" Margin="0,12,14,8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock x:Name="RoutingHeading" Text="{local:Loc ResourceKey=TelegramComposer_WhereToSend}" Style="{StaticResource ComposerHeading}" Margin="0,0,0,3"/>
                            <ScrollViewer MaxHeight="48" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                                <TextBlock x:Name="TxtSelectedChannelsSummary" Style="{StaticResource ComposerCaption}"/>
                            </ScrollViewer>
                            <TextBlock x:Name="TxtValidationStatus" Style="{StaticResource ComposerCaption}" AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="PublishOptions">
                                <StackPanel x:Name="RecipientsSection">
                                <DockPanel Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Content="{local:Loc ResourceKey=TelegramSettings_OpenSettings}"
                                            Style="{StaticResource ComposerCommand}" Click="BtnOpenTelegramSettings_Click"/>
                                    <TextBlock Text="{local:Loc ResourceKey=TelegramPostEditor_TabChannels}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock x:Name="TxtNoChannelsHint" Text="{local:Loc ResourceKey=TelegramComposer_ConnectHint}"
                                           Style="{StaticResource ComposerCaption}" Margin="0,0,0,8"/>
                                <ComboBox x:Name="CmbPublishingCategory" DisplayMemberPath="Label" Margin="0,0,0,6"
                                          AutomationProperties.Name="{local:Loc ResourceKey=SettingsLists_AllCategories}"
                                          SelectionChanged="PublishingCategory_SelectionChanged"/>
                                <ItemsControl x:Name="LstChannels">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource ComposerLine}" BorderThickness="0,0,0,1">
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}" Click="ChannelSelection_Changed"
                                                          Padding="4,6" MinHeight="46" VerticalContentAlignment="Center">
                                                    <StackPanel Margin="4,0,0,0">
                                                        <TextBlock Text="{Binding DestinationLabel}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Subtitle}" Foreground="{Binding SubtitleBrush}" FontSize="12" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </CheckBox>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Expander x:Name="QuickConnectPanel" Header="{local:Loc ResourceKey=TelegramComposer_Connect}"
                                          Foreground="{DynamicResource PrimaryText}" Margin="0,10,0,0">
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock x:Name="TxtConnectedBotsSummary" Style="{StaticResource ComposerCaption}" Margin="0,0,0,8"/>
                                        <TextBlock Text="{local:Loc ResourceKey=TelegramPostEditor_BotTokenPlaceholder}" Style="{StaticResource ComposerCaption}"/>
                                        <DockPanel Margin="0,4,0,8">
                                            <Button x:Name="BtnQuickConnectBot" DockPanel.Dock="Right" Content="{local:Loc ResourceKey=TelegramSettings_AddBot}"
                                                    Click="BtnQuickConnectBot_Click" Margin="8,0,0,0"/>
                                            <PasswordBox x:Name="PwdQuickBotToken" AutomationProperties.Name="{local:Loc ResourceKey=TelegramPostEditor_BotTokenPlaceholder}"/>
                                        </DockPanel>
                                        <TextBlock Text="{local:Loc ResourceKey=TelegramPostEditor_ChannelInputPlaceholder}" Style="{StaticResource ComposerCaption}"/>
                                        <DockPanel Margin="0,4,0,6">
                                            <Button x:Name="BtnQuickConnectChannel" DockPanel.Dock="Right" Content="{local:Loc ResourceKey=TelegramSettings_AddChannel}"
                                                    Click="BtnQuickConnectChannel_Click" Margin="8,0,0,0"/>
                                            <TextBox x:Name="TxtQuickChannelInput" AutomationProperties.Name="{local:Loc ResourceKey=TelegramPostEditor_ChannelInputPlaceholder}"/>
                                        </DockPanel>
                                        <CheckBox x:Name="ChkQuickTestChannel" Content="{local:Loc ResourceKey=TelegramSettings_IsTestChannel}"/>
                                    </StackPanel>
                                </Expander>
                                </StackPanel>
                                <StackPanel x:Name="TimingSection" Visibility="Collapsed">
                                <WrapPanel x:Name="TimeOptions">
                                    <RadioButton x:Name="SendNowOption" GroupName="PublicationTime" IsChecked="True"
                                                 Content="{local:Loc ResourceKey=TelegramComposer_Now}" Checked="PublicationTiming_Changed"
                                                 Style="{StaticResource SelectionListRadioButtonStyle}" Margin="0,0,8,6"/>
                                    <RadioButton x:Name="ScheduleOption" GroupName="PublicationTime"
                                                 Content="{local:Loc ResourceKey=TelegramComposer_Later}" Checked="PublicationTiming_Changed"
                                                 Style="{StaticResource SelectionListRadioButtonStyle}" Margin="0,0,0,6"/>
                                </WrapPanel>
                                <StackPanel x:Name="ScheduleFields" Visibility="Collapsed" Margin="0,0,0,8">
                                    <TextBlock x:Name="ScheduleZone" Style="{StaticResource ComposerCaption}" Margin="0,2,0,5"/>
                                    <WrapPanel>
                                        <DatePicker x:Name="ScheduleDate" Width="160" SelectedDateChanged="ScheduleInput_Changed"
                                                    Background="{StaticResource ComposerSurface}" Foreground="{DynamicResource PrimaryText}"
                                                    BorderBrush="{StaticResource ComposerLine}" Margin="0,0,8,6"
                                                    AutomationProperties.Name="{local:Loc ResourceKey=TelegramPostEditor_QueueDateLabel}">
                                            <DatePicker.Resources>
                                                <Style TargetType="DatePickerTextBox">
                                                    <Setter Property="Background" Value="{StaticResource ComposerSurface}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                                                    <Setter Property="Padding" Value="8,4"/>
                                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                </Style>
                                            </DatePicker.Resources>
                                        </DatePicker>
                                        <TextBox x:Name="ScheduleTime" Width="80" TextChanged="ScheduleInput_Changed" Margin="0,0,0,6"
                                                 AutomationProperties.Name="{local:Loc ResourceKey=TelegramComposer_TimeFormat}" ToolTip="{local:Loc ResourceKey=TelegramComposer_TimeFormat}"/>
                                    </WrapPanel>
                                    <Expander x:Name="SchedulerSettings" Header="{local:Loc ResourceKey=TelegramComposer_Scheduler}"
                                              Foreground="{DynamicResource PrimaryText}" Margin="0,4,0,0">
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock x:Name="TxtModeBadge" Style="{StaticResource ComposerCaption}" Margin="0,0,0,6"/>
                                            <TextBlock Text="{local:Loc ResourceKey=TelegramPostEditor_QueueUrlLabel}" Style="{StaticResource ComposerCaption}"/>
                                            <TextBox x:Name="TxtServerUrl" Margin="0,4,0,6" TextChanged="ScheduleInput_Changed"
                                                     AutomationProperties.Name="{local:Loc ResourceKey=TelegramPostEditor_QueueUrlLabel}"/>
                                            <TextBlock Text="{local:Loc ResourceKey=TelegramPostEditor_QueuePairCodePlaceholder}" Style="{StaticResource ComposerCaption}"/>
                                            <DockPanel Margin="0,4,0,6">
                                                <Button x:Name="BtnPairServer" DockPanel.Dock="Right" Content="{local:Loc ResourceKey=TelegramPostEditor_QueuePairButton}"
                                                        Click="BtnPairServer_Click" Margin="8,0,0,0"/>
                                                <TextBox x:Name="TxtPairingCode" AutomationProperties.Name="{local:Loc ResourceKey=TelegramPostEditor_QueuePairCodePlaceholder}"
                                                         ToolTip="{local:Loc ResourceKey=TelegramPostEditor_QueuePairCodePlaceholder}"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Expander>
                                    <TextBlock Text="{local:Loc ResourceKey=TelegramPostEditor_QueueTokenNotice}" Style="{StaticResource ComposerCaption}" Margin="0,6,0,0"/>
                                </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    <Grid x:Name="ResultPage" Grid.Column="1" Width="334" Visibility="Collapsed" Margin="0,12,14,8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="ResultHeading" Style="{StaticResource ComposerHeading}" AutomationProperties.LiveSetting="Polite"/>
                            <TextBlock x:Name="ResultNotice" Style="{StaticResource ComposerCaption}"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ResultRows" ItemTemplate="{StaticResource PublicationRow}"/>
                        </ScrollViewer>
                    </Grid>
                </Grid>
                <Border Grid.Row="1" BorderBrush="{StaticResource ComposerLine}" BorderThickness="0,1,0,0" Padding="20,6">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <Button x:Name="SendPostButton" DockPanel.Dock="Right" Content="{local:Loc ResourceKey=TelegramComposer_Send}"
                                    Style="{StaticResource PrimaryButtonStyle}" Click="SendPost_Click" Margin="12,0,0,0"/>
                            <WrapPanel VerticalAlignment="Center">
                                <Button x:Name="ReviewButton" Style="{StaticResource ComposerCommand}" Click="Review_Click" MaxWidth="310">
                                    <TextBlock x:Name="EditorRecipients" TextTrimming="CharacterEllipsis"/>
                                </Button>
                                <Button x:Name="WhenButton" Style="{StaticResource ComposerCommand}" Click="ChooseTiming_Click"/>
                            </WrapPanel>
                        </DockPanel>
                        <StackPanel>
                            <TextBlock x:Name="TxtCharCounter" Style="{StaticResource ComposerCaption}"/>
                            <TextBlock x:Name="EditorValidation" Style="{StaticResource ComposerCaption}"/>
                            <TextBlock x:Name="EditorSendError" Style="{StaticResource ComposerCaption}" AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="DraftsPage" Visibility="Collapsed" MaxWidth="700" Margin="28,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Right">
                        <Button Content="{local:Loc ResourceKey=TelegramPostEditor_FromTemplate}" Click="BtnFromTemplate_Click" Margin="0,0,8,5"/>
                        <Button x:Name="NewPostButton" Content="{local:Loc ResourceKey=TelegramPostEditor_NewPost}" Style="{StaticResource PrimaryButtonStyle}" Click="BtnNewPost_Click" Margin="0,0,0,5"/>
                    </WrapPanel>
                    <TextBlock Text="{local:Loc ResourceKey=TelegramComposer_Drafts}" Style="{StaticResource ComposerHeading}"/>
                </DockPanel>
                <DockPanel Grid.Row="1" Margin="0,0,0,10">
                    <ComboBox x:Name="CmbLibrarySort" DockPanel.Dock="Right" MinWidth="110" Margin="8,0,0,0" SelectionChanged="CmbLibrarySort_SelectionChanged"
                              AutomationProperties.Name="{local:Loc ResourceKey=TelegramPostEditor_SortByDate}"/>
                    <ComboBox x:Name="CmbLibraryFilter" DockPanel.Dock="Right" MinWidth="130" Margin="8,0,0,0" SelectionChanged="CmbLibraryFilter_SelectionChanged"
                              AutomationProperties.Name="{local:Loc ResourceKey=TelegramComposer_Drafts}"/>
                    <Grid>
                        <TextBox x:Name="TxtSearchPosts" TextChanged="TxtSearchPosts_TextChanged"
                                 AutomationProperties.Name="{local:Loc ResourceKey=TelegramPostEditor_SearchPlaceholder}"/>
                        <TextBlock x:Name="TxtSearchPlaceholder" Text="{local:Loc ResourceKey=TelegramPostEditor_SearchPlaceholder}"
                                   Style="{StaticResource ComposerCaption}" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                </DockPanel>
                <ListBox x:Name="LstPosts" Grid.Row="2" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource ComposerDraftItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="OpenSelectedDraft_Click" KeyDown="Drafts_KeyDown" SelectionChanged="DraftSelection_Changed">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="5,8">
                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding UpdatedUtc, Converter={StaticResource DraftDateConverter}}" Style="{StaticResource ComposerCaption}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <WrapPanel Grid.Row="3" Margin="0,10,0,0">
                    <Button x:Name="OpenDraftButton" Content="{local:Loc ResourceKey=TelegramComposer_OpenDraft}" Click="OpenSelectedDraft_Click" Margin="0,0,8,0"/>
                </WrapPanel>
            </Grid>

            <Grid x:Name="QueuePage" Visibility="Collapsed" MaxWidth="700" Margin="28,24">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Right">
                        <Button x:Name="RefreshQueueButton" Content="{local:Loc ResourceKey=TelegramComposer_Refresh}" Click="RefreshQueue_Click" Margin="0,0,8,0"/>
                    </WrapPanel>
                    <TextBlock Text="{local:Loc ResourceKey=TelegramPostEditor_TabQueue}" Style="{StaticResource ComposerHeading}"/>
                </DockPanel>
                <TextBlock x:Name="QueueStatus" Grid.Row="1" Style="{StaticResource ComposerCaption}" AutomationProperties.LiveSetting="Polite"/>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="QueueRows" ItemTemplate="{StaticResource PublicationRow}"/>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</local:DarkWindow>
