<local:DarkWindow x:Class="AiteBar.AiConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AiteBar"
        Icon="pack://application:,,,/Resources/app.ico"
        Title="{local:Loc ResourceKey=AiSettings_AddConnection}"
        Width="520" SizeToContent="Height" MaxHeight="720"
        WindowStartupLocation="CenterOwner" Background="#191919" Foreground="#F4F7FA"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize" ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsWindowResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="PasswordBox">
                <Setter Property="Height" Value="36"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="Foreground" Value="#F4F7FA"/>
                <Setter Property="Background" Value="#2D2D2D"/>
                <Setter Property="BorderBrush" Value="#50545B"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="{local:Loc ResourceKey=AiSettings_AddConnection}" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="{local:Loc ResourceKey=AiSettings_AddConnectionHint}" Foreground="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,0,0,14">
                <TextBlock Text="{local:Loc ResourceKey=AiSettings_Provider}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ComboBox x:Name="CmbProvider" SelectionChanged="CmbProvider_SelectionChanged"/>
                <TextBlock Margin="0,7,0,0" FontSize="11">
                    <Hyperlink Click="LinkGetApiKey_Click">
                        <Run Text="{local:Loc ResourceKey=AiSettings_GetApiKey}"/>
                    </Hyperlink>
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,0,0,14">
                <TextBlock Text="{local:Loc ResourceKey=AiSettings_ConnectionName}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtDisplayName" TextChanged="Input_TextChanged"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,0,0,20">
                <TextBlock Text="{local:Loc ResourceKey=AiSettings_ApiKey}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <PasswordBox x:Name="PwdApiKey" PasswordChanged="Input_PasswordChanged"/>
                <TextBlock Text="{local:Loc ResourceKey=AiSettings_ApiKeySecurityHint}" Foreground="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{local:Loc ResourceKey=Common_Cancel}" Style="{StaticResource CommandButtonStyle}" Width="130" Click="BtnCancel_Click" IsCancel="True"/>
                <Button x:Name="BtnAdd" Content="{local:Loc ResourceKey=AiSettings_Add}" Style="{StaticResource PrimaryCommandButtonStyle}" Width="150" Margin="10,0,0,0" Click="BtnAdd_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</local:DarkWindow>
