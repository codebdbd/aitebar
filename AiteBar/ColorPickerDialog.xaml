<local:DarkWindow x:Class="AiteBar.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AiteBar"
        Icon="pack://application:,,,/Resources/app.ico"
        Title="{local:Loc ResourceKey='ColorPicker_ChooseColor'}"
        Width="450"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="#191919"
        Foreground="#DCDCDC"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsWindowResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <Style x:Key="ColorSwatchButtonStyle" TargetType="Button">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Margin" Value="4"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="#273344"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
                                <Border x:Name="Outline"
                                        Background="{TemplateBinding BorderBrush}"
                                        CornerRadius="4"/>
                                <Border x:Name="Border" 
                                        Margin="1"
                                        Background="{TemplateBinding Background}" 
                                        CornerRadius="3">
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Outline" Property="Background" Value="#3A4658"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsKeyboardFocused" Value="True"/>
                                        <Condition Property="local:KeyboardFocusVisualService.ShowKeyboardFocusCue" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Outline" Property="Background" Value="{StaticResource FormControlFocusBorderBrush}"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Превью цвета слева -->
            <Border x:Name="ColorPreview" Grid.Column="0" Background="#000000" CornerRadius="4" BorderBrush="#273344" BorderThickness="1"/>

            <!-- HSV Слайдеры справа -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{local:Loc ResourceKey='ColorPicker_Hue'}" Style="{StaticResource FieldLabelStyle}" Width="60"/>
                <Slider Grid.Row="0" Grid.Column="2" x:Name="SliderHue" Minimum="0" Maximum="360" ValueChanged="SliderHue_ValueChanged"/>
                <TextBlock Grid.Row="0" Grid.Column="4" x:Name="TxtHue" Text="0" Style="{StaticResource FieldLabelStyle}" HorizontalAlignment="Right"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{local:Loc ResourceKey='ColorPicker_Saturation'}" Style="{StaticResource FieldLabelStyle}" Width="60"/>
                <Slider Grid.Row="2" Grid.Column="2" x:Name="SliderSaturation" Minimum="0" Maximum="100" ValueChanged="SliderSaturation_ValueChanged"/>
                <TextBlock Grid.Row="2" Grid.Column="4" x:Name="TxtSaturation" Text="0%" Style="{StaticResource FieldLabelStyle}" HorizontalAlignment="Right"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="{local:Loc ResourceKey='ColorPicker_Brightness'}" Style="{StaticResource FieldLabelStyle}" Width="60"/>
                <Slider Grid.Row="4" Grid.Column="2" x:Name="SliderValue" Minimum="0" Maximum="100" ValueChanged="SliderValue_ValueChanged"/>
                <TextBlock Grid.Row="4" Grid.Column="4" x:Name="TxtValue" Text="0%" Style="{StaticResource FieldLabelStyle}" HorizontalAlignment="Right"/>

                <!-- HEX поле -->
                <TextBlock Grid.Row="6" Grid.Column="0" Text="{local:Loc ResourceKey='ColorPicker_Hex'}" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="TxtHex" Grid.Row="6" Grid.Column="2" Grid.ColumnSpan="3" Style="{StaticResource BaseTextBoxStyle}" TextChanged="TxtHex_TextChanged" MaxLength="7"/>
            </Grid>
        </Grid>

        <!-- Палитра цветов -->
        <GroupBox Grid.Row="2" Header="{local:Loc ResourceKey='ColorPicker_Palette'}" BorderBrush="#273344" BorderThickness="1" Padding="8">
            <WrapPanel x:Name="ColorPalette"/>
        </GroupBox>

        <!-- Кнопки OK/Cancel -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnCancel" Grid.Column="0" Content="{local:Loc ResourceKey='ColorPicker_Cancel'}" Style="{StaticResource SecondaryButtonStyle}" Click="BtnCancel_Click"/>
            <Button x:Name="BtnOK" Grid.Column="2" Content="{local:Loc ResourceKey='ColorPicker_OK'}" Style="{StaticResource ActionButtonStyle}" Click="BtnOK_Click"/>
        </Grid>
    </Grid>
</local:DarkWindow>
