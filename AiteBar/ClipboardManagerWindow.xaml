<local:DarkWindow x:Class="AiteBar.ClipboardManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AiteBar"
        Icon="pack://application:,,,/Resources/app.ico"
        Title="{local:Loc ResourceKey=ClipboardManager_Title}"
        Width="380" Height="520" MinWidth="360" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="#1A1A1C" Foreground="#DCDCDC"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False" Topmost="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsWindowResources.xaml"/>
                <ResourceDictionary Source="FormControlsResources.xaml"/>
                <ResourceDictionary Source="UtilityWindowResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="EntryItemStyle" TargetType="Border">
                <Setter Property="Background" Value="#151922"/>
                <Setter Property="BorderBrush" Value="#273344"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="10"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#1E2532"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <TextBox x:Name="TxtSearch"
                     Style="{StaticResource BaseTextBoxStyle}"
                     TextChanged="TxtSearch_TextChanged"
                     FontSize="12"/>
            <TextBlock x:Name="TxtSearchPlaceholder"
                       Text="{local:Loc ResourceKey=ClipboardManager_SearchPlaceholder}"
                       Foreground="{StaticResource MutedText}"
                       FontSize="12"
                       Margin="8,0"
                       IsHitTestVisible="False"
                       VerticalAlignment="Center"/>
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="EntriesPanel">
                <TextBlock x:Name="TxtEmptyHint"
                           Text="{local:Loc ResourceKey=ClipboardManager_EmptyHint}"
                           Foreground="{StaticResource MutedText}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,20,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="TxtStatus"
                       Foreground="{StaticResource MutedText}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Top"
                       Margin="0,0,0,8"/>
            <Button Grid.Row="1"
                    x:Name="BtnClearAll"
                    Content="{local:Loc ResourceKey=ClipboardManager_ClearAll}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    HorizontalAlignment="Right"
                    Click="BtnClearAll_Click"/>
        </Grid>
    </Grid>
</local:DarkWindow>
