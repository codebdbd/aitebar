<local:DarkWindow x:Class="AiteBar.ClipboardManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AiteBar"
        Icon="pack://application:,,,/Resources/app.ico"
        Title="{local:Loc ResourceKey=ClipboardManager_Title}"
        Width="420" Height="620" MinWidth="390" MinHeight="540"
        WindowStartupLocation="CenterScreen" Background="#1A1A1C" Foreground="#DCDCDC"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False" Topmost="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsWindowResources.xaml"/>
                <ResourceDictionary Source="FormControlsResources.xaml"/>
                <ResourceDictionary Source="UtilityWindowResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="EntryItemStyle" TargetType="Border">
                <Setter Property="Background" Value="#151922"/>
                <Setter Property="BorderBrush" Value="#273344"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="10"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#1E2532"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ClipboardActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="Height" Value="28"/>
                <Setter Property="MinWidth" Value="64"/>
                <Setter Property="Margin" Value="0,0,6,6"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="FontSize" Value="11"/>
            </Style>

            <Style x:Key="ClipboardFilterButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="Height" Value="30"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="FontSize" Value="11"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <TextBox x:Name="TxtSearch"
                     Style="{StaticResource BaseTextBoxStyle}"
                     TextChanged="TxtSearch_TextChanged"
                     FontSize="12"/>
            <TextBlock x:Name="TxtSearchPlaceholder"
                       Text="{local:Loc ResourceKey=ClipboardManager_SearchPlaceholder}"
                       Foreground="{StaticResource MutedText}"
                       FontSize="12"
                       Margin="8,0"
                       IsHitTestVisible="False"
                       VerticalAlignment="Center"/>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="BtnFilterAll"
                    Style="{StaticResource ClipboardFilterButtonStyle}"
                    Content="{local:Loc ResourceKey=ClipboardManager_FilterAll}"
                    Click="BtnFilterAll_Click"/>
            <Button x:Name="BtnFilterPinned"
                    Style="{StaticResource ClipboardFilterButtonStyle}"
                    Content="{local:Loc ResourceKey=ClipboardManager_FilterPinned}"
                    Click="BtnFilterPinned_Click"/>
            <Button x:Name="BtnFilterText"
                    Style="{StaticResource ClipboardFilterButtonStyle}"
                    Content="{local:Loc ResourceKey=ClipboardManager_FilterText}"
                    Click="BtnFilterText_Click"/>
            <Button x:Name="BtnFilterImages"
                    Style="{StaticResource ClipboardFilterButtonStyle}"
                    Content="{local:Loc ResourceKey=ClipboardManager_FilterImages}"
                    Click="BtnFilterImages_Click"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="EntriesPanel">
                <TextBlock x:Name="TxtEmptyHint"
                           Text="{local:Loc ResourceKey=ClipboardManager_EmptyHint}"
                           Foreground="{StaticResource MutedText}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,20,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="TxtStatus"
                       Foreground="{StaticResource MutedText}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Top"
                       Margin="0,0,0,8"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnClearHistory"
                        Content="{local:Loc ResourceKey=ClipboardManager_ClearHistory}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0"
                        Click="BtnClearHistory_Click"/>
                <Button x:Name="BtnWipeAll"
                        Content="{local:Loc ResourceKey=ClipboardManager_WipeAll}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BtnWipeAll_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</local:DarkWindow>
