<local:DarkWindow x:Class="AiteBar.QuickNoteLinkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AiteBar"
        Icon="pack://application:,,,/Resources/app.ico"
        Title="{local:Loc ResourceKey=QuickNote_InsertLink}" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" Background="#191919" Foreground="White"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsWindowResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{local:Loc ResourceKey=QuickNote_LinkText}" Margin="0,0,0,8" Foreground="{StaticResource MutedText}"/>
        <TextBox x:Name="TxtLinkText" Grid.Row="1" TextChanged="Input_TextChanged"/>

        <TextBlock Grid.Row="2" Text="{local:Loc ResourceKey=QuickNote_LinkUrl}" Margin="0,14,0,8" Foreground="{StaticResource MutedText}"/>
        <TextBox x:Name="TxtUrl" Grid.Row="3" TextChanged="Input_TextChanged"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{local:Loc ResourceKey=Common_Cancel}" Style="{StaticResource SecondaryButtonStyle}" Click="BtnCancel_Click" IsCancel="True" Height="36" MinWidth="110" Padding="16,0"/>
            <Button x:Name="BtnSave" Content="{local:Loc ResourceKey=Common_Save}" Style="{StaticResource ActionButtonStyle}" Click="BtnSave_Click" IsDefault="True" Height="36" MinWidth="110" Padding="16,0" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</local:DarkWindow>
