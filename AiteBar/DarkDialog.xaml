<local:DarkWindow x:Class="AiteBar.DarkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AiteBar"
        Icon="pack://application:,,,/Resources/app.ico"
        Title="{local:Loc ResourceKey=Common_Warning}" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" Background="#1E1E1E" Foreground="White"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True">
    
    <Window.Resources>
        <Style x:Key="DialogPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="16,0"/>
        </Style>

        <Style x:Key="DialogSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="16,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtMessage" Text="" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,28" LineHeight="18"/>

        <StackPanel x:Name="ButtonsPanel" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnYes" Content="{local:Loc ResourceKey=Common_Yes}" Style="{StaticResource DialogPrimaryButtonStyle}" Click="BtnYes_Click" Visibility="Collapsed" IsDefault="True"/>
            <Button x:Name="BtnNo" Content="{local:Loc ResourceKey=Common_Cancel}" Style="{StaticResource DialogSecondaryButtonStyle}" Click="BtnNo_Click" Visibility="Collapsed" IsCancel="True"/>
            <Button x:Name="BtnOk" Content="{local:Loc ResourceKey=Common_OK}" Style="{StaticResource DialogPrimaryButtonStyle}" Click="BtnOk_Click" Visibility="Collapsed" IsDefault="True" IsCancel="True"/>
        </StackPanel>
    </Grid>
</local:DarkWindow>
