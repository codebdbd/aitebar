<local:DarkWindow x:Class="AiteBar.ZenEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AiteBar"
        Title="{local:Loc ResourceKey=ZenEditor_Title}"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="True" Topmost="False"
        Background="#F4F0E7"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Closed="Window_Closed"
        Activated="Window_Activated"
        Deactivated="Window_Deactivated"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="ZenEditorTextBoxStyle" TargetType="{x:Type local:ZenParagraphEditor}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="{x:Null}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type local:ZenParagraphEditor}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Background="{x:Null}"
                                      BorderThickness="0"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid x:Name="EditorHost">
            <local:ZenParagraphEditor x:Name="Editor"
                     Style="{StaticResource ZenEditorTextBoxStyle}"
                     Width="760"
                     MaxWidth="760"
                     Margin="32,0"
                     Padding="0"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="#282622"
                     CaretBrush="#282622"
                     SelectionBrush="#D8D0C2"
                     SelectionTextBrush="#1F1D1A"
                     FontSize="20"
                     FontWeight="Normal"
                     AcceptsReturn="True"
                     AcceptsTab="False"
                     IsUndoEnabled="True"
                     UndoLimit="500"
                     SpellCheck.IsEnabled="False"
                     VerticalScrollBarVisibility="Hidden"
                     HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="False"
                     TextChanged="Editor_TextChanged"
                     SelectionChanged="Editor_SelectionChanged"
                     PreviewMouseWheel="Editor_PreviewMouseWheel"
                     PreviewMouseLeftButtonUp="Editor_PreviewMouseLeftButtonUp"
                     ContextMenuOpening="Editor_ContextMenuOpening"
                     AutomationProperties.Name="{local:Loc ResourceKey=ZenEditor_EditorAutomationName}"/>
        </Grid>

        <Border x:Name="SearchOverlay"
                Panel.ZIndex="15"
                Visibility="Collapsed"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="24"
                Padding="10,6"
                CornerRadius="6"
                Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                KeyboardNavigation.TabNavigation="Cycle">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{local:Loc ResourceKey=ZenEditor_Search}"
                           Margin="4,0,10,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource PrimaryText}"/>
                <TextBox x:Name="SearchTextBox"
                         Grid.Column="1"
                         Margin="0"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchTextBox_TextChanged"
                         PreviewKeyDown="SearchTextBox_PreviewKeyDown"
                         AutomationProperties.Name="{local:Loc ResourceKey=ZenEditor_Search}"/>
                <TextBlock x:Name="SearchStatusText"
                           Grid.Column="2"
                           Margin="10,0,6,0"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           Foreground="{DynamicResource MutedText}"
                           AutomationProperties.LiveSetting="Polite"/>
                <Button Grid.Column="3"
                        Content="&#xF2B7;"
                        FontFamily="pack://application:,,,/Resources/#FluentSystemIcons-Regular"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="{local:Loc ResourceKey=ZenEditor_FindPrevious}"
                        AutomationProperties.Name="{local:Loc ResourceKey=ZenEditor_FindPrevious}"
                        Click="FindPrevious_Click"/>
                <Button Grid.Column="4"
                        Content="&#xF2A4;"
                        FontFamily="pack://application:,,,/Resources/#FluentSystemIcons-Regular"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="{local:Loc ResourceKey=ZenEditor_FindNext}"
                        AutomationProperties.Name="{local:Loc ResourceKey=ZenEditor_FindNext}"
                        Click="FindNext_Click"/>
                <Button Grid.Column="5"
                        Content="&#xF369;"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="{local:Loc ResourceKey=Common_Close}"
                        AutomationProperties.Name="{local:Loc ResourceKey=Common_Close}"
                        Click="CloseSearch_Click"/>
            </Grid>
        </Border>

        <Border x:Name="SaveErrorOverlay"
                Panel.ZIndex="20"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="560"
                Padding="24"
                CornerRadius="6"
                BorderThickness="1"
                AutomationProperties.LiveSetting="Assertive"
                AutomationProperties.Name="{local:Loc ResourceKey=ZenEditor_SaveErrorTitle}">
            <StackPanel>
                <TextBlock x:Name="SaveErrorText" TextWrapping="Wrap" Margin="0,0,0,18"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="RetrySaveButton"
                            Content="{local:Loc ResourceKey=ZenEditor_Retry}" Padding="16,8"
                            Margin="0,0,8,0" Click="RetrySave_Click"/>
                    <Button Content="{local:Loc ResourceKey=ZenEditor_ExportTxt}" Padding="16,8"
                            Margin="0,0,8,0" Click="ExportCopy_Click"/>
                    <Button Content="{local:Loc ResourceKey=ZenEditor_Dismiss}" Padding="16,8"
                            Click="DismissError_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</local:DarkWindow>
