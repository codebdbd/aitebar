<local:DarkWindow x:Class="AiteBar.IptvPlayer.IptvPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AiteBar"
        xmlns:iptv="clr-namespace:AiteBar.IptvPlayer"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        WindowClass="Workspace"
        Title="IPTV Player"
        Width="1100"
        Height="560"
        MinWidth="800"
        MinHeight="500"
        Background="#141416"
        Foreground="#D0D0D0"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AiteBar;component/SettingsWindowResources.xaml" />
                <ResourceDictionary Source="/AiteBar;component/FormControlsResources.xaml" />
                <ResourceDictionary Source="/AiteBar;component/UtilityWindowResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="FluentSystemIcons">pack://application:,,,/Resources/#FluentSystemIcons-Regular</FontFamily>

            <Style x:Key="PlayerButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                <Setter Property="Background" Value="#252528"/>
                <Setter Property="Foreground" Value="#CCCCCC"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Margin" Value="0"/>
            </Style>

            <Style x:Key="PipButtonStyle" TargetType="Button" BasedOn="{StaticResource PlayerButtonStyle}">
                <Setter Property="Width" Value="36"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Background" Value="#D0252528"/>
                <Setter Property="Foreground" Value="White"/>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.45"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <ControlTemplate x:Key="PipOverlayTemplate" TargetType="ContentControl">
                <!-- A nonzero alpha lets the native video overlay receive mouse input. -->
                <Grid Background="#01000000" PreviewMouseDown="PipOverlay_PreviewMouseDown"
                      Focusable="True" MouseLeftButtonDown="Surface_MouseLeftButtonDown"
                      MouseLeftButtonUp="Surface_MouseLeftButtonUp" MouseMove="Surface_MouseMove"
                      LostMouseCapture="Surface_LostMouseCapture"
                      KeyboardNavigation.TabNavigation="Cycle">
                    <Border x:Name="ChannelInfo" Margin="8,8,52,0" Padding="8,5" CornerRadius="4" Background="#D0252528"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False"
                            DataContext="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}">
                        <StackPanel>
                            <TextBlock Text="{Binding ChannelName}" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ChannelStatus" Text="{Binding Status}" Foreground="#E0E0E0"
                                       FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <!-- Opacity keeps the controls in the tab order so keyboard focus can reveal them. -->
                    <Grid x:Name="PipControls" Opacity="0" IsHitTestVisible="False">
                        <Button x:Name="ReturnButton" Style="{StaticResource PipButtonStyle}"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                ToolTip="{local:Loc ResourceKey=Iptv_ReturnToWindow}"
                                AutomationProperties.Name="{local:Loc ResourceKey=Iptv_ReturnToWindow}"
                                Click="PipReturn_Click">
                            <Viewbox Width="20" Height="20">
                                <Path Data="M 11,4 H 4 V 20 H 20 V 13 M 21,3 L 10,14 M 10,8 V 14 H 16"
                                      Stroke="White" StrokeThickness="1.6" StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Viewbox>
                        </Button>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="8">
                            <Button x:Name="PreviousChannelButton" Style="{StaticResource PipButtonStyle}" Margin="0,0,8,0"
                                    IsEnabled="{Binding Content.CanNavigate, RelativeSource={RelativeSource TemplatedParent}}"
                                    ToolTip="{local:Loc ResourceKey=Iptv_PreviousChannel}"
                                    AutomationProperties.Name="{local:Loc ResourceKey=Iptv_PreviousChannel}"
                                    Click="PipPreviousChannel_Click">
                                <Path Width="9" Height="15" Stretch="Uniform" Data="M 10,2 L 3,9 L 10,16"
                                      Stroke="White" StrokeThickness="1.8" StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Button>
                            <Button x:Name="NextChannelButton" Style="{StaticResource PipButtonStyle}"
                                    IsEnabled="{Binding Content.CanNavigate, RelativeSource={RelativeSource TemplatedParent}}"
                                    ToolTip="{local:Loc ResourceKey=Iptv_NextChannel}"
                                    AutomationProperties.Name="{local:Loc ResourceKey=Iptv_NextChannel}"
                                    Click="PipNextChannel_Click">
                                <Path Width="9" Height="15" Stretch="Uniform" Data="M 3,2 L 10,9 L 3,16"
                                      Stroke="White" StrokeThickness="1.8" StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="ChannelInfo" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="PipControls" Property="Opacity" Value="1"/>
                        <Setter TargetName="PipControls" Property="IsHitTestVisible" Value="True"/>
                    </Trigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="True"/>
                            <Condition Binding="{Binding Content.ShowForKeyboard, RelativeSource={RelativeSource Self}}" Value="True"/>
                        </MultiDataTrigger.Conditions>
                        <Setter TargetName="ChannelInfo" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="PipControls" Property="Opacity" Value="1"/>
                        <Setter TargetName="PipControls" Property="IsHitTestVisible" Value="True"/>
                    </MultiDataTrigger>
                    <DataTrigger Binding="{Binding Content.HasError, RelativeSource={RelativeSource Self}}" Value="True">
                        <Setter TargetName="ChannelInfo" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Content.Status, RelativeSource={RelativeSource Self}}" Value="">
                        <Setter TargetName="ChannelStatus" Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <Style x:Key="VolumeSliderStyle" TargetType="Slider">
                <Setter Property="Height" Value="24"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid VerticalAlignment="Center">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Height="4" Background="{DynamicResource AccentColor}" CornerRadius="2"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Height="4" Background="#38383D" CornerRadius="2"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Ellipse Width="12" Height="12" Fill="#FFFFFF" Stroke="{DynamicResource AccentColor}" StrokeThickness="2" Cursor="Hand"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CatalogToolbarButtonStyle" TargetType="ToggleButton">
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="Foreground" Value="#AEB6C1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="ToolbarButton" Background="Transparent" BorderBrush="Transparent"
                                    BorderThickness="1" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ToolbarButton" Property="Background" Value="#303034"/>
                                    <Setter Property="Foreground" Value="#E8E8E8"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="ToolbarButton" Property="Background" Value="#24374A"/>
                                    <Setter Property="Foreground" Value="#9AD3FF"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="ToolbarButton" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ResolutionChoiceStyle" TargetType="RadioButton">
                <Setter Property="GroupName" Value="IptvResolutionFilter"/>
                <Setter Property="Foreground" Value="#B8C4D1"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="MinHeight" Value="28"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Choice" Background="Transparent" BorderBrush="Transparent"
                                    BorderThickness="1" CornerRadius="4" Margin="1,0" Padding="1,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Choice" Property="Background" Value="#303034"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Choice" Property="Background" Value="#24374A"/>
                                    <Setter Property="Foreground" Value="#A8DAFF"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Choice" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CatalogFilterActionStyle" TargetType="Button">
                <Setter Property="Foreground" Value="#B8C4D1"/>
                <Setter Property="Padding" Value="6,0"/>
                <Setter Property="MinHeight" Value="28"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ActionBackground" Background="Transparent" BorderBrush="Transparent"
                                    BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ActionBackground" Property="Background" Value="#34343A"/>
                                    <Setter Property="Foreground" Value="#E8E8E8"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="ActionBackground" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ChannelListItemStyle" TargetType="ListBoxItem">
                <Setter Property="MinHeight" Value="40"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#C0C0C0"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Grid SnapsToDevicePixels="True">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="1"/>
                                </Grid.RowDefinitions>
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Margin="0,1"
                                        BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="RowDivider" Grid.Row="1" Background="#36363D"
                                        Margin="2,0" IsHitTestVisible="False"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#25252A"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsOnAir}" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#192C3D"/>
                                </DataTrigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#42627D"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <!-- Видео-зона слева -->
            <ColumnDefinition x:Name="ColVideo" Width="*" MinWidth="480"/>
            <!-- Разделитель -->
            <ColumnDefinition Width="Auto"/>
            <!-- Сайдбар каналов справа (~360 DIP) -->
            <ColumnDefinition x:Name="ColSidebar" Width="280" MinWidth="230" MaxWidth="480"/>
        </Grid.ColumnDefinitions>

        <!-- Левая зона: видео + контролы -->
        <Grid Grid.Column="0" Background="#0C0C0D">
            <Grid.RowDefinitions>
                <!-- Область VideoView 16:9 -->
                <RowDefinition Height="*"/>
                <!-- Инфо-полоса канала -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Black">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Margin="24">
                    <TextBlock x:Name="TxtStatusMessage" Text="{local:Loc ResourceKey=Iptv_SelectChannel}"
                               TextAlignment="Center" TextWrapping="Wrap" Foreground="#B8BBC2" FontSize="14"/>
                    <Button x:Name="BtnRetryStream" Style="{StaticResource CommandButtonStyle}" Margin="0,10,0,0"
                            HorizontalAlignment="Center" Visibility="Collapsed"
                            Content="{local:Loc ResourceKey=Iptv_RetryStream}" Click="BtnRetryStream_Click"/>
                </StackPanel>
                <ContentControl x:Name="PipIdleOverlay" Visibility="Collapsed" Focusable="False"
                                Template="{StaticResource PipOverlayTemplate}"/>
                <iptv:IptvVideoViewport x:Name="VideoViewport" SizeChanged="VideoViewport_SizeChanged">
                    <vlc:VideoView x:Name="VlcVideoView" Background="Black" Visibility="Hidden">
                        <Grid PreviewKeyDown="IptvPlayerWindow_PreviewKeyDown">
                            <!-- VideoView hosts its content in a separate window over the native player. -->
                            <Grid x:Name="VideoSurface" Background="#01000000" Visibility="Collapsed"
                                  Focusable="True" KeyboardNavigation.IsTabStop="False"
                                  MouseLeftButtonDown="Surface_MouseLeftButtonDown" MouseLeftButtonUp="Surface_MouseLeftButtonUp"
                                  MouseMove="Surface_MouseMove" LostMouseCapture="Surface_LostMouseCapture">
                                <Border x:Name="VideoControls" VerticalAlignment="Bottom" Padding="12,16,12,8"
                                        Visibility="Collapsed" IsKeyboardFocusWithinChanged="VideoControls_FocusChanged"
                                        PreviewMouseLeftButtonUp="VideoControls_PreviewMouseLeftButtonUp">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0"/>
                                            <GradientStop Color="#CC000000" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <DockPanel LastChildFill="False">
                                        <Button x:Name="VideoPause" DockPanel.Dock="Left" Style="{StaticResource PipButtonStyle}"
                                                Content="&#xF5A2;" IsEnabled="False" ToolTipService.ShowOnDisabled="True"
                                                Click="BtnPause_Click"/>
                                        <Button x:Name="VideoFullscreen" DockPanel.Dock="Right" Style="{StaticResource PipButtonStyle}"
                                                Content="&#xE684;" Click="BtnFullscreen_Click"/>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource PipButtonStyle}" Margin="0,0,6,0"
                                                ToolTip="{local:Loc ResourceKey=Iptv_PictureInPicture}"
                                                AutomationProperties.Name="{local:Loc ResourceKey=Iptv_PictureInPicture}"
                                                Click="BtnPictureInPicture_Click">
                                            <Viewbox Width="18" Height="18">
                                                <Path Data="M 12,4 H 4 V 20 H 20 V 12 M 15,3 H 21 V 9 M 21,3 L 10,14"
                                                      Stroke="White" StrokeThickness="1.6" StrokeLineJoin="Round"/>
                                            </Viewbox>
                                        </Button>
                                        <Slider x:Name="VideoVolume" DockPanel.Dock="Right" Width="64" Margin="4,0,12,0"
                                                Minimum="0" Maximum="100" Value="80" SmallChange="5" LargeChange="10"
                                                AutomationProperties.Name="{local:Loc ResourceKey=Iptv_Volume}"
                                                Style="{StaticResource VolumeSliderStyle}" ValueChanged="SldVolume_ValueChanged"/>
                                        <Button x:Name="VideoMute" DockPanel.Dock="Right" Style="{StaticResource PipButtonStyle}"
                                                Content="&#xEB42;" Click="BtnMute_Click"/>
                                    </DockPanel>
                                </Border>
                            </Grid>
                            <ContentControl x:Name="PipVideoOverlay" Visibility="Collapsed" Focusable="False"
                                            Template="{StaticResource PipOverlayTemplate}"/>
                        </Grid>
                    </vlc:VideoView>
                </iptv:IptvVideoViewport>
            </Grid>

            <Border x:Name="TransportBar" Grid.Row="1" Background="#161618" Padding="8,6" BorderBrush="#222225" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Транспорт: Play/Stop/Pause -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                        <Button x:Name="BtnPlayStop" Style="{StaticResource PlayerButtonStyle}" Content="&#xF606;"
                                ToolTip="Воспроизведение / Стоп" Click="BtnPlayStop_Click"/>
                        <Button x:Name="BtnPause" Style="{StaticResource PlayerButtonStyle}" Content="&#xF5A2;"
                                Margin="6,0,0,0" ToolTipService.ShowOnDisabled="True" Click="BtnPause_Click" IsEnabled="False"/>
                    </StackPanel>

                    <!-- Громкость: Mute + Slider -->
                    <DockPanel Grid.ColumnSpan="4" Margin="2,0,2,5" LastChildFill="True">
                        <Button x:Name="BtnStreamInfo" DockPanel.Dock="Right" Style="{StaticResource CommandButtonStyle}" MinWidth="0" MinHeight="0"
                                Height="20" Padding="6,0" FontSize="11" Margin="8,0,0,0"
                                Visibility="Collapsed" ToolTip="{local:Loc ResourceKey=Iptv_StreamInfo}"
                                AutomationProperties.Name="{local:Loc ResourceKey=Iptv_StreamInfo}" Click="BtnStreamInfo_Click">
                            <TextBlock x:Name="TxtStreamFormat" TextTrimming="CharacterEllipsis"/>
                        </Button>
                        <TextBlock x:Name="TxtPlaybackStatus" DockPanel.Dock="Right" Foreground="#AEB6C1" FontSize="11"
                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                        <TextBlock x:Name="TxtActiveChannel" FontSize="13" FontWeight="SemiBold" Foreground="White"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox x:Name="CmbVariants" Height="26" Width="82" Margin="0,0,6,0"
                                  ToolTip="{local:Loc ResourceKey=Iptv_StreamVariant}"
                                  Visibility="Collapsed" SelectionChanged="CmbVariants_SelectionChanged"/>
                        <Button x:Name="BtnMute" Style="{StaticResource PlayerButtonStyle}" Content="&#xEB42;"
                                ToolTip="Без звука (M)" Click="BtnMute_Click"/>
                        <Slider x:Name="SldVolume" Width="64" Margin="4,0,6,0" Minimum="0" Maximum="100" Value="80"
                                Style="{StaticResource VolumeSliderStyle}"
                                AutoToolTipPlacement="TopLeft"
                                SmallChange="5" LargeChange="10" VerticalAlignment="Center" ValueChanged="SldVolume_ValueChanged"/>
                    </StackPanel>

                    <!-- Правые действия: Полный экран / Боковая панель -->
                    <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal">
                        <ToggleButton x:Name="BtnFillVideo" Height="30" Margin="0,0,4,0"
                                      Content="{local:Loc ResourceKey=Iptv_FillLabel}" Foreground="#E3E3E3"
                                      ToolTip="{local:Loc ResourceKey=Iptv_FillVideo}"
                                      Checked="BtnFillVideo_Changed" Unchecked="BtnFillVideo_Changed">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="FillBackground" Background="#26262A" CornerRadius="4" Padding="8,0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="FillBackground" Property="Background" Value="#34343A"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="FillBackground" Property="Background" Value="#1B4160"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Button x:Name="BtnToggleSidebar" Style="{StaticResource PlayerButtonStyle}" Content="&#xE8BD;"
                                ToolTip="{local:Loc ResourceKey=Iptv_VideoOnly}" Margin="0,0,4,0" Click="BtnToggleSidebar_Click"/>
                        <Button x:Name="BtnPictureInPicture" Style="{StaticResource PlayerButtonStyle}"
                                AutomationProperties.Name="{local:Loc ResourceKey=Iptv_PictureInPicture}"
                                ToolTip="{local:Loc ResourceKey=Iptv_PictureInPicture}" Margin="0,0,4,0" Click="BtnPictureInPicture_Click">
                            <Viewbox Width="18" Height="18">
                                <Path Data="M 12,4 H 4 V 20 H 20 V 12 M 15,3 H 21 V 9 M 21,3 L 10,14"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6" StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Viewbox>
                        </Button>
                        <Button x:Name="BtnFullscreen" Style="{StaticResource PlayerButtonStyle}" Content="&#xE684;"
                                ToolTip="Во весь экран (F)" Click="BtnFullscreen_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Разделитель колонок -->
        <GridSplitter x:Name="Splitter" Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="#1C1C1F" ShowsPreview="False"/>

        <!-- Правая панель: каналы и фильтры -->
        <Border x:Name="ChannelsSidebar" Grid.Column="2" Background="#1A1A1D" BorderBrush="#26262A" BorderThickness="1,0,0,0">
            <Grid Margin="10,10,10,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="#252526" BorderBrush="#303035" BorderThickness="1" CornerRadius="6"
                        Padding="2" Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox x:Name="TxtSearch" Style="{StaticResource BaseTextBoxStyle}" Height="30"
                                     Background="Transparent" BorderBrush="Transparent" Padding="27,0,23,0"
                                     AutomationProperties.Name="{Binding Text, ElementName=TxtSearchWatermark}"
                                     TextChanged="TxtSearch_TextChanged"/>
                            <Path Width="12" Height="12" Stretch="Uniform" Data="M 10,6 A 4,4 0 1 1 2,6 A 4,4 0 1 1 10,6 M 9,9 L 14,14"
                                  Stroke="#AEB6C1" StrokeThickness="1.5" Margin="8,0,0,0" HorizontalAlignment="Left"
                                  VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBlock x:Name="TxtSearchWatermark" Foreground="#AEB6C1" FontSize="12"
                                       IsHitTestVisible="False" VerticalAlignment="Center" Margin="27,0,5,0"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{local:Loc ResourceKey=Iptv_SearchChannels}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=BtnFavorites}" Value="True">
                                                <Setter Property="Text" Value="{local:Loc ResourceKey=Iptv_SearchFavorites}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button x:Name="BtnClearSearch" Content="×" FontFamily="Segoe UI" FontSize="15"
                                    Style="{StaticResource PlayerButtonStyle}" Width="20" Height="20" Background="Transparent"
                                    AutomationProperties.Name="{local:Loc ResourceKey=Iptv_ClearSearch}"
                                    ToolTip="{local:Loc ResourceKey=Iptv_ClearSearch}"
                                    HorizontalAlignment="Right" Margin="0,0,2,0" Visibility="Collapsed" Click="BtnClearSearch_Click"/>
                        </Grid>
                        <ToggleButton x:Name="BtnFavorites" Grid.Column="1" Style="{StaticResource CatalogToolbarButtonStyle}"
                                      FontFamily="Segoe UI Symbol" FontSize="17" Content="☆"
                                      ToolTip="{local:Loc ResourceKey=Iptv_Favorites}"
                                      AutomationProperties.Name="{local:Loc ResourceKey=Iptv_Favorites}" Click="CatalogFavorites_Click"/>
                        <ToggleButton x:Name="BtnFilters" Grid.Column="2" Style="{StaticResource CatalogToolbarButtonStyle}"
                                      ToolTip="{local:Loc ResourceKey=Iptv_Filters}"
                                      AutomationProperties.Name="{local:Loc ResourceKey=Iptv_Filters}">
                            <Grid Width="16" Height="16">
                                <Path Data="M 1,4 H 15 M 1,12 H 15 M 6,1 V 7 M 10,9 V 15"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                      StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Ellipse x:Name="FilterIndicator" Width="5" Height="5" HorizontalAlignment="Right"
                                         VerticalAlignment="Top" Margin="-2" Fill="#9AD3FF" Visibility="Collapsed"/>
                            </Grid>
                        </ToggleButton>
                    </Grid>
                </Border>

                <UniformGrid x:Name="ResolutionChoices" Grid.Row="1" Columns="6" Margin="0,0,0,6"
                             AutomationProperties.Name="{local:Loc ResourceKey=Iptv_ResolutionFilter}">
                    <RadioButton Style="{StaticResource ResolutionChoiceStyle}" Tag="{x:Static iptv:IptvResolution.Any}"
                                 Content="{local:Loc ResourceKey=Iptv_AnyResolution}" IsChecked="True"
                                 ToolTip="{local:Loc ResourceKey=Iptv_ResolutionFilter}" Click="ResolutionChoice_Click"/>
                    <RadioButton Style="{StaticResource ResolutionChoiceStyle}" Tag="{x:Static iptv:IptvResolution.Sd}"
                                 Content="SD" Click="ResolutionChoice_Click"/>
                    <RadioButton Style="{StaticResource ResolutionChoiceStyle}" Tag="{x:Static iptv:IptvResolution.Hd}"
                                 Content="HD" ToolTip="720p" Click="ResolutionChoice_Click"/>
                    <RadioButton Style="{StaticResource ResolutionChoiceStyle}" Tag="{x:Static iptv:IptvResolution.Fhd}"
                                 Content="FHD" ToolTip="1080p / 1080i" Click="ResolutionChoice_Click"/>
                    <RadioButton Style="{StaticResource ResolutionChoiceStyle}" Tag="{x:Static iptv:IptvResolution.Qhd}"
                                 Content="QHD" ToolTip="1440p" Click="ResolutionChoice_Click"/>
                    <RadioButton Style="{StaticResource ResolutionChoiceStyle}" Tag="{x:Static iptv:IptvResolution.Uhd}"
                                 Content="4K" ToolTip="{local:Loc ResourceKey=Iptv_UhdOrHigher}" Click="ResolutionChoice_Click"/>
                </UniformGrid>

                <WrapPanel x:Name="ActiveFilters" Grid.Row="2" Visibility="Collapsed" Margin="0,0,0,3">
                    <Button x:Name="BtnClearPlaylist" Style="{StaticResource CommandButtonStyle}" Visibility="Collapsed"
                            Height="25" Padding="6,0" MinHeight="0" MinWidth="0" Margin="0,0,5,4"
                            AutomationProperties.Name="{local:Loc ResourceKey=Iptv_ClearPlaylistFilter}" Click="ClearPlaylistFilter_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtPlaylistFilter" MaxWidth="146" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="×" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnClearGroup" Style="{StaticResource CommandButtonStyle}" Visibility="Collapsed"
                            Height="25" Padding="6,0" MinHeight="0" MinWidth="0" Margin="0,0,5,4"
                            AutomationProperties.Name="{local:Loc ResourceKey=Iptv_ClearGroupFilter}" Click="ClearGroupFilter_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtGroupFilter" MaxWidth="146" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="×" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <Border Grid.Row="3" Background="#222225" BorderBrush="#333337" BorderThickness="1"
                        CornerRadius="6" Padding="11,10,11,7" Margin="0,0,0,8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=BtnFilters}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <StackPanel>
                            <TextBlock Text="{local:Loc ResourceKey=Iptv_PlaylistFilter}"
                                       Foreground="#AEB6C1" FontSize="12" Margin="0,0,0,5"/>
                            <ComboBox x:Name="CmbPlaylists" Height="32" DisplayMemberPath="Display" SelectedValuePath="Value"
                                      AutomationProperties.Name="{local:Loc ResourceKey=Iptv_PlaylistFilter}"
                                      SelectionChanged="CmbPlaylists_SelectionChanged"/>
                        </StackPanel>
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="{local:Loc ResourceKey=Iptv_GroupFilter}"
                                       Foreground="#AEB6C1" FontSize="12" Margin="0,0,0,5"/>
                            <ComboBox x:Name="CmbGroups" Height="32" DisplayMemberPath="Display" SelectedValuePath="Value"
                                      AutomationProperties.Name="{local:Loc ResourceKey=Iptv_GroupFilter}"
                                      SelectionChanged="CmbGroups_SelectionChanged"/>
                        </StackPanel>
                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.ColumnSpan="2" Height="1" Background="#38383E" Margin="0,0,0,4"/>
                            <Button Grid.Row="1" Style="{StaticResource CatalogFilterActionStyle}"
                                    Content="{local:Loc ResourceKey=Iptv_ManageSources}" HorizontalAlignment="Left"
                                    ToolTip="{local:Loc ResourceKey=IptvSettings_SourcesTitle}" Click="BtnSources_Click"/>
                            <Button x:Name="BtnResetFilters" Grid.Row="1" Grid.Column="1" Style="{StaticResource CatalogFilterActionStyle}"
                                    Content="{local:Loc ResourceKey=Iptv_ResetFilters}" Visibility="Collapsed"
                                    Margin="6,0,0,0" Click="ClearCatalogFilters_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Список каналов -->
                <ListBox x:Name="LstChannels" Grid.Row="4" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource ChannelListItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.PanningMode="VerticalOnly"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         VirtualizingPanel.CacheLength="4,4"
                         VirtualizingPanel.CacheLengthUnit="Item"
                         SelectionChanged="LstChannels_SelectionChanged"
                         PreviewMouseLeftButtonUp="LstChannels_MouseLeftButtonUp">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="26"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="26" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Image x:Name="ChannelLogo" Source="{Binding LogoImage}" Stretch="Uniform"/>
                                    <Path x:Name="ChannelLogoFallback" Width="26" Height="26" IsHitTestVisible="False"
                                          Visibility="Collapsed" Stretch="Uniform" Stroke="#8E9AAA"
                                          StrokeThickness="1.4" StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M 3,4 H 21 V 16 H 3 Z M 12,16 V 21 M 8,21 H 16"/>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,4,0">
                                    <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#E8E8E8" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="ChannelSecondary" Text="{Binding SecondaryText}" Margin="0,2,0,0"
                                               Foreground="#AEB6C1" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock x:Name="OnAirMarker" Grid.Column="2" Text="▶" FontFamily="Segoe UI Symbol" FontSize="12"
                                           Visibility="Collapsed" Foreground="#81C8FF" VerticalAlignment="Center" Margin="0,0,3,0"
                                           ToolTip="{local:Loc ResourceKey=Iptv_OnAir}"/>
                                <Button x:Name="BtnStar" Grid.Column="3" Style="{StaticResource PlayerButtonStyle}"
                                        Width="26" Height="26" Background="Transparent" FontFamily="Segoe UI Symbol" FontSize="17"
                                        Content="☆" Opacity="0" IsHitTestVisible="False" Tag="{Binding}" Click="BtnStar_Click"
                                        ToolTip="{local:Loc ResourceKey=Iptv_AddFavorite}"
                                        AutomationProperties.Name="{local:Loc ResourceKey=Iptv_AddFavorite}"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Source, ElementName=ChannelLogo}" Value="{x:Null}">
                                    <Setter TargetName="ChannelLogo" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="ChannelLogoFallback" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SecondaryText}" Value="{x:Null}">
                                    <Setter TargetName="ChannelSecondary" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsOnAir}" Value="True">
                                    <Setter TargetName="OnAirMarker" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="BtnStar" Property="Opacity" Value="1"/>
                                    <Setter TargetName="BtnStar" Property="IsHitTestVisible" Value="True"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="BtnStar" Property="Opacity" Value="1"/>
                                    <Setter TargetName="BtnStar" Property="IsHitTestVisible" Value="True"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                    <Setter TargetName="BtnStar" Property="Opacity" Value="1"/>
                                    <Setter TargetName="BtnStar" Property="IsHitTestVisible" Value="True"/>
                                    <Setter TargetName="BtnStar" Property="Content" Value="★"/>
                                    <Setter TargetName="BtnStar" Property="Foreground" Value="#FFB84D"/>
                                    <Setter TargetName="BtnStar" Property="ToolTip" Value="{local:Loc ResourceKey=Iptv_RemoveFavorite}"/>
                                    <Setter TargetName="BtnStar" Property="AutomationProperties.Name" Value="{local:Loc ResourceKey=Iptv_RemoveFavorite}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Индикатор загрузки списка каналов -->
                <StackPanel x:Name="PnlLoadingChannels" Grid.Row="4" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="&#xF190;" FontFamily="{StaticResource FluentSystemIcons}" FontSize="22"
                               Foreground="{DynamicResource AccentColor}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Загрузка каналов..." Foreground="#8E95A0" FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Индикатор пустого списка -->
                <TextBlock x:Name="TxtNoChannels" Grid.Row="4" Text="{local:Loc ResourceKey=Iptv_NoMatchingChannels}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#AEB6C1" FontSize="12" Margin="12" TextAlignment="Center"
                           TextWrapping="Wrap" Visibility="Collapsed"/>

            </Grid>
        </Border>
    </Grid>
</local:DarkWindow>
