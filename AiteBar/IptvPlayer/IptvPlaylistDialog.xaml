<local:DarkWindow x:Class="AiteBar.IptvPlayer.IptvPlaylistDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AiteBar"
        WindowClass="UtilityTool"
        Title="Плейлист IPTV"
        Width="540"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="#191919"
        Foreground="#D0D0D0"
        BorderBrush="#333333"
        BorderThickness="1">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AiteBar;component/SettingsWindowResources.xaml" />
                <ResourceDictionary Source="/AiteBar;component/FormControlsResources.xaml" />
                <ResourceDictionary Source="/AiteBar;component/UtilityWindowResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Название источника -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="LblName" Text="Название плейлиста" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="#E0E0E0"/>
            <TextBox x:Name="TxtName" Style="{StaticResource BaseTextBoxStyle}" Height="32"/>
        </StackPanel>

        <!-- Тип источника -->
        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock x:Name="LblKind" Text="Тип источника" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="#E0E0E0"/>
            <ComboBox x:Name="CmbKind" Height="32" SelectionChanged="CmbKind_SelectionChanged">
                <ComboBoxItem Content="URL (M3U / M3U8)" Tag="Url"/>
                <ComboBoxItem Content="Локальный файл (.m3u, .m3u8)" Tag="LocalFile"/>
                <ComboBoxItem Content="Встроенный текст (M3U)" Tag="InlineText"/>
                <ComboBoxItem Content="Одиночный поток (URL)" Tag="SingleStream"/>
            </ComboBox>
        </StackPanel>

        <!-- Расположение (URL / Путь) -->
        <StackPanel x:Name="PnlLocation" Grid.Row="2" Margin="0,0,0,14">
            <TextBlock x:Name="LblLocation" Text="Ссылка или путь" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="#E0E0E0"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtLocation" Grid.Column="0" Style="{StaticResource BaseTextBoxStyle}" Height="32"/>
                <Button x:Name="BtnBrowse" Grid.Column="1" Content="Обзор..." Margin="8,0,0,0" Width="80" Height="32"
                        Style="{StaticResource SecondaryButtonStyle}" Click="BtnBrowse_Click" Visibility="Collapsed"/>
            </Grid>
        </StackPanel>

        <!-- Встроенный текст -->
        <StackPanel x:Name="PnlInlineText" Grid.Row="3" Margin="0,0,0,14" Visibility="Collapsed">
            <TextBlock x:Name="LblInlineContent" Text="Содержимое M3U" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="#E0E0E0"/>
            <TextBox x:Name="TxtInlineContent" Style="{StaticResource BaseTextBoxStyle}" Height="120"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <!-- Опции -->
        <StackPanel Grid.Row="4" Margin="0,0,0,14">
            <CheckBox x:Name="ChkAutoFallbackVariants" Content="Автоматически группировать варианты качества (HD/FHD/SD)"
                      Margin="0,0,0,8" IsChecked="True"/>
            <CheckBox x:Name="ChkCopyLocalFileToStore" Content="Копировать локальный файл в профиль приложения"
                      Margin="0,0,0,8" IsChecked="True" Visibility="Collapsed"/>
            <CheckBox x:Name="ChkIsEnabled" Content="Плейлист включен" IsChecked="True"/>
        </StackPanel>

        <!-- Блок проверки -->
        <Border Grid.Row="5" Background="#222222" CornerRadius="4" Padding="12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnCheck" Grid.Column="0" Content="Проверить" Width="100" Height="30"
                        Style="{StaticResource SecondaryButtonStyle}" Click="BtnCheck_Click"/>
                <TextBlock x:Name="TxtCheckResult" Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"
                           Text="Нажмите 'Проверить' для валидации потока" Foreground="#888888" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <!-- Кнопки управления -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnSave" Content="Сохранить" Width="100" Height="32"
                    Style="{StaticResource PrimaryButtonStyle}" Click="BtnSave_Click"/>
            <Button x:Name="BtnCancel" Content="Отмена" Width="90" Height="32" Margin="8,0,0,0"
                    Style="{StaticResource SecondaryButtonStyle}" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</local:DarkWindow>
