<local:DarkWindow x:Class="AiteBar.IconConverterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AiteBar"
        Icon="pack://application:,,,/Resources/app.ico"
        Title="{local:Loc ResourceKey=IconConverter_Title}"
        Width="680" Height="560" MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="#1A1A1C" Foreground="#DCDCDC"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsWindowResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="CommandButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="Height" Value="34"/>
                <Setter Property="MinWidth" Value="72"/>
                <Setter Property="Padding" Value="14,0"/>
            </Style>

            <Style x:Key="PrimaryCommandButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            </Style>

            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="PreviewLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#D8DEE6"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,6,0,0"/>
            </Style>

            <Style x:Key="OptionRadioButtonStyle" TargetType="RadioButton">
                <Setter Property="Height" Value="28"/>
                <Setter Property="Foreground" Value="#D8DEE6"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="8,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="RadioBorder"
                                            Width="16"
                                            Height="16"
                                            BorderBrush="#3A3A3E"
                                            BorderThickness="1"
                                            Background="#2D2D30"
                                            CornerRadius="8"
                                            VerticalAlignment="Center"
                                            Margin="0,0,6,0">
                                        <Ellipse x:Name="RadioCheck"
                                                 Width="8"
                                                 Height="8"
                                                 Fill="White"
                                                 Visibility="Collapsed"/>
                                    </Border>
                                    <ContentPresenter Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RadioBorder" Property="Background" Value="#343438"/>
                                    <Setter TargetName="RadioBorder" Property="BorderBrush" Value="#4A4A4E"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="RadioBorder" Property="Background" Value="{StaticResource AccentColor}"/>
                                    <Setter TargetName="RadioBorder" Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                                    <Setter TargetName="RadioCheck" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#3ABEFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="90"/>
                <RowDefinition Height="112"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#151922"
                BorderBrush="#273344"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtDropTitle"
                               Text="{local:Loc ResourceKey=IconConverter_DropHint}"
                               Foreground="White"
                               FontSize="13"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtSource"
                               Text="{local:Loc ResourceKey=IconConverter_NoFile}"
                               Foreground="{StaticResource MutedText}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,7,10,0"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="{local:Loc ResourceKey=IconConverter_ChooseImage}"
                        Style="{StaticResource CommandButtonStyle}"
                        VerticalAlignment="Center"
                        Click="BtnChoose_Click"/>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,10,0,0">
            <StackPanel Margin="0,0,8,0">
                <Border Height="74" Background="#101318" BorderBrush="#273344" BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Image x:Name="ImgPreview16" Width="16" Height="16" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <TextBlock Text="16" Style="{StaticResource PreviewLabelStyle}"/>
            </StackPanel>
            <StackPanel Margin="4,0,8,0">
                <Border Height="74" Background="#101318" BorderBrush="#273344" BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Image x:Name="ImgPreview32" Width="32" Height="32" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <TextBlock Text="32" Style="{StaticResource PreviewLabelStyle}"/>
            </StackPanel>
            <StackPanel Margin="4,0,8,0">
                <Border Height="74" Background="#101318" BorderBrush="#273344" BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Image x:Name="ImgPreview48" Width="48" Height="48" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <TextBlock Text="48" Style="{StaticResource PreviewLabelStyle}"/>
            </StackPanel>
            <StackPanel Margin="4,0,0,0">
                <Border Height="74" Background="#101318" BorderBrush="#273344" BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Image x:Name="ImgPreview256" Width="64" Height="64" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <TextBlock Text="256" Style="{StaticResource PreviewLabelStyle}"/>
            </StackPanel>
        </UniformGrid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.08*"/>
                <ColumnDefinition Width="1.12*"/>
            </Grid.ColumnDefinitions>

            <Border Background="#151922" BorderBrush="#273344" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{local:Loc ResourceKey=IconConverter_Sizes}" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,8"/>
                    <WrapPanel Grid.Row="1">
                        <CheckBox x:Name="Chk16" Content="16" IsChecked="True" Margin="0,0,10,8" Click="Options_Changed"/>
                        <CheckBox x:Name="Chk20" Content="20" Margin="0,0,10,8" Click="Options_Changed"/>
                        <CheckBox x:Name="Chk24" Content="24" IsChecked="True" Margin="0,0,10,8" Click="Options_Changed"/>
                        <CheckBox x:Name="Chk32" Content="32" IsChecked="True" Margin="0,0,10,8" Click="Options_Changed"/>
                        <CheckBox x:Name="Chk40" Content="40" Margin="0,0,10,8" Click="Options_Changed"/>
                        <CheckBox x:Name="Chk48" Content="48" IsChecked="True" Margin="0,0,10,8" Click="Options_Changed"/>
                        <CheckBox x:Name="Chk64" Content="64" IsChecked="True" Margin="0,0,10,8" Click="Options_Changed"/>
                        <CheckBox x:Name="Chk128" Content="128" IsChecked="True" Margin="0,0,10,8" Click="Options_Changed"/>
                        <CheckBox x:Name="Chk256" Content="256" IsChecked="True" Margin="0,0,10,8" Click="Options_Changed"/>
                    </WrapPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="{local:Loc ResourceKey=IconConverter_PracticalPreset}" MinWidth="92" Style="{StaticResource CommandButtonStyle}" Margin="0,0,8,0" Click="BtnPracticalPreset_Click"/>
                        <Button Content="{local:Loc ResourceKey=IconConverter_WindowsPreset}" MinWidth="104" Style="{StaticResource CommandButtonStyle}" Click="BtnWindowsPreset_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="#151922" BorderBrush="#273344" BorderThickness="1" CornerRadius="6" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{local:Loc ResourceKey=IconConverter_Padding}" Style="{StaticResource FieldLabelStyle}" Width="72"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                        <Slider x:Name="SldPadding" Width="128" Minimum="0" Maximum="20" Value="8" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Options_Changed"/>
                        <TextBlock x:Name="TxtPadding" Width="36" Text="8%" Foreground="#D8DEE6" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{local:Loc ResourceKey=IconConverter_FitMode}" Style="{StaticResource FieldLabelStyle}" Width="72" Margin="0,12,0,0"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                        <RadioButton x:Name="RbFit" Content="{local:Loc ResourceKey=IconConverter_Fit}" IsChecked="True" Margin="0,0,6,0" Checked="Options_Changed" Style="{StaticResource OptionRadioButtonStyle}"/>
                        <RadioButton x:Name="RbFill" Content="{local:Loc ResourceKey=IconConverter_Fill}" Checked="Options_Changed" Style="{StaticResource OptionRadioButtonStyle}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{local:Loc ResourceKey=IconConverter_Background}" Style="{StaticResource FieldLabelStyle}" Width="72" Margin="0,12,0,0"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                        <RadioButton x:Name="RbTransparent" Content="{local:Loc ResourceKey=IconConverter_BackgroundTransparent}" IsChecked="True" Margin="0,0,6,0" Checked="Options_Changed" Style="{StaticResource OptionRadioButtonStyle}"/>
                        <RadioButton x:Name="RbSolid" Content="{local:Loc ResourceKey=IconConverter_BackgroundSolid}" Checked="Options_Changed" Style="{StaticResource OptionRadioButtonStyle}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{local:Loc ResourceKey=IconConverter_Color}" Style="{StaticResource FieldLabelStyle}" Width="72" Margin="0,12,0,0"/>
                    <TextBox x:Name="TxtBackgroundColor" Grid.Row="3" Grid.Column="1" Text="#000000" Margin="0,8,0,0" TextChanged="BackgroundColor_Changed" Style="{StaticResource BaseTextBoxStyle}"/>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TxtStatus"
                       Foreground="{StaticResource MutedText}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>
            <Button x:Name="BtnSave"
                    Grid.Column="1"
                    Content="{local:Loc ResourceKey=IconConverter_SaveIco}"
                    Style="{StaticResource PrimaryCommandButtonStyle}"
                    IsEnabled="False"
                    Click="BtnSave_Click"/>
        </Grid>
        </Grid>
    </Grid>
</local:DarkWindow>
