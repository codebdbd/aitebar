<local:DarkWindow x:Class="AiteBar.IconConverterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AiteBar"
        Icon="pack://application:,,,/Resources/app.ico"
        Title="{local:Loc ResourceKey=IconConverter_Title}"
        Width="600" MinWidth="580" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" Background="#1A1A1C" Foreground="#DCDCDC"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsWindowResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="CommandButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="Height" Value="34"/>
                <Setter Property="Padding" Value="14,0"/>
            </Style>

            <Style x:Key="PrimaryCommandButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}"/>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#C7D0DD"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="PanelBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="#151922"/>
                <Setter Property="BorderBrush" Value="#273344"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="12"/>
            </Style>

            <DrawingBrush x:Key="IconPreviewCheckerBrush" TileMode="Tile" Viewport="0,0,12,12" ViewportUnits="Absolute">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#0F1319" Geometry="M0,0 H12 V12 H0 Z"/>
                        <GeometryDrawing Brush="#151A22" Geometry="M0,0 H6 V6 H0 Z M6,6 H12 V12 H6 Z"/>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>

            <Style x:Key="PreviewSurfaceStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource IconPreviewCheckerBrush}"/>
                <Setter Property="BorderBrush" Value="#2A3546"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="4"/>
            </Style>

            <Style x:Key="PreviewLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#D8DEE6"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,6,0,0"/>
            </Style>

            <Style x:Key="OptionRadioButtonStyle" TargetType="RadioButton">
                <Setter Property="Height" Value="28"/>
                <Setter Property="Foreground" Value="#D8DEE6"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="8,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="RadioBorder"
                                            Width="16"
                                            Height="16"
                                            BorderBrush="#3A3A3E"
                                            BorderThickness="1"
                                            Background="#2D2D30"
                                            CornerRadius="8"
                                            VerticalAlignment="Center"
                                            Margin="0,0,6,0">
                                        <Ellipse x:Name="RadioCheck"
                                                 Width="8"
                                                 Height="8"
                                                 Fill="White"
                                                 Visibility="Collapsed"/>
                                    </Border>
                                    <ContentPresenter Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RadioBorder" Property="Background" Value="#343438"/>
                                    <Setter TargetName="RadioBorder" Property="BorderBrush" Value="#4A4A4E"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="RadioBorder" Property="Background" Value="{StaticResource AccentColor}"/>
                                    <Setter TargetName="RadioBorder" Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                                    <Setter TargetName="RadioCheck" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#3ABEFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PanelBorderStyle}" Height="74">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtDropTitle"
                               Text="{local:Loc ResourceKey=IconConverter_DropHint}"
                               Foreground="White"
                               FontSize="13"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtSource"
                               Text="{local:Loc ResourceKey=IconConverter_NoFile}"
                               Foreground="{StaticResource MutedText}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,7,12,0"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="{local:Loc ResourceKey=IconConverter_ChooseImage}"
                        Style="{StaticResource CommandButtonStyle}"
                        VerticalAlignment="Center"
                        Click="BtnChoose_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="218"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
                <StackPanel>
                    <TextBlock Text="{local:Loc ResourceKey=IconConverter_Preview}" Style="{StaticResource SectionTitleStyle}"/>

                    <Border Width="124" Height="124" Style="{StaticResource PreviewSurfaceStyle}" HorizontalAlignment="Center">
                        <Grid>
                            <Image x:Name="ImgPreview256" Width="92" Height="92" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <TextBlock Style="{StaticResource PreviewLabelStyle}">
                        <Run Text="256 px"/>
                        <Run Text=" / "/>
                        <Run Text="{local:Loc ResourceKey=IconConverter_ScaledPreview}"/>
                    </TextBlock>

                    <UniformGrid Columns="3" Margin="0,10,0,0">
                        <StackPanel Margin="0,0,6,0">
                            <Border Width="50" Height="50" Style="{StaticResource PreviewSurfaceStyle}" HorizontalAlignment="Center">
                                <Grid>
                                    <Image x:Name="ImgPreview16" Width="16" Height="16" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="16 px" Style="{StaticResource PreviewLabelStyle}"/>
                        </StackPanel>
                        <StackPanel Margin="3,0,3,0">
                            <Border Width="50" Height="50" Style="{StaticResource PreviewSurfaceStyle}" HorizontalAlignment="Center">
                                <Grid>
                                    <Image x:Name="ImgPreview32" Width="32" Height="32" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="32 px" Style="{StaticResource PreviewLabelStyle}"/>
                        </StackPanel>
                        <StackPanel Margin="6,0,0,0">
                            <Border Width="50" Height="50" Style="{StaticResource PreviewSurfaceStyle}" HorizontalAlignment="Center">
                                <Grid>
                                    <Image x:Name="ImgPreview48" Width="48" Height="48" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="48 px" Style="{StaticResource PreviewLabelStyle}"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{local:Loc ResourceKey=IconConverter_Sizes}" Style="{StaticResource SectionTitleStyle}"/>
                    <UniformGrid Columns="3" Margin="0,0,0,14">
                        <CheckBox x:Name="Chk16" Content="16" IsChecked="True" Margin="0,0,8,8" VerticalAlignment="Center" Click="Options_Changed"/>
                        <CheckBox x:Name="Chk20" Content="20" IsChecked="True" Margin="0,0,8,8" VerticalAlignment="Center" Click="Options_Changed"/>
                        <CheckBox x:Name="Chk24" Content="24" IsChecked="True" Margin="0,0,0,8" VerticalAlignment="Center" Click="Options_Changed"/>
                        <CheckBox x:Name="Chk32" Content="32" IsChecked="True" Margin="0,0,8,8" VerticalAlignment="Center" Click="Options_Changed"/>
                        <CheckBox x:Name="Chk40" Content="40" IsChecked="True" Margin="0,0,8,8" VerticalAlignment="Center" Click="Options_Changed"/>
                        <CheckBox x:Name="Chk48" Content="48" IsChecked="True" Margin="0,0,0,8" VerticalAlignment="Center" Click="Options_Changed"/>
                        <CheckBox x:Name="Chk64" Content="64" IsChecked="True" Margin="0,0,8,0" VerticalAlignment="Center" Click="Options_Changed"/>
                        <CheckBox x:Name="Chk128" Content="128" IsChecked="True" Margin="0,0,8,0" VerticalAlignment="Center" Click="Options_Changed"/>
                        <CheckBox x:Name="Chk256" Content="256" IsChecked="True" Margin="0,0,0,0" VerticalAlignment="Center" Click="Options_Changed"/>
                    </UniformGrid>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="68"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{local:Loc ResourceKey=IconConverter_Padding}" Style="{StaticResource FieldLabelStyle}"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                            <Slider x:Name="SldPadding" Width="136" Minimum="0" Maximum="20" Value="8" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Options_Changed"/>
                            <TextBlock x:Name="TxtPadding" Width="38" Text="8%" Foreground="#D8DEE6" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{local:Loc ResourceKey=IconConverter_FitMode}" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,0"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                            <RadioButton x:Name="RbFit" Content="{local:Loc ResourceKey=IconConverter_Fit}" IsChecked="True" Margin="0,0,8,0" Checked="Options_Changed" Style="{StaticResource OptionRadioButtonStyle}"/>
                            <RadioButton x:Name="RbFill" Content="{local:Loc ResourceKey=IconConverter_Fill}" Checked="Options_Changed" Style="{StaticResource OptionRadioButtonStyle}"/>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{local:Loc ResourceKey=IconConverter_Background}" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,0"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                            <RadioButton x:Name="RbTransparent" Content="{local:Loc ResourceKey=IconConverter_BackgroundTransparent}" IsChecked="True" Margin="0,0,8,0" Checked="Options_Changed" Style="{StaticResource OptionRadioButtonStyle}"/>
                            <RadioButton x:Name="RbSolid" Content="{local:Loc ResourceKey=IconConverter_BackgroundSolid}" Checked="Options_Changed" Style="{StaticResource OptionRadioButtonStyle}"/>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{local:Loc ResourceKey=IconConverter_Color}" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,0"/>
                        <TextBox x:Name="TxtBackgroundColor" Grid.Row="3" Grid.Column="1" Text="#000000" Margin="0,8,0,0" TextChanged="BackgroundColor_Changed" Style="{StaticResource BaseTextBoxStyle}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TxtStatus"
                       Foreground="{StaticResource MutedText}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"/>
            <Button x:Name="BtnSave"
                    Grid.Column="1"
                    Content="{local:Loc ResourceKey=IconConverter_SaveIco}"
                    Style="{StaticResource PrimaryCommandButtonStyle}"
                    IsEnabled="False"
                    Click="BtnSave_Click"/>
        </Grid>
    </Grid>
</local:DarkWindow>
