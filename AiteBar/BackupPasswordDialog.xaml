<local:DarkWindow x:Class="AiteBar.BackupPasswordDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:AiteBar"
                  Title="{local:Loc ResourceKey=Backup_DialogTitle}" Width="430" SizeToContent="Height"
                  WindowStartupLocation="CenterOwner" Background="#191919" Foreground="White"
                  WindowStyle="SingleBorderWindow" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="TxtDescription" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,16"/>
        <CheckBox x:Name="ChkFullBackup" Grid.Row="1" Content="{local:Loc ResourceKey=Backup_IncludeSensitive}" Margin="0,0,0,10" Checked="ChkFullBackup_Changed" Unchecked="ChkFullBackup_Changed"/>
        <StackPanel x:Name="SensitiveOptions" Grid.Row="2" Visibility="Collapsed">
            <CheckBox x:Name="ChkClipboard" Content="{local:Loc ResourceKey=Backup_IncludeClipboard}" Margin="0,0,0,10"/>
            <TextBlock Text="{local:Loc ResourceKey=Backup_Password}" FontSize="12" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PwdPassword" Margin="0,0,0,16"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{local:Loc ResourceKey=Common_Cancel}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Padding="16,6" IsCancel="True"/>
            <Button Content="{local:Loc ResourceKey=Common_OK}" Style="{StaticResource PrimaryButtonStyle}" Padding="16,6" IsDefault="True" Click="BtnOk_Click"/>
        </StackPanel>
    </Grid>
</local:DarkWindow>
