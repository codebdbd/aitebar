<local:DarkWindow x:Class="AiteBar.InstalledAppsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AiteBar"
        Icon="pack://application:,,,/AiteBar;component/Resources/app.ico"
        Title="{local:Loc ResourceKey=InstalledApps_Title}"
        Height="620" Width="580" MinHeight="450" MinWidth="420"
        WindowStartupLocation="CenterOwner" Background="#191919" Foreground="#DCDCDC"
        WindowStyle="SingleBorderWindow" ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="FormControlsResources.xaml"/>
                <ResourceDictionary Source="SettingsWindowResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="MutedText" Color="#9BA1A6"/>

            <Style x:Key="AppListItemStyle" TargetType="ListBoxItem">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="Margin" Value="0,1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="4"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#2A2A2D"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#005A9E"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsSelected" Value="True"/>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Bd" Property="Background" Value="#0069BA"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Поиск -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <TextBox x:Name="TxtSearch"
                     TextChanged="TxtSearch_TextChanged"
                     Padding="8,0"
                     Height="{StaticResource FormControlHeight}"/>
            <TextBlock x:Name="TxtSearchPlaceholder"
                       Text="{local:Loc ResourceKey=InstalledApps_SearchPlaceholder}"
                       Margin="{StaticResource FormInputPlaceholderMargin}"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource PlaceholderForegroundBrush}"
                       IsHitTestVisible="False"/>
        </Grid>

        <!-- 2. Индикатор загрузки и счетчик -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <ProgressBar x:Name="PrgLoading"
                         IsIndeterminate="True"
                         Height="3"
                         Background="#252526"
                         Foreground="#007ACC"
                         BorderThickness="0"
                         Visibility="Visible"/>
            <TextBlock x:Name="LblStatus"
                       FontSize="11"
                       Foreground="{StaticResource MutedText}"
                       HorizontalAlignment="Right"
                       Margin="0,6,0,0"/>
        </Grid>

        <!-- 3. Список приложений -->
        <ListBox x:Name="LstApps"
                 Grid.Row="2"
                 Background="#202022"
                 BorderBrush="#333336"
                 BorderThickness="1"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                 ItemContainerStyle="{StaticResource AppListItemStyle}"
                 SelectionChanged="LstApps_SelectionChanged"
                 MouseDoubleClick="LstApps_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Height="36">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Иконка приложения -->
                        <Border Grid.Column="0" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>

                        <!-- Текстовое описание -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="{Binding Name}"
                                       Foreground="White"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Description}"
                                       Foreground="{StaticResource MutedText}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,1,0,0"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 4. Нижняя панель действий -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Обзор на диске -->
            <Button x:Name="BtnBrowseDisk"
                    Grid.Column="0"
                    Content="{local:Loc ResourceKey=InstalledApps_BrowseDisk}"
                    Click="BtnBrowseDisk_Click"
                    Height="{StaticResource FormControlHeight}"
                    Padding="12,0"
                    Style="{StaticResource FormSelectionButtonStyle}"/>

            <!-- Кнопки выбора и отмены -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="BtnSelect"
                        Content="{local:Loc ResourceKey=InstalledApps_Select}"
                        Click="BtnSelect_Click"
                        IsEnabled="False"
                        Width="90"
                        Height="{StaticResource FormControlHeight}"
                        Margin="0,0,8,0"
                        Style="{StaticResource FormSelectionButtonStyle}"/>
                <Button x:Name="BtnCancel"
                        Content="{local:Loc ResourceKey=Common_Cancel}"
                        Click="BtnCancel_Click"
                        Width="90"
                        Height="{StaticResource FormControlHeight}"
                        Style="{StaticResource FormSelectionButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Grid>
</local:DarkWindow>
