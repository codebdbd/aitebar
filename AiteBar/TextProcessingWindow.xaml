<local:DarkWindow x:Class="AiteBar.TextProcessingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AiteBar"
        Icon="pack://application:,,,/AiteBar;component/Resources/app.ico"
        Title="{local:Loc ResourceKey=TextProcessing_Title}"
        Width="1280" Height="840"
        MinWidth="1000" MinHeight="700"
        MaxWidth="1920" MaxHeight="1200"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A1C" Foreground="#DCDCDC"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False" Topmost="True"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged"
        SizeChanged="Window_SizeChanged"
        LocationChanged="Window_LocationChanged"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsWindowResources.xaml"/>
                <ResourceDictionary Source="FormControlsResources.xaml"/>
                <ResourceDictionary Source="UtilityWindowResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- Side action button: 80x80, icon 48px + label -->
            <Style x:Key="SideActionStyle" TargetType="Button">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Width" Value="80"/>
                <Setter Property="Height" Value="80"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="#252526"/>
                <Setter Property="BorderBrush" Value="#3A3A3C"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="#A0A0A8"/>
                <Setter Property="FontFamily" Value="pack://application:,,,/Resources/#FluentSystemIcons-Regular"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#303238"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#4A4A4E"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#232326"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsKeyboardFocused" Value="True"/>
                                        <Condition Property="local:KeyboardFocusVisualService.ShowKeyboardFocusCue" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FormControlFocusBorderBrush}"/>
                                </MultiTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Background" Value="#1C1C1E"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#2A2A2E"/>
                                    <Setter Property="Foreground" Value="#555558"/>
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Segmented mode selector -->
            <Style x:Key="ModeSegmentStyle" TargetType="RadioButton">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Foreground" Value="#8E8E93"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="UseLayoutRounding" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderThickness="0"
                                    Padding="0">
                                <ContentPresenter x:Name="Content"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#C0C0C5"/>
                                    <Setter Property="Background" Value="#2A2A2E"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="#555558"/>
                                    <Setter Property="Opacity" Value="0.6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Mode description info bar -->
            <Style x:Key="ModeInfoBarStyle" TargetType="Border">
                <Setter Property="Background" Value="#1C1C1E"/>
                <Setter Property="BorderBrush" Value="#2A2A2E"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="20,16"/>
            </Style>

            <!-- Editor TextBox: dark theme, no fixed Height, fills grid row -->
            <Style x:Key="EditorTextBoxStyle" TargetType="TextBox">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#E8EDF2"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="VerticalContentAlignment" Value="Top"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="UseLayoutRounding" Value="True"/>
                <Setter Property="CaretBrush" Value="#E8EDF2"/>
                <Setter Property="SelectionBrush" Value="{DynamicResource AccentColor}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Top"
                                              SnapsToDevicePixels="True"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="32,24">
        <!-- Title section -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <TextBlock Text="{local:Loc ResourceKey=TextProcessing_Title}"
                       FontSize="30" FontWeight="SemiBold" Foreground="#E8EDF2"
                       HorizontalAlignment="Left"/>
            <TextBlock Text="{local:Loc ResourceKey=TextProcessing_Description}"
                       FontSize="15" Foreground="#8E8E93" Margin="0,6,0,0"
                       HorizontalAlignment="Left"/>
        </StackPanel>

        <!-- Mode switcher: segmented control -->
        <Border DockPanel.Dock="Top" Style="{StaticResource SegmentedContainerStyle}"
                Height="56" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <RadioButton x:Name="BtnModeProofread" Grid.Column="0"
                             Style="{StaticResource ModeSegmentStyle}"
                             Content="{local:Loc ResourceKey=TextProcessing_ModeProofread}"
                             IsChecked="True" Tag="Proofread"
                             Click="ModeSegment_Click"/>

                <RadioButton x:Name="BtnModeTypography" Grid.Column="1"
                             Style="{StaticResource ModeSegmentStyle}"
                             Content="{local:Loc ResourceKey=TextProcessing_ModeTypography}"
                             Tag="Typography"
                             Click="ModeSegment_Click"/>

                <RadioButton x:Name="BtnModeCleanup" Grid.Column="2"
                             Style="{StaticResource ModeSegmentStyle}"
                             Content="{local:Loc ResourceKey=TextProcessing_ModeCleanup}"
                             Tag="Cleanup"
                             Click="ModeSegment_Click"/>
            </Grid>
        </Border>

        <!-- Mode description -->
        <Border DockPanel.Dock="Top" Style="{StaticResource ModeInfoBarStyle}"
                Margin="0,0,0,16" MinHeight="64">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE946;" FontFamily="pack://application:,,,/Resources/#FluentSystemIcons-Regular"
                           FontSize="16" Foreground="#5A5A5E" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="TxtModeDescription" TextWrapping="Wrap"
                           FontSize="15" Foreground="#B0B0B5" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Bottom panel: Model selector (left) + Process button (right, aligned with editor) -->
        <Grid DockPanel.Dock="Bottom" Height="52" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Model selector: label + combobox -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{local:Loc ResourceKey=TextProcessing_ModelLabel}"
                           VerticalAlignment="Center" FontSize="13"
                           Foreground="#8E8E93" Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbModels"
                          Width="220"
                          ItemsSource="{Binding Models}"
                          DisplayMemberPath="Display"
                          SelectedIndex="0"
                          SelectionChanged="CmbModels_SelectionChanged"
                          ToolTip="{local:Loc ResourceKey=TextProcessing_DataWarning}"/>
            </StackPanel>

            <!-- Process / Cancel button: aligned with editor right edge -->
            <Button x:Name="BtnProcess" Grid.Column="2"
                    Style="{StaticResource PrimaryCommandButtonStyle}"
                    MinWidth="200" Height="44"
                    Click="BtnProcess_Click"/>
        </Grid>

        <!-- Content area -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="738"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Editor: Grid with TextBox (Row 0) + counter (Row 1) -->
            <Border Grid.Column="0" BorderBrush="#3A3A3C" BorderThickness="1"
                    CornerRadius="4" Background="#1C1C1E">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>

                    <!-- TextBox fills Row 0 -->
                    <Grid Grid.Row="0">
                        <TextBox x:Name="TxtEditor"
                                 Style="{StaticResource EditorTextBoxStyle}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 FontSize="17"
                                 Padding="24,20"
                                 AcceptsTab="False"
                                 MaxLength="50000"
                                 TextChanged="TxtEditor_TextChanged"/>
                        <TextBlock x:Name="TxtPlaceholder"
                                   Text="{local:Loc ResourceKey=TextProcessing_Placeholder}"
                                   FontSize="17" Foreground="#5A5A5E"
                                   Padding="24,20" IsHitTestVisible="False"
                                   Visibility="Visible"/>
                    </Grid>

                    <!-- Counter row at bottom -->
                    <Border Grid.Row="1" Height="36"
                            BorderBrush="#2A2A2E" BorderThickness="0,1,0,0"
                            CornerRadius="0,0,4,4">
                        <Grid Margin="24,0">
                            <TextBlock x:Name="TxtCounters"
                                       VerticalAlignment="Center"
                                       FontSize="13" Foreground="#8E8E93"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Side panel: 80x80 icon buttons -->
            <StackPanel Grid.Column="2" Margin="0">
                <!-- Paste -->
                <Button x:Name="BtnPaste"
                        Style="{StaticResource SideActionStyle}"
                        Click="BtnPaste_Click" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="&#xE77F;" FontSize="48"
                                   FontFamily="pack://application:,,,/Resources/#FluentSystemIcons-Regular"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{local:Loc ResourceKey=TextProcessing_ButtonPaste}"
                                   FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <!-- Copy -->
                <Button x:Name="BtnCopy"
                        Style="{StaticResource SideActionStyle}"
                        Click="BtnCopy_Click" Margin="0,0,0,12"
                        IsEnabled="False">
                    <StackPanel>
                        <TextBlock Text="&#xE8C8;" FontSize="48"
                                   FontFamily="pack://application:,,,/Resources/#FluentSystemIcons-Regular"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{local:Loc ResourceKey=TextProcessing_ButtonCopy}"
                                   FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <!-- Repeat -->
                <Button x:Name="BtnRepeat"
                        Style="{StaticResource SideActionStyle}"
                        Click="BtnRepeat_Click" Margin="0,0,0,12"
                        IsEnabled="False">
                    <StackPanel>
                        <TextBlock Text="&#xE72C;" FontSize="48"
                                   FontFamily="pack://application:,,,/Resources/#FluentSystemIcons-Regular"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{local:Loc ResourceKey=TextProcessing_ButtonRepeat}"
                                   FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <!-- Show original / Show result -->
                <Button x:Name="BtnToggleVersion"
                        Style="{StaticResource SideActionStyle}"
                        Click="BtnToggleVersion_Click" Margin="0,0,0,12"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="ToggleVersionIcon" Text="&#xE749;" FontSize="48"
                                   FontFamily="pack://application:,,,/Resources/#FluentSystemIcons-Regular"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ToggleVersionLabel"
                                   FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <!-- Clear -->
                <Button x:Name="BtnClear"
                        Style="{StaticResource SideActionStyle}"
                        Click="BtnClear_Click" Margin="0,0,0,12"
                        IsEnabled="False">
                    <StackPanel>
                        <TextBlock Text="&#xE74D;" FontSize="48"
                                   FontFamily="pack://application:,,,/Resources/#FluentSystemIcons-Regular"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{local:Loc ResourceKey=TextProcessing_ButtonClear}"
                                   FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </DockPanel>
</local:DarkWindow>
