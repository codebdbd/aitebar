<local:DarkWindow x:Class="AiteBar.TimerStopwatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AiteBar"
        Icon="pack://application:,,,/Resources/app.ico"
        Width="420" Height="420" MinWidth="420" MinHeight="330"
        WindowStartupLocation="Manual" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="White" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        Loaded="Window_Loaded"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>

        <Style x:Key="CompactActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="{StaticResource AccentColor}"/>
            <Setter Property="Background" Value="{StaticResource FormControlBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource FormControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource FormControlBackgroundHover}"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#102A3D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource CompactActionButtonStyle}">
            <Setter Property="Foreground" Value="#AEB6C1"/>
        </Style>

        <Style x:Key="ModeButtonStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentColor}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource FormControlBackgroundHover}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#148BDB"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PresetButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Foreground" Value="#D8DEE6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="CommandButtonStyle" TargetType="Button" BasedOn="{StaticResource UtilityCommandButtonStyle}">
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="PrimaryCommandButtonStyle" TargetType="Button" BasedOn="{StaticResource CommandButtonStyle}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentColor}"/>
        </Style>

        <Style x:Key="TimeInputStyle" TargetType="TextBox" BasedOn="{StaticResource BaseTextBoxStyle}">
            <Setter Property="CaretBrush" Value="{StaticResource AccentColor}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="MaxLength" Value="8"/>
        </Style>

        <Storyboard x:Key="TimerCompletionFlashStoryboard">
            <ColorAnimationUsingKeyFrames Storyboard.TargetName="CompactCompletionFlashBrush" Storyboard.TargetProperty="Color">
                <DiscreteColorKeyFrame KeyTime="0:0:0" Value="#2AA8FF"/>
                <DiscreteColorKeyFrame KeyTime="0:0:0.18" Value="#E85A5A"/>
                <DiscreteColorKeyFrame KeyTime="0:0:0.36" Value="#2AA8FF"/>
                <DiscreteColorKeyFrame KeyTime="0:0:0.54" Value="#E85A5A"/>
                <DiscreteColorKeyFrame KeyTime="0:0:0.72" Value="#2AA8FF"/>
                <DiscreteColorKeyFrame KeyTime="0:0:0.90" Value="#2A2A2A"/>
            </ColorAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CompactCompletionFlash" Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.88"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.18" Value="0.35"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.36" Value="0.88"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.54" Value="0.35"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.72" Value="0.88"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.05" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TxtCompactDisplay" Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.18" Value="0.45"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.36" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.54" Value="0.45"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.72" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.05" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Storyboard x:Key="TimerDisplayCompletionFlashStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TxtTimerDisplay" Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.18" Value="0.45"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.36" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.54" Value="0.45"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.72" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.05" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Border x:Name="RootBorder" Margin="8" CornerRadius="8" Background="{StaticResource BorderColor}" BorderBrush="#332A9CFF" BorderThickness="0.7">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.45"/>
            </Border.Effect>

            <Border x:Name="InnerBorder" CornerRadius="7" Background="{StaticResource PanelBackground}">
            <Grid x:Name="ContentGrid" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="HeaderRow" Height="36"/>
                    <RowDefinition x:Name="DisplayRow" Height="126"/>
                    <RowDefinition x:Name="PresetRows" Height="84"/>
                    <RowDefinition x:Name="TimerInputRow" Height="44"/>
                    <RowDefinition x:Name="ActionSpacerRow" Height="20"/>
                    <RowDefinition x:Name="ActionRow" Height="44"/>
                </Grid.RowDefinitions>

                <Grid x:Name="FullHeaderView" Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="{StaticResource FormControlBackground}" BorderBrush="{StaticResource FormControlBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="1" Margin="0,0,10,0">
                        <UniformGrid Columns="2" HorizontalAlignment="Stretch">
                            <RadioButton x:Name="RbTimer" IsChecked="True" Style="{StaticResource ModeButtonStyle}" Checked="Mode_Checked" Content="{local:Loc ResourceKey=TimerStopwatch_Timer}"/>
                            <RadioButton x:Name="RbStopwatch" Style="{StaticResource ModeButtonStyle}" Checked="Mode_Checked" Content="{local:Loc ResourceKey=TimerStopwatch_Stopwatch}"/>
                        </UniformGrid>
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnCompact" Content="&#xE923;" FontFamily="Segoe MDL2 Assets" FontSize="14" Style="{StaticResource HeaderButtonStyle}" ToolTip="{local:Loc ResourceKey=TimerStopwatch_Compact}" Click="BtnCompact_Click"/>
                        <Button Content="&#xF369;" Style="{StaticResource HeaderButtonStyle}" ToolTip="{local:Loc ResourceKey=Common_Close}" Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="TimerView" Grid.Row="1" Grid.RowSpan="3" Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="126"/>
                        <RowDefinition Height="84"/>
                        <RowDefinition Height="44"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="TxtTimerDisplay" Text="05:00" Width="340" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="58" FontWeight="Light" Foreground="#F2F4F7" TextAlignment="Center" HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular" TextOptions.TextFormattingMode="Display"/>
                        <Canvas x:Name="TimerProgressTicks" Grid.Row="1" Height="18" Margin="4,14,4,0" HorizontalAlignment="Stretch" ClipToBounds="True" SizeChanged="TimerProgressTicks_SizeChanged"/>
                    </Grid>

                    <UniformGrid Grid.Row="1" Columns="5" Rows="2">
                        <Button x:Name="BtnPreset1" Content="{local:Loc ResourceKey=TimerStopwatch_Preset1Minute}" Style="{StaticResource PresetButtonStyle}" Click="Preset1_Click"/>
                        <Button x:Name="BtnPreset3" Content="{local:Loc ResourceKey=TimerStopwatch_Preset3Minutes}" Style="{StaticResource PresetButtonStyle}" Click="Preset3_Click"/>
                        <Button x:Name="BtnPreset5" Content="{local:Loc ResourceKey=TimerStopwatch_Preset5Minutes}" Style="{StaticResource PresetButtonStyle}" Click="Preset5_Click"/>
                        <Button x:Name="BtnPreset10" Content="{local:Loc ResourceKey=TimerStopwatch_Preset10Minutes}" Style="{StaticResource PresetButtonStyle}" Click="Preset10_Click"/>
                        <Button x:Name="BtnPreset15" Content="{local:Loc ResourceKey=TimerStopwatch_Preset15Minutes}" Style="{StaticResource PresetButtonStyle}" Click="Preset15_Click"/>
                        <Button x:Name="BtnPreset30" Content="{local:Loc ResourceKey=TimerStopwatch_Preset30Minutes}" Style="{StaticResource PresetButtonStyle}" Click="Preset30_Click"/>
                        <Button x:Name="BtnPreset45" Content="{local:Loc ResourceKey=TimerStopwatch_Preset45Minutes}" Style="{StaticResource PresetButtonStyle}" Click="Preset45_Click"/>
                        <Button x:Name="BtnPreset60" Content="{local:Loc ResourceKey=TimerStopwatch_Preset60Minutes}" Style="{StaticResource PresetButtonStyle}" Click="Preset60_Click"/>
                        <Button x:Name="BtnPreset90" Content="{local:Loc ResourceKey=TimerStopwatch_Preset90Minutes}" Style="{StaticResource PresetButtonStyle}" Click="Preset90_Click"/>
                        <Button x:Name="BtnPreset120" Content="{local:Loc ResourceKey=TimerStopwatch_Preset120Minutes}" Style="{StaticResource PresetButtonStyle}" Click="Preset120_Click"/>
                    </UniformGrid>

                    <Grid Grid.Row="2" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtTimerInput" Margin="4" Text="00:05:00" Style="{StaticResource TimeInputStyle}" ToolTip="{local:Loc ResourceKey=TimerStopwatch_CustomTime}" PreviewTextInput="TimeInput_PreviewTextInput" TextChanged="TimerInput_TextChanged"/>
                        <Button x:Name="BtnSound" Grid.Column="1" Content="&#xEB42;" Style="{StaticResource PresetButtonStyle}" FontFamily="pack://application:,,,/Resources/#FluentSystemIcons-Regular" FontSize="18" Margin="4" ToolTip="{local:Loc ResourceKey=TimerStopwatch_SoundDefault}" Click="BtnSound_Click"/>
                    </Grid>
                </Grid>

                <Grid x:Name="StopwatchView" Grid.Row="1" Grid.RowSpan="3" Margin="0" Visibility="Collapsed">
                    <TextBlock x:Name="TxtStopwatchDisplay" Text="00:00:00.00" Width="340" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="54" FontWeight="Light" Foreground="#F7F9FC" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" TextOptions.TextFormattingMode="Display"/>
                </Grid>

                <UniformGrid x:Name="FullActionView" Grid.Row="5" Columns="2" HorizontalAlignment="Stretch">
                    <Button x:Name="BtnStartPause" Style="{StaticResource PrimaryCommandButtonStyle}" Click="BtnStartPause_Click" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtStartPauseIcon" Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,9,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtStartPauseLabel" Text="{local:Loc ResourceKey=TimerStopwatch_Start}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnReset" Style="{StaticResource CommandButtonStyle}" Click="BtnReset_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,9,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{local:Loc ResourceKey=TimerStopwatch_Reset}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </Grid>
            </Border>
        </Border>

        <Border x:Name="CompactRootBorder" Margin="3" CornerRadius="6" Background="{StaticResource BorderColor}" BorderBrush="#332A9CFF" BorderThickness="0.7" Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.45"/>
            </Border.Effect>

            <Border CornerRadius="5" Background="{StaticResource PanelBackground}">
                <Grid>
                    <Border x:Name="CompactCompletionFlash" CornerRadius="5" Opacity="0" IsHitTestVisible="False">
                        <Border.Background>
                            <SolidColorBrush x:Name="CompactCompletionFlashBrush" Color="#2A2A2A"/>
                        </Border.Background>
                    </Border>

                    <Grid Margin="8" Height="36" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="32"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TxtCompactModeIcon" Text="&#xED88;" FontFamily="pack://application:,,,/Resources/#FluentSystemIcons-Regular" FontSize="24" Foreground="{StaticResource AccentColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtCompactDisplay" Grid.Column="1" Text="00:00" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="23" FontWeight="Regular" Foreground="#FFFFFF" TextAlignment="Left" VerticalAlignment="Center" Margin="8,-2,0,0" LineHeight="28" LineStackingStrategy="BlockLineHeight" Typography.NumeralAlignment="Tabular" TextOptions.TextFormattingMode="Display"/>
                    <Button x:Name="BtnCompactStartPause" Grid.Column="2" Content="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="18" Style="{StaticResource CompactActionButtonStyle}" ToolTip="{local:Loc ResourceKey=TimerStopwatch_Start}" Click="BtnStartPause_Click"/>
                    <Button Grid.Column="4" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="14" Style="{StaticResource CompactSecondaryButtonStyle}" ToolTip="{local:Loc ResourceKey=TimerStopwatch_Expand}" Click="BtnCompact_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</local:DarkWindow>
