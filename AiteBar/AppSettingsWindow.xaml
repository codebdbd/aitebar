<local:DarkWindow x:Class="AiteBar.AppSettingsWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:local="clr-namespace:AiteBar"

        Icon="pack://application:,,,/Resources/app.ico"

        Title="{local:Loc ResourceKey=AppSettingsWindow_Title}" Width="1200" Height="680"

        MinWidth="960" MinHeight="600"

        WindowStartupLocation="CenterScreen" Background="#191919" Foreground="#DCDCDC"

        WindowStyle="SingleBorderWindow" ResizeMode="CanResize" ShowInTaskbar="True"

        Topmost="False" Loaded="Window_Loaded">



    <Window.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary Source="SettingsWindowResources.xaml"/>

            </ResourceDictionary.MergedDictionaries>



            <local:FontNameConverter x:Key="FontNameConverter"/>

            <local:ColorBrushConverter x:Key="ColorBrushConverter"/>



            <SolidColorBrush x:Key="PanelBadge1" Color="#2563EB"/>

            <SolidColorBrush x:Key="PanelBadge2" Color="#059669"/>

            <SolidColorBrush x:Key="PanelBadge3" Color="#D97706"/>

            <SolidColorBrush x:Key="PanelBadge4" Color="#7C3AED"/>



            <Style x:Key="HotkeyModifierButtonStyle" TargetType="ToggleButton">

                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

                <Setter Property="Width" Value="62"/>

                <Setter Property="Height" Value="{StaticResource FormControlHeight}"/>

                <Setter Property="Margin" Value="0,0,6,0"/>

                <Setter Property="Foreground" Value="{StaticResource FormControlForegroundBrush}"/>

                <Setter Property="Background" Value="#151A22"/>

                <Setter Property="BorderBrush" Value="{StaticResource FormControlBorderBrush}"/>

                <Setter Property="BorderThickness" Value="1"/>

                <Setter Property="Cursor" Value="Hand"/>

                <Setter Property="FontSize" Value="13"/>

                <Setter Property="FontWeight" Value="SemiBold"/>


                <Setter Property="Template">

                    <Setter.Value>

                        <ControlTemplate TargetType="ToggleButton">
                            <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">

                                <Border x:Name="Outline"

                                        Background="{TemplateBinding BorderBrush}"

                                        CornerRadius="6"

                                        SnapsToDevicePixels="True"/>

                                <Border x:Name="Chrome"

                                        Margin="1"

                                        Background="{TemplateBinding Background}"

                                        CornerRadius="5"

                                        SnapsToDevicePixels="True">

                                <Grid Margin="8,0">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter HorizontalAlignment="Center"

                                                      VerticalAlignment="Center"

                                                      RecognizesAccessKey="True"/>

                                    <TextBlock x:Name="CheckMark"

                                               Grid.Column="1"

                                               Text="✓"

                                               Margin="5,0,0,0"

                                               FontSize="12"

                                               FontWeight="Bold"

                                               Foreground="White"

                                               VerticalAlignment="Center"

                                               Visibility="Collapsed"/>

                                </Grid>

                                </Border>

                            </Grid>

                            <ControlTemplate.Triggers>

                                <Trigger Property="IsMouseOver" Value="True">

                                    <Setter TargetName="Chrome" Property="Background" Value="#1D2633"/>

                                    <Setter TargetName="Outline" Property="Background" Value="{StaticResource FormControlBorderHoverBrush}"/>

                                </Trigger>

                                <Trigger Property="IsChecked" Value="True">

                                    <Setter TargetName="Chrome" Property="Background" Value="#2D7BEA"/>

                                    <Setter TargetName="Outline" Property="Background" Value="Transparent"/>

                                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>

                                    <Setter Property="Foreground" Value="White"/>

                                </Trigger>

                                <MultiTrigger>

                                    <MultiTrigger.Conditions>

                                        <Condition Property="IsChecked" Value="True"/>

                                        <Condition Property="IsMouseOver" Value="True"/>

                                    </MultiTrigger.Conditions>

                                    <Setter TargetName="Chrome" Property="Background" Value="#3487F3"/>

                                    <Setter TargetName="Outline" Property="Background" Value="#3487F3"/>

                                </MultiTrigger>

                                <MultiTrigger>

                                    <MultiTrigger.Conditions>

                                        <Condition Property="IsKeyboardFocused" Value="True"/>

                                        <Condition Property="local:KeyboardFocusVisualService.ShowKeyboardFocusCue" Value="True"/>

                                    </MultiTrigger.Conditions>

                                    <Setter TargetName="Outline" Property="Background" Value="{StaticResource FormControlFocusBorderBrush}"/>

                                </MultiTrigger>

                                <Trigger Property="IsEnabled" Value="False">

                                    <Setter Property="Foreground" Value="{StaticResource FormControlDisabledForegroundBrush}"/>

                                    <Setter TargetName="Chrome" Property="Opacity" Value="0.55"/>

                                </Trigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>

                    </Setter.Value>

                </Setter>

            </Style>

            <SolidColorBrush x:Key="ModernCardBackground" Color="#20252D"/>
            <SolidColorBrush x:Key="ModernRowDivider" Color="#303945"/>

            <Style x:Key="ModernSectionAnchorStyle" TargetType="Border">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Margin" Value="0,0,0,32"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
            </Style>

            <Style x:Key="ModernSettingsCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource ModernCardBackground}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="20"/>
                <Setter Property="Margin" Value="0,0,0,16"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <Style x:Key="ModernSettingTitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#F4F7FA"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="ModernSectionTitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#F6F8FB"/>
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>

            <Style x:Key="ModernSettingDescriptionStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#9EA9B7"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Margin" Value="0,4,0,0"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="ModernDividerStyle" TargetType="Border">
                <Setter Property="Height" Value="1"/>
                <Setter Property="Background" Value="{StaticResource ModernRowDivider}"/>
                <Setter Property="Margin" Value="0"/>
            </Style>

            <Style x:Key="ModernSwitchStyle" TargetType="CheckBox">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Width" Value="44"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Width="44" Height="24" SnapsToDevicePixels="True">
                                <Border x:Name="Track" Background="#46505D" CornerRadius="12"/>
                                <Ellipse x:Name="Thumb" Width="18" Height="18" Margin="3"
                                         HorizontalAlignment="Left" Fill="#F4F7FA"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="#596574"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentColor}"/>
                                    <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsKeyboardFocused" Value="True"/>
                                        <Condition Property="local:KeyboardFocusVisualService.ShowKeyboardFocusCue" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Track" Property="BorderBrush" Value="#FFFFFF"/>
                                    <Setter TargetName="Track" Property="BorderThickness" Value="1"/>
                                </MultiTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ModernSelectionCardStyle" TargetType="RadioButton">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Width" Value="126"/>
                <Setter Property="Height" Value="92"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Foreground" Value="#D8E0EA"/>
                <Setter Property="Background" Value="#252C35"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Card" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" Padding="10">
                                <Grid>
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    <Border x:Name="SelectedBadge" Width="20" Height="20" CornerRadius="10"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,-5,-5,0" Background="{DynamicResource AccentColor}"
                                            Visibility="Collapsed">
                                        <TextBlock Text="✓" Foreground="White" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Card" Property="Background" Value="#2B3440"/>
                                    <Setter TargetName="Card" Property="BorderBrush" Value="#5D6A79"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                    <Setter TargetName="Card" Property="Background" Value="#223349"/>
                                    <Setter TargetName="SelectedBadge" Property="Visibility" Value="Visible"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsKeyboardFocused" Value="True"/>
                                        <Condition Property="local:KeyboardFocusVisualService.ShowKeyboardFocusCue" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ModernSliderScaleLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#8E99A7"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="LineHeight" Value="14"/>
                <Setter Property="MinWidth" Value="42"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            </Style>

            <Style TargetType="local:HotkeyCaptureBox">
                <Setter Property="Height" Value="36"/>
                <Setter Property="Width" Value="250"/>
                <Setter Property="Foreground" Value="#F2F5F8"/>
                <Setter Property="Background" Value="#2D2D2D"/>
                <Setter Property="BorderBrush" Value="#46515F"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="NotAssignedText" Value="{local:Loc ResourceKey=Common_NotAssigned}"/>
                <Setter Property="CapturePromptText" Value="{local:Loc ResourceKey=HotkeyCapture_Prompt}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="local:HotkeyCaptureBox">
                            <Border x:Name="Field" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <Grid Margin="12,0,2,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter VerticalAlignment="Center"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                    <Button x:Name="ClearButton"
                                            Grid.Column="1"
                                            Width="32"
                                            Height="32"
                                            Content="&#xF368;"
                                            FontFamily="pack://application:,,,/Resources/#FluentSystemIcons-Regular"
                                            FontSize="16"
                                            Foreground="#AAB4C0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            Focusable="False"
                                            Command="{x:Static local:HotkeyCaptureBox.ClearCommand}"
                                            CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                            ToolTip="{local:Loc ResourceKey=HotkeyCapture_Clear}"
                                            AutomationProperties.Name="{local:Loc ResourceKey=HotkeyCapture_Clear}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="ClearButtonSurface"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ClearButtonSurface" Property="Background" Value="#3A4654"/>
                                                        <Setter Property="Foreground" Value="#F4F7FA"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="ClearButtonSurface" Property="Background" Value="#465567"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="HasAssignedBinding" Value="False">
                                    <Setter TargetName="ClearButton" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Field" Property="BorderBrush" Value="#687788"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                    <Setter TargetName="Field" Property="BorderThickness" Value="2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SettingsNavigationListStyle" TargetType="ListBox">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            </Style>

            <Style x:Key="SettingsNavigationItemStyle" TargetType="ListBoxItem">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="Foreground" Value="{DynamicResource MutedText}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="ItemBorder"
                                    Background="Transparent"
                                    CornerRadius="4"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Border x:Name="SelectionIndicator"
                                            Width="3"
                                            Margin="0,8,0,8"
                                            HorizontalAlignment="Left"
                                            Background="{DynamicResource AccentColor}"
                                            CornerRadius="2"
                                            Visibility="Collapsed"/>
                                    <StackPanel Margin="{TemplateBinding Padding}"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="NavigationIcon"
                                                   Width="22"
                                                   Margin="0,0,8,0"
                                                   Text="{TemplateBinding Tag}"
                                                   FontFamily="pack://application:,,,/Resources/#FluentSystemIcons-Regular"
                                                   FontSize="18"
                                                   FontWeight="Normal"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"
                                                   SnapsToDevicePixels="True"/>
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="Center"
                                                          RecognizesAccessKey="True"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="#2D2D2D"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="#252526"/>
                                    <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsKeyboardFocused" Value="True"/>
                                        <Condition Property="local:KeyboardFocusVisualService.ShowKeyboardFocusCue" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                    <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AboutActionButtonStyle" TargetType="Button">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="#DCE6F2"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="10,9"/>
                <Setter Property="Margin" Value="0,1"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Surface"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="#30363E"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="#39424D"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsKeyboardFocused" Value="True"/>
                                        <Condition Property="local:KeyboardFocusVisualService.ShowKeyboardFocusCue" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Surface" Property="Background" Value="#303E4D"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SettingsTopmostToggleStyle" TargetType="ToggleButton">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Height" Value="44"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="Foreground" Value="{DynamicResource MutedText}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="ToggleSurface" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ToggleSurface" Property="Background" Value="#2D2D2D"/>
                                    <Setter Property="Foreground" Value="#F4F7FA"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ToggleSurface" Property="Background" Value="#383838"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="ToggleSurface" Property="Background" Value="#25384A"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsKeyboardFocused" Value="True"/>
                                        <Condition Property="local:KeyboardFocusVisualService.ShowKeyboardFocusCue" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="ToggleSurface" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                    <Setter TargetName="ToggleSurface" Property="BorderThickness" Value="1"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>



        </ResourceDictionary>

    </Window.Resources>



    <Grid x:Name="SettingsLayoutRoot" Margin="16">

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="255"/>

            <ColumnDefinition Width="24"/>

            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>



        <Border x:Name="SettingsNavigationPanel"
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="0"
                Padding="0"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                CornerRadius="0">

            <ListBox x:Name="SettingsNavigationList"
                     Style="{StaticResource SettingsNavigationListStyle}"
                     SelectionChanged="SettingsNavigationList_SelectionChanged"
                     SelectedIndex="0">

                <ListBoxItem Style="{StaticResource SettingsNavigationItemStyle}"
                             Tag="&#xF587;"
                             ToolTip="{local:Loc ResourceKey=AppSettingsWindow_General}"
                             AutomationProperties.Name="{local:Loc ResourceKey=AppSettingsWindow_General}"
                             Content="{local:Loc ResourceKey=AppSettingsWindow_General}"/>

                <ListBoxItem Style="{StaticResource SettingsNavigationItemStyle}"
                             Tag="&#xE8B0;"
                             ToolTip="{local:Loc ResourceKey=AppSettingsWindow_ContextNames}"
                             AutomationProperties.Name="{local:Loc ResourceKey=AppSettingsWindow_ContextNames}"
                             Content="{local:Loc ResourceKey=AppSettingsWindow_ContextNames}"/>

                <ListBoxItem Style="{StaticResource SettingsNavigationItemStyle}"
                             Tag="&#xF4B8;"
                             ToolTip="{local:Loc ResourceKey=AppSettingsWindow_Hotkeys}"
                             AutomationProperties.Name="{local:Loc ResourceKey=AppSettingsWindow_Hotkeys}"
                             Content="{local:Loc ResourceKey=AppSettingsWindow_Hotkeys}"/>

                <ListBoxItem Style="{StaticResource SettingsNavigationItemStyle}"
                             Tag="&#xF82E;"
                             ToolTip="{local:Loc ResourceKey=AppSettingsWindow_QuickTools}"
                             AutomationProperties.Name="{local:Loc ResourceKey=AppSettingsWindow_QuickTools}"
                             Content="{local:Loc ResourceKey=AppSettingsWindow_QuickTools}"/>

                <ListBoxItem Style="{StaticResource SettingsNavigationItemStyle}"
                             Tag="&#xF15A;"
                             ToolTip="{local:Loc ResourceKey=AiSettings_Title}"
                             AutomationProperties.Name="{local:Loc ResourceKey=AiSettings_Title}"
                             Content="{local:Loc ResourceKey=AiSettings_Title}"/>

                <ListBoxItem Style="{StaticResource SettingsNavigationItemStyle}"
                             Tag="&#xF4A2;"
                             ToolTip="{local:Loc ResourceKey=About_Title}"
                             AutomationProperties.Name="{local:Loc ResourceKey=About_Title}"
                             Content="{local:Loc ResourceKey=About_Title}"/>

            </ListBox>

        </Border>

        <Grid x:Name="SettingsContentHost"
              Grid.Row="0"
              Grid.RowSpan="2"
              Grid.Column="2"
              MaxWidth="1000"
              HorizontalAlignment="Stretch">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <ScrollViewer x:Name="SettingsScrollViewer"
                      Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      ScrollChanged="SettingsScrollViewer_ScrollChanged">

            <StackPanel x:Name="SettingsScrollContent" Margin="0,0,14,0">

                <Border x:Name="GeneralSettingsSection" Style="{StaticResource ModernSectionAnchorStyle}" Margin="0,0,0,32">

                    <StackPanel>

                        <TextBlock Text="{local:Loc ResourceKey=AppSettingsWindow_General}"

                                   Style="{StaticResource ModernSectionTitleStyle}"/>

                        <TextBlock Text="{local:Loc ResourceKey=AppSettingsWindow_GeneralHint}"

                                   Foreground="{StaticResource MutedText}"

                                   FontSize="11"

                                   TextWrapping="Wrap"

                                   Margin="0,0,0,18"/>



                        <Border Style="{StaticResource ModernSettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="250"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="{local:Loc ResourceKey=AppSettingsWindow_Language}" Style="{StaticResource ModernSettingTitleStyle}"/>
                                    <TextBlock Text="{local:Loc ResourceKey=AppSettingsWindow_LanguageHint}" Style="{StaticResource ModernSettingDescriptionStyle}"/>
                                </StackPanel>
                                <ComboBox x:Name="CmbLanguage" Grid.Column="1" Height="36"
                                          SelectionChanged="CmbLanguage_SelectionChanged"/>
                            </Grid>
                        </Border>



                        <Border Style="{StaticResource ModernSettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{local:Loc ResourceKey=AppSettingsWindow_Edge}" Style="{StaticResource ModernSettingTitleStyle}"/>
                                <TextBlock Text="{local:Loc ResourceKey=AppSettingsWindow_EdgeHint}" Style="{StaticResource ModernSettingDescriptionStyle}"/>
