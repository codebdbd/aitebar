                                           Style="{StaticResource ModernSettingDescriptionStyle}"
                                           Margin="0,10,0,2"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border x:Name="AboutSettingsSection" Style="{StaticResource ModernSectionAnchorStyle}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="{local:Loc ResourceKey=About_Title}"
                                   Style="{StaticResource ModernSectionTitleStyle}"/>
                        <TextBlock Text="{local:Loc ResourceKey=About_Description}"
                                   Foreground="{StaticResource MutedText}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,18"/>

                        <Border Style="{StaticResource ModernSettingsCardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Width="48" Height="48"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Top"
                                           Source="pack://application:,,,/Resources/app.ico"/>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                        <TextBlock Text="AiteBar" FontSize="20" FontWeight="SemiBold" Foreground="#F4F7FA"/>
                                        <TextBlock x:Name="TxtAboutVersion" Style="{StaticResource ModernSettingDescriptionStyle}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource ModernDividerStyle}" Margin="0,16,0,14"/>
                                <TextBlock Text="{local:Loc ResourceKey=About_Developer}" Style="{StaticResource ModernSettingDescriptionStyle}"/>
                                <TextBlock Text="© 2026 Codebdbd" Style="{StaticResource ModernSettingDescriptionStyle}" Margin="0,3,0,0"/>
                                <TextBlock Text="{local:Loc ResourceKey=About_License}" Style="{StaticResource ModernSettingDescriptionStyle}" Margin="0,3,0,0"/>
                                <TextBlock Text="{local:Loc ResourceKey=About_TechnologiesValue}" Style="{StaticResource ModernSettingDescriptionStyle}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModernSettingsCardStyle}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="{local:Loc ResourceKey=About_Resources}" Style="{StaticResource ModernSettingTitleStyle}" Margin="10,0,10,8"/>
                                <Button Style="{StaticResource AboutActionButtonStyle}" Click="BtnAboutCheckUpdates_Click">
                                    <Grid><TextBlock Text="{local:Loc ResourceKey=Update_Check}"/><TextBlock Text="&#xF190;" FontFamily="pack://application:,,,/Resources/#FluentSystemIcons-Regular" FontSize="17" HorizontalAlignment="Right"/></Grid>
                                </Button>
                                <Button Style="{StaticResource AboutActionButtonStyle}" Click="BtnAboutWebsite_Click">
                                    <Grid><TextBlock Text="{local:Loc ResourceKey=About_Website}"/><TextBlock Text="&#xF45A;" FontFamily="pack://application:,,,/Resources/#FluentSystemIcons-Regular" FontSize="17" HorizontalAlignment="Right"/></Grid>
                                </Button>
                                <Button Style="{StaticResource AboutActionButtonStyle}" Click="BtnAboutRepository_Click">
                                    <Grid><TextBlock Text="{local:Loc ResourceKey=About_Repository}"/><TextBlock Text="&#xF2EF;" FontFamily="pack://application:,,,/Resources/#FluentSystemIcons-Regular" FontSize="17" HorizontalAlignment="Right"/></Grid>
                                </Button>
                                <Button Style="{StaticResource AboutActionButtonStyle}" Click="BtnAboutLicenses_Click">
                                    <Grid><TextBlock Text="{local:Loc ResourceKey=About_Licenses}"/><TextBlock Text="&#xE557;" FontFamily="pack://application:,,,/Resources/#FluentSystemIcons-Regular" FontSize="17" HorizontalAlignment="Right"/></Grid>
                                </Button>
                                <Button Style="{StaticResource AboutActionButtonStyle}" Click="BtnAboutOpenDataFolder_Click">
                                    <Grid><TextBlock Text="{local:Loc ResourceKey=About_OpenDataFolder}"/><TextBlock Text="&#xF42E;" FontFamily="pack://application:,,,/Resources/#FluentSystemIcons-Regular" FontSize="17" HorizontalAlignment="Right"/></Grid>
                                </Button>
                                <Button Style="{StaticResource AboutActionButtonStyle}" Click="BtnAboutOpenProgramFolder_Click">
                                    <Grid><TextBlock Text="{local:Loc ResourceKey=About_ProgramFolder}"/><TextBlock Text="&#xF42E;" FontFamily="pack://application:,,,/Resources/#FluentSystemIcons-Regular" FontSize="17" HorizontalAlignment="Right"/></Grid>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>

        </ScrollViewer>



        <Grid x:Name="SettingsFooter" Grid.Row="1" Margin="0,12,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ToggleButton x:Name="BtnKeepOnTop"
                          Grid.Column="0"
                          Style="{StaticResource SettingsTopmostToggleStyle}"
                          IsChecked="False"
                          Click="BtnKeepOnTop_Click"
                          ToolTip="{local:Loc ResourceKey=AppSettingsWindow_KeepOnTopHint}"
                          AutomationProperties.Name="{local:Loc ResourceKey=AppSettingsWindow_KeepOnTop}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xF601;" FontFamily="pack://application:,,,/Resources/#FluentSystemIcons-Regular" FontSize="17" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{local:Loc ResourceKey=AppSettingsWindow_KeepOnTop}" VerticalAlignment="Center"/>
                </StackPanel>
            </ToggleButton>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="BtnCancel" Content="{local:Loc ResourceKey=Common_Cancel}" Style="{StaticResource CommandButtonStyle}" Click="BtnCancel_Click" Width="150" Margin="0,0,10,0" IsCancel="True"/>
                <Button x:Name="BtnSave" Content="{local:Loc ResourceKey=Common_Save}" Style="{StaticResource PrimaryCommandButtonStyle}" Click="BtnSave_Click" Width="180" IsDefault="True"/>
            </StackPanel>
        </Grid>

        </Grid>

    </Grid>

</local:DarkWindow>

