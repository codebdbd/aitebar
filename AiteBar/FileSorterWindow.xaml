<local:DarkWindow x:Class="AiteBar.FileSorterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AiteBar"
        Icon="pack://application:,,,/AiteBar;component/Resources/app.ico"
        Title="{local:Loc ResourceKey=FileSorter_Title}"
        Width="520" SizeToContent="Height" MinWidth="520" MinHeight="240"
        WindowStartupLocation="CenterScreen" Background="#191919" Foreground="#DCDCDC"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsWindowResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="ModernCardBackground" Color="#20252D"/>
            <SolidColorBrush x:Key="ModernRowDivider" Color="#303945"/>

            <Style x:Key="ModernSettingsCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource ModernCardBackground}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <Style x:Key="ModernSettingTitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#F4F7FA"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextWrapping" Value="NoWrap"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>

            <Style x:Key="ModernSettingDescriptionStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#9EA9B7"/>
                <Setter Property="FontSize" Value="10.5"/>
                <Setter Property="Margin" Value="0,2,0,0"/>
                <Setter Property="TextWrapping" Value="NoWrap"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>

            <Style x:Key="ModernDividerStyle" TargetType="Border">
                <Setter Property="Height" Value="1"/>
                <Setter Property="Background" Value="{StaticResource ModernRowDivider}"/>
                <Setter Property="Margin" Value="0"/>
            </Style>

            <Style x:Key="ModernSwitchStyle" TargetType="CheckBox">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="22"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Width="40" Height="22" SnapsToDevicePixels="True">
                                <Border x:Name="Track" Background="#46505D" CornerRadius="11"/>
                                <Ellipse x:Name="Thumb" Width="16" Height="16" Margin="3"
                                         HorizontalAlignment="Left" Fill="#F4F7FA"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="#596574"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentColor}"/>
                                    <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="FolderActionButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                <Setter Property="Margin" Value="2,0,0,0"/>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.28"/>
                        <Setter Property="Cursor" Value="Arrow"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="16">
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{local:Loc ResourceKey=FileSorter_LocationLabel}"
                       Style="{StaticResource FieldLabelStyle}"
                       Margin="0"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="TxtSelectionCount"
                       Grid.Column="1"
                       Foreground="{StaticResource MutedText}"
                       FontSize="11"
                       VerticalAlignment="Center"/>
        </Grid>

        <Border Style="{StaticResource ModernSettingsCardStyle}">
            <ScrollViewer x:Name="FolderListScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          MaxHeight="320">
                <StackPanel x:Name="FolderListPanel"/>
            </ScrollViewer>
        </Border>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnAddFolder"
                    Grid.Column="0"
                    Content="{local:Loc ResourceKey=FileSorter_AddFolder}"
                    Style="{StaticResource CommandButtonStyle}"
                    Click="BtnAddFolder_Click"/>

            <Button x:Name="BtnSort"
                    Grid.Column="2"
                    Content="{local:Loc ResourceKey=FileSorter_SortButton}"
                    Style="{StaticResource PrimaryCommandButtonStyle}"
                    Click="BtnSort_Click"/>
        </Grid>

        <TextBlock x:Name="TxtOverallStatus"
                   Text="{local:Loc ResourceKey=FileSorter_StatusReady}"
                   Foreground="{StaticResource MutedText}"
                   FontSize="11"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   MinHeight="18"/>
    </StackPanel>
</local:DarkWindow>
