<local:DarkWindow x:Class="AiteBar.FileSorterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AiteBar"
        Icon="pack://application:,,,/Resources/app.ico"
        Title="{local:Loc ResourceKey=FileSorter_Title}"
        Width="320" SizeToContent="Height" MinWidth="320" MinHeight="200"
        WindowStartupLocation="CenterScreen" Background="#191919" Foreground="#DCDCDC"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsWindowResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Idle state -->
        <StackPanel x:Name="IdleStatePanel">
            <TextBlock Text="{local:Loc ResourceKey=FileSorter_LocationLabel}" Style="{StaticResource FieldLabelStyle}"/>
            <ComboBox x:Name="CmbLocation"
                      Height="{StaticResource FormControlHeight}"
                      SelectionChanged="CmbLocation_SelectionChanged"/>
            <TextBlock x:Name="TxtCustomPath"
                       Visibility="Collapsed"
                       Foreground="{StaticResource MutedText}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="2,8,2,0"/>
            <Button x:Name="BtnSort"
                    Content="{local:Loc ResourceKey=FileSorter_SortButton}"
                    Style="{StaticResource PrimaryCommandButtonStyle}"
                    Margin="0,16,0,0"
                    Click="BtnSort_Click"/>
        </StackPanel>

        <!-- Sorting state -->
        <StackPanel x:Name="SortingStatePanel"
                    Visibility="Collapsed"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
            <Grid Width="34" Height="34" Margin="0,0,0,14">
                <Ellipse Stroke="#1F3B56" StrokeThickness="3"/>
                <Path Stroke="{StaticResource AccentColor}"
                      StrokeThickness="3"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Data="M 17,2 A 15,15 0 0 1 31,17">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotate" Angle="0" CenterX="17" CenterY="17"/>
                    </Path.RenderTransform>
                </Path>
            </Grid>
            <TextBlock Text="{local:Loc ResourceKey=FileSorter_LoadingTitle}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="{local:Loc ResourceKey=FileSorter_LoadingSubtitle}"
                       Foreground="{StaticResource MutedText}"
                       FontSize="12"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Completed state -->
        <StackPanel x:Name="CompletedStatePanel"
                    Visibility="Collapsed"
                    VerticalAlignment="Center">
            <Grid Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,14">
                <Ellipse Fill="#143C27" Stroke="#16A34A" StrokeThickness="1.4"/>
                <TextBlock Text="✓"
                           Foreground="#22C55E"
                           FontSize="28"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
            <TextBlock Text="{local:Loc ResourceKey=FileSorter_CompletedTitle}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="TxtResultSummary"
                       Foreground="{StaticResource MutedText}"
                       FontSize="12"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Center"/>
            <Button x:Name="BtnOpenFolder"
                    Content="{local:Loc ResourceKey=FileSorter_OpenFolder}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,18,0,0"
                    Click="BtnOpenFolder_Click"/>
            <Button x:Name="BtnUndo"
                    Content="{local:Loc ResourceKey=FileSorter_Undo}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,10,0,0"
                    Click="BtnUndo_Click"/>
            <TextBlock x:Name="TxtUndoStatus"
                       Visibility="Collapsed"
                       Foreground="{StaticResource MutedText}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0"
                       TextAlignment="Center"/>
        </StackPanel>
    </Grid>
</local:DarkWindow>
