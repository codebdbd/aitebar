<local:DarkWindow x:Class="AiteBar.DiskCleanerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AiteBar"
        Icon="pack://application:,,,/AiteBar;component/Resources/app.ico"
        Title="{local:Loc ResourceKey=DiskCleaner_Title}"
        Width="540" SizeToContent="Height" MinWidth="540" MinHeight="360"
        WindowStartupLocation="CenterScreen" Background="#191919" Foreground="#DCDCDC"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsWindowResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="ModernCardBackground" Color="#20252D"/>
            <SolidColorBrush x:Key="ModernRowDivider" Color="#303945"/>
            <SolidColorBrush x:Key="BadgeBackground" Color="#2A323D"/>
            <SolidColorBrush x:Key="SafeGreenColor" Color="#4ADE80"/>

            <Style x:Key="ModernSettingsCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource ModernCardBackground}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <Style x:Key="ModernSettingTitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#F4F7FA"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextWrapping" Value="NoWrap"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>

            <Style x:Key="ModernSettingDescriptionStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#9EA9B7"/>
                <Setter Property="FontSize" Value="10.5"/>
                <Setter Property="Margin" Value="0,2,0,0"/>
                <Setter Property="TextWrapping" Value="NoWrap"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>

            <Style x:Key="ModernDividerStyle" TargetType="Border">
                <Setter Property="Height" Value="1"/>
                <Setter Property="Background" Value="{StaticResource ModernRowDivider}"/>
                <Setter Property="Margin" Value="0"/>
            </Style>

            <Style x:Key="ModernSwitchStyle" TargetType="CheckBox">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Width" Value="36"/>
                <Setter Property="Height" Value="20"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Width="36" Height="20" SnapsToDevicePixels="True">
                                <Border x:Name="Track" Background="#46505D" CornerRadius="10"/>
                                <Ellipse x:Name="Thumb" Width="14" Height="14" Margin="3"
                                         HorizontalAlignment="Left" Fill="#F4F7FA"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="#596574"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentColor}"/>
                                    <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SizeBadgeStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource BadgeBackground}"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="6,2"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="8,0,10,0"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="16">
        <!-- Header -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{local:Loc ResourceKey=DiskCleaner_Title}"
                           FontSize="15" FontWeight="Bold" Foreground="#F4F7FA"/>
                <TextBlock Text="{local:Loc ResourceKey=DiskCleaner_Subtitle}"
                           FontSize="11" Foreground="#9EA9B7" Margin="0,2,0,0"/>
            </StackPanel>
            <TextBlock x:Name="TxtTotalFound"
                       Grid.Column="1"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource SafeGreenColor}"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- Categories List Card -->
        <Border Style="{StaticResource ModernSettingsCardStyle}">
            <ScrollViewer x:Name="CategoriesScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          MaxHeight="330">
                <StackPanel x:Name="CategoriesPanel"/>
            </ScrollViewer>
        </Border>

        <!-- Selection & Scan Quick Actions -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnSelectAll"
                    Grid.Column="0"
                    Content="{local:Loc ResourceKey=DiskCleaner_SelectAll}"
                    Style="{StaticResource CommandButtonStyle}"
                    Click="BtnSelectAll_Click"
                    Padding="10,4"/>

            <Button x:Name="BtnDeselectAll"
                    Grid.Column="2"
                    Content="{local:Loc ResourceKey=DiskCleaner_DeselectAll}"
                    Style="{StaticResource CommandButtonStyle}"
                    Click="BtnDeselectAll_Click"
                    Padding="10,4"/>

            <Button x:Name="BtnScan"
                    Grid.Column="4"
                    Content="{local:Loc ResourceKey=DiskCleaner_Scan}"
                    Style="{StaticResource CommandButtonStyle}"
                    Click="BtnScan_Click"
                    Padding="12,4"/>
        </Grid>

        <!-- Progress Bar (Visible during clean/scan) -->
        <ProgressBar x:Name="ProgressBarStatus"
                     Height="4"
                     Margin="0,0,0,10"
                     Maximum="100"
                     Value="0"
                     Visibility="Collapsed"
                     Foreground="{DynamicResource AccentColor}"
                     Background="#252B35"
                     BorderThickness="0"/>

        <!-- Main Action Button -->
        <Button x:Name="BtnClean"
                Content="{local:Loc ResourceKey=DiskCleaner_Clean}"
                Style="{StaticResource PrimaryCommandButtonStyle}"
                Click="BtnClean_Click"
                Height="36"/>

        <!-- Status Footer -->
        <TextBlock x:Name="TxtOverallStatus"
                   Text="{local:Loc ResourceKey=DiskCleaner_Status_Ready}"
                   Foreground="{StaticResource MutedText}"
                   FontSize="11"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"
                   MinHeight="18"/>
    </StackPanel>
</local:DarkWindow>
