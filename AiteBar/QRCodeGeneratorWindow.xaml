<local:DarkWindow x:Class="AiteBar.QRCodeGeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AiteBar"
        Icon="pack://application:,,,/Resources/app.ico"
        Title="{local:Loc ResourceKey=QRCodeGenerator_Title}"
        Width="540" Height="540" MinWidth="500" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="#1A1A1C" Foreground="#DCDCDC"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsWindowResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{local:Loc ResourceKey=QRCodeGenerator_InputLabel}"
                       Style="{StaticResource FieldLabelStyle}"
                       Margin="0,0,0,6"/>
            <Grid>
                <TextBox x:Name="TxtInput"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Disabled"
                         MaxLength="4296"
                         Style="{StaticResource BaseTextBoxStyle}"
                         TextChanged="TxtInput_TextChanged"/>
                <TextBlock x:Name="TxtInputPlaceholder"
                           Text="{local:Loc ResourceKey=QRCodeGenerator_InputPlaceholder}"
                           Foreground="{StaticResource MutedText}"
                           FontSize="12"
                           Margin="8,0"
                           IsHitTestVisible="False"
                           VerticalAlignment="Center"/>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{local:Loc ResourceKey=QRCodeGenerator_EccLevel}"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,0,0,5"/>
                <ComboBox x:Name="CmbEccLevel"
                          SelectionChanged="Options_Changed"
                          SelectedIndex="2">
                    <ComboBoxItem Content="{local:Loc ResourceKey=QRCodeGenerator_EccLevelL}" Tag="L"/>
                    <ComboBoxItem Content="{local:Loc ResourceKey=QRCodeGenerator_EccLevelM}" Tag="M"/>
                    <ComboBoxItem Content="{local:Loc ResourceKey=QRCodeGenerator_EccLevelQ}" Tag="Q"/>
                    <ComboBoxItem Content="{local:Loc ResourceKey=QRCodeGenerator_EccLevelH}" Tag="H"/>
                </ComboBox>
            </StackPanel>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="32"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{local:Loc ResourceKey=QRCodeGenerator_PixelSize}"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtPixelSize"
                               Grid.Column="1"
                               Text="20"
                               Foreground="#D8DEE6"
                               FontSize="11"
                               MinWidth="24"
                               TextAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
                <Slider x:Name="SldPixelSize"
                        Grid.Row="1"
                        Minimum="4"
                        Maximum="32"
                        Value="20"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        ValueChanged="Options_Changed"/>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Margin="0,10,0,0"
                Background="#101318"
                BorderBrush="#273344"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14">
            <Grid>
                <Border x:Name="PreviewSurface"
                        Width="240"
                        Height="240"
                        Background="White"
                        CornerRadius="4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Image x:Name="ImgPreview"
                           Width="224"
                           Height="224"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TxtEmptyHint"
                           Text="{local:Loc ResourceKey=QRCodeGenerator_EmptyHint}"
                           Foreground="{StaticResource MutedText}"
                           FontSize="12"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="TxtStatus"
                       Foreground="{StaticResource MutedText}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Top"
                       Margin="0,0,0,10"/>
            <UniformGrid Grid.Row="1" Columns="3" HorizontalAlignment="Stretch">
                <Button x:Name="BtnCopyPng"
                        Content="{local:Loc ResourceKey=QRCodeGenerator_CopyPng}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsEnabled="False"
                        Margin="0,0,8,0"
                        Click="BtnCopyPng_Click"/>
                <Button x:Name="BtnSavePng"
                        Content="{local:Loc ResourceKey=QRCodeGenerator_SavePng}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsEnabled="False"
                        Margin="0,0,8,0"
                        Click="BtnSavePng_Click"/>
                <Button x:Name="BtnSaveSvg"
                        Content="{local:Loc ResourceKey=QRCodeGenerator_SaveSvg}"
                        Style="{StaticResource ActionButtonStyle}"
                        IsEnabled="False"
                        Click="BtnSaveSvg_Click"/>
            </UniformGrid>
        </Grid>
    </Grid>
</local:DarkWindow>