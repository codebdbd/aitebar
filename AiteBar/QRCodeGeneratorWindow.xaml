<local:DarkWindow x:Class="AiteBar.QRCodeGeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AiteBar"
        Icon="pack://application:,,,/AiteBar;component/Resources/app.ico"
        Width="540" Height="520" MinWidth="500" MinHeight="480"
        WindowStartupLocation="Manual" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="White" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="PrimaryCommandButtonStyle" TargetType="Button" BasedOn="{StaticResource UtilityPrimaryCommandButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource FormControlMutedForegroundBrush}"/>
                    <Setter Property="Background" Value="{StaticResource FormControlBackground}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource FormControlBorderBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Margin="8" CornerRadius="8" Background="{StaticResource BorderColor}" BorderBrush="#332A9CFF" BorderThickness="0.7">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.45"/>
            </Border.Effect>

            <Border CornerRadius="7" Background="{StaticResource PanelBackground}">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="76"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{local:Loc ResourceKey=QRCodeGenerator_Title}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="&#xF369;"
                                Style="{StaticResource HeaderButtonStyle}"
                                ToolTip="{local:Loc ResourceKey=Common_Close}"
                                Click="BtnClose_Click"/>
                    </Grid>

                    <Border Grid.Row="1"
                            Margin="0,12,0,0"
                            Background="#151922"
                            BorderBrush="#273344"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{local:Loc ResourceKey=QRCodeGenerator_InputLabel}"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Margin="0,0,0,6"/>
                            <Grid Grid.Row="1">
                                <TextBox x:Name="TxtInput"
                                         TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Disabled"
                                         MaxLength="4296"
                                         Style="{StaticResource BaseTextBoxStyle}"
                                         TextChanged="TxtInput_TextChanged"/>
                                <TextBlock x:Name="TxtInputPlaceholder"
                                           Text="{local:Loc ResourceKey=QRCodeGenerator_InputPlaceholder}"
                                           Foreground="{StaticResource MutedText}"
                                           FontSize="12"
                                           Margin="8,0"
                                           IsHitTestVisible="False"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{local:Loc ResourceKey=QRCodeGenerator_EccLevel}"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Margin="0,0,0,5"/>
                            <ComboBox x:Name="CmbEccLevel"
                                      SelectionChanged="Options_Changed"
                                      SelectedIndex="2">
                                <ComboBoxItem Content="{local:Loc ResourceKey=QRCodeGenerator_EccLevelL}" Tag="L"/>
                                <ComboBoxItem Content="{local:Loc ResourceKey=QRCodeGenerator_EccLevelM}" Tag="M"/>
                                <ComboBoxItem Content="{local:Loc ResourceKey=QRCodeGenerator_EccLevelQ}" Tag="Q"/>
                                <ComboBoxItem Content="{local:Loc ResourceKey=QRCodeGenerator_EccLevelH}" Tag="H"/>
                            </ComboBox>
                        </StackPanel>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="32"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{local:Loc ResourceKey=QRCodeGenerator_PixelSize}"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Margin="0,0,8,0"/>
                                <TextBlock x:Name="TxtPixelSize"
                                           Grid.Column="1"
                                           Text="20"
                                           Foreground="#D8DEE6"
                                           FontSize="11"
                                           MinWidth="24"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <Slider x:Name="SldPixelSize"
                                    Grid.Row="1"
                                    Minimum="4"
                                    Maximum="32"
                                    Value="20"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="Options_Changed"/>
                        </Grid>
                    </Grid>

                    <Border Grid.Row="3"
                            Margin="0,10,0,0"
                            Background="#101318"
                            BorderBrush="#273344"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14">
                        <Grid>
                            <Border x:Name="PreviewSurface"
                                    Width="240"
                                    Height="240"
                                    Background="White"
                                    CornerRadius="4"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Image x:Name="ImgPreview"
                                       Width="224"
                                       Height="224"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="TxtEmptyHint"
                                       Text="{local:Loc ResourceKey=QRCodeGenerator_EmptyHint}"
                                       Foreground="{StaticResource MutedText}"
                                       FontSize="12"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="4" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="40"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="TxtStatus"
                                   Foreground="{StaticResource MutedText}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Top"/>
                        <UniformGrid Grid.Row="1" Columns="3" HorizontalAlignment="Stretch">
                            <Button x:Name="BtnCopyPng"
                                    Content="{local:Loc ResourceKey=QRCodeGenerator_CopyPng}"
                                    Style="{StaticResource CommandButtonStyle}"
                                    IsEnabled="False"
                                    Margin="0,0,8,0"
                                    Click="BtnCopyPng_Click"/>
                            <Button x:Name="BtnSavePng"
                                    Content="{local:Loc ResourceKey=QRCodeGenerator_SavePng}"
                                    Style="{StaticResource CommandButtonStyle}"
                                    IsEnabled="False"
                                    Margin="0,0,8,0"
                                    Click="BtnSavePng_Click"/>
                            <Button x:Name="BtnSaveSvg"
                                    Content="{local:Loc ResourceKey=QRCodeGenerator_SaveSvg}"
                                    Style="{StaticResource PrimaryCommandButtonStyle}"
                                    IsEnabled="False"
                                    Click="BtnSaveSvg_Click"/>
                        </UniformGrid>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</local:DarkWindow>
