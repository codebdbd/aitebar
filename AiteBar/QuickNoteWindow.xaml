<local:DarkWindow x:Class="AiteBar.QuickNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AiteBar"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Icon="pack://application:,,,/Resources/app.ico"
        Width="580" Height="430" MinWidth="460" MinHeight="320"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="White" ResizeMode="CanResize"
        ShowInTaskbar="False" Topmost="True"
        Loaded="Window_Loaded" Closing="Window_Closing" Deactivated="Window_Deactivated"
        LocationChanged="Window_LocationChanged" SizeChanged="Window_SizeChanged">

    <Window.Resources>
        <SolidColorBrush x:Key="QuickNoteHoverBrush" Color="#303238"/>
        <SolidColorBrush x:Key="QuickNoteHoverForegroundBrush" Color="#F4F4F6"/>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="FontFamily" Value="pack://application:,,,/Resources/#FluentSystemIcons-Regular"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="#AFAFB7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource QuickNoteHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource QuickNoteHoverForegroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerIconButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FF7272"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="FontFamily" Value="pack://application:,,,/Resources/#FluentSystemIcons-Regular"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="#AFAFB7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource QuickNoteHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource QuickNoteHoverForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource QuickNoteHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource QuickNoteHoverForegroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormatButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="FontFamily" Value="pack://application:,,,/Resources/#FluentSystemIcons-Regular"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource QuickNoteHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource QuickNoteHoverForegroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuickNoteScrollBarStyle"
               TargetType="ScrollBar"
               BasedOn="{StaticResource DarkScrollBarStyle}"/>

        <Style x:Key="QuickNoteEditorStyle" TargetType="RichTextBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RichTextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Background="Transparent"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Margin="8" CornerRadius="14" Background="#383838" BorderBrush="#3A3B40" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.14"/>
            </Border.Effect>

            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="34"/>
            </Grid.RowDefinitions>

            <Border x:Name="HeaderBar" Grid.Row="0" BorderThickness="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="24,6,18,0" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="&#xF16F;" Style="{StaticResource FormatButtonStyle}" ToolTip="{local:Loc ResourceKey=QuickNote_Undo}" Click="BtnUndo_Click"/>
                        <Button Content="&#xF19A;" Style="{StaticResource FormatButtonStyle}" ToolTip="{local:Loc ResourceKey=QuickNote_Redo}" Click="BtnRedo_Click"/>
                        <Rectangle Width="1" Height="18" Fill="#30FFFFFF" Margin="2,0,7,0"/>
                        <Button Content="B" FontWeight="Bold" FontFamily="Segoe UI" FontSize="13" Style="{StaticResource FormatButtonStyle}" ToolTip="{local:Loc ResourceKey=QuickNote_Bold}" Click="BtnBold_Click"/>
                        <Button Content="I" FontStyle="Italic" FontFamily="Segoe UI" FontSize="13" Style="{StaticResource FormatButtonStyle}" ToolTip="{local:Loc ResourceKey=QuickNote_Italic}" Click="BtnItalic_Click"/>
                        <Button FontFamily="Segoe UI" FontSize="13" Style="{StaticResource FormatButtonStyle}" ToolTip="{local:Loc ResourceKey=QuickNote_Underline}" Click="BtnUnderline_Click">
                            <TextBlock Text="U" TextDecorations="Underline"/>
                        </Button>
                        <Button Content="&lt;/&gt;" FontFamily="Consolas" FontSize="13" Style="{StaticResource FormatButtonStyle}" ToolTip="{local:Loc ResourceKey=QuickNote_Code}" Click="BtnCode_Click"/>
                        <Rectangle x:Name="FormatSeparator1" Width="0" Height="18" Fill="#30FFFFFF" Margin="0" Visibility="Collapsed"/>
                        <Button Content="&#xECDA;" Style="{StaticResource FormatButtonStyle}" ToolTip="{local:Loc ResourceKey=QuickNote_BulletList}" Click="BtnBullet_Click"/>
                        <Button Content="&#xF7FA;" Style="{StaticResource FormatButtonStyle}" ToolTip="{local:Loc ResourceKey=QuickNote_NumberedList}" Click="BtnNumbered_Click"/>
                        <Rectangle x:Name="FormatSeparator2" Width="0" Height="18" Fill="#30FFFFFF" Margin="0" Visibility="Collapsed"/>
                        <Button Content="&#xF7BD;" Style="{StaticResource FormatButtonStyle}" ToolTip="{local:Loc ResourceKey=QuickNote_ClearFormatting}" Click="BtnClearFormatting_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton x:Name="BtnPin"
                          Content="&#xF602;"
                          Style="{StaticResource IconToggleButtonStyle}"
                          ToolTip="{local:Loc ResourceKey=QuickNote_Pin}"
                          Checked="BtnPin_Checked"
                          Unchecked="BtnPin_Checked"/>
                        <Button Content="⋯" FontFamily="Segoe UI" FontSize="22" Style="{StaticResource IconButtonStyle}" ToolTip="{local:Loc ResourceKey=QuickNote_Menu}" Click="BtnMenu_Click">
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource DarkContextMenu}">
                                    <MenuItem Header="{local:Loc ResourceKey=QuickNote_Theme}" Click="BtnTheme_Click">
                                        <MenuItem.Icon>
                                            <TextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xF2F5;"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{local:Loc ResourceKey=QuickNote_OpenFile}" Click="BtnOpenFile_Click">
                                        <MenuItem.Icon>
                                            <TextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xF42E;"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem x:Name="MenuOpenConflictCopy" Header="{local:Loc ResourceKey=QuickNote_OpenConflictCopy}" Click="BtnOpenConflictCopy_Click" IsEnabled="False">
                                        <MenuItem.Icon>
                                            <TextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xE7BA;"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{local:Loc ResourceKey=QuickNote_Clear}" Click="BtnClear_Click">
                                        <MenuItem.Icon>
                                            <TextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xF201;"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Content="&#xF36A;" Style="{StaticResource IconButtonStyle}" ToolTip="{local:Loc ResourceKey=Common_Close}" Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="24,2,24,0" CornerRadius="0" Background="Transparent" BorderThickness="0">
                <Grid>
                    <RichTextBox x:Name="TxtNote"
                                 Style="{StaticResource QuickNoteEditorStyle}"
                                 FocusVisualStyle="{x:Null}"
                                 Margin="0"
                                 Background="Transparent"
                                 Foreground="#F6F0E6"
                                 BorderBrush="Transparent"
                                 BorderThickness="0"
                                 AcceptsTab="True"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Segoe UI"
                                 FontWeight="Normal"
                                 FontStyle="Normal"
                                 FontSize="14"
                                 Padding="0,14,0,14"
                                 CaretBrush="#70B7FF"
                                 TextChanged="TxtNote_TextChanged"
                                 PreviewKeyDown="TxtNote_PreviewKeyDown"
                                 PreviewMouseLeftButtonDown="TxtNote_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="TxtNote_PreviewMouseMove">
                        <RichTextBox.Resources>
                            <Style TargetType="Paragraph">
                                 <Setter Property="Margin" Value="0"/>
                                 <Setter Property="LineHeight" Value="20"/>
                             </Style>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource QuickNoteScrollBarStyle}"/>
                        </RichTextBox.Resources>
                        <RichTextBox.ContextMenu>
                            <ContextMenu Style="{StaticResource DarkContextMenu}">
                                <MenuItem Header="{local:Loc ResourceKey=QuickNote_Undo}" Click="BtnUndo_Click" InputGestureText="Ctrl+Z">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="↶" FontFamily="Segoe UI"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{local:Loc ResourceKey=QuickNote_Redo}" Click="BtnRedo_Click" InputGestureText="Ctrl+Y">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="↷" FontFamily="Segoe UI"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="{local:Loc ResourceKey=QuickNote_Cut}" Command="ApplicationCommands.Cut" InputGestureText="Ctrl+X">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xE14E;" FontFamily="pack://application:,,,/Resources/#Material Icons"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{local:Loc ResourceKey=QuickNote_Copy}" Command="ApplicationCommands.Copy" InputGestureText="Ctrl+C">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xF381;"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{local:Loc ResourceKey=QuickNote_Paste}" Command="ApplicationCommands.Paste" InputGestureText="Ctrl+V">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xE14F;" FontFamily="pack://application:,,,/Resources/#Material Icons"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{local:Loc ResourceKey=QuickNote_SelectAll}" Command="ApplicationCommands.SelectAll" InputGestureText="Ctrl+A">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xE162;" FontFamily="pack://application:,,,/Resources/#Material Icons"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </RichTextBox.ContextMenu>
                    </RichTextBox>
                    <TextBlock x:Name="TxtPlaceholder"
                               Text="{local:Loc ResourceKey=QuickNote_Placeholder}"
                               Foreground="#7B7B80"
                               FontSize="14"
                               Margin="0,14,0,0"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <Border x:Name="FooterBar" Grid.Row="2" BorderThickness="0">
                <Grid Margin="24,0,24,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtSaveStatus" Text="{local:Loc ResourceKey=QuickNote_SavedInitial}"
                               Foreground="#74757A" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtStats" Grid.Column="2" Foreground="#74757A" FontSize="11" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            </Grid>
        </Border>

        <Popup x:Name="ThemePopup" Placement="MousePoint" AllowsTransparency="True" StaysOpen="False">
            <Border x:Name="ThemePopupBorder" CornerRadius="14" Background="#F8F8F8" BorderBrush="#DDDDDD" BorderThickness="1" Padding="14">
                <UniformGrid x:Name="ThemePalette" Columns="6"/>
            </Border>
        </Popup>

        <Rectangle Height="8" VerticalAlignment="Top" Fill="Transparent" Cursor="SizeNS" Tag="Top" MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"/>
        <Rectangle Height="8" VerticalAlignment="Bottom" Fill="Transparent" Cursor="SizeNS" Tag="Bottom" MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"/>
        <Rectangle Width="8" HorizontalAlignment="Left" Fill="Transparent" Cursor="SizeWE" Tag="Left" MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"/>
        <Rectangle Width="8" HorizontalAlignment="Right" Fill="Transparent" Cursor="SizeWE" Tag="Right" MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"/>
        <Rectangle Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="Transparent" Cursor="SizeNWSE" Tag="TopLeft" MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"/>
        <Rectangle Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="Transparent" Cursor="SizeNESW" Tag="TopRight" MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"/>
        <Rectangle Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="Transparent" Cursor="SizeNESW" Tag="BottomLeft" MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"/>
        <Rectangle Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="Transparent" Cursor="SizeNWSE" Tag="BottomRight" MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"/>
    </Grid>
</local:DarkWindow>
