<local:DarkWindow x:Class="AiteBar.QuickNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AiteBar"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="{local:Loc ResourceKey=QuickNote_Title}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Icon="pack://application:,,,/AiteBar;component/Resources/app.ico"
        Width="580" Height="430" MinWidth="460" MinHeight="320"
        WindowStartupLocation="CenterOwner" WindowStyle="SingleBorderWindow" AllowsTransparency="False"
        Background="Transparent" Foreground="White" ResizeMode="CanResize"
        WindowClass="OverlayWidget"
        ShowInTaskbar="True" Topmost="False"
        Loaded="Window_Loaded" Closing="Window_Closing"
        LocationChanged="Window_LocationChanged" SizeChanged="Window_SizeChanged">

    <WindowChrome.WindowChrome>
        <!-- Side grips extend inward beyond adjacent windows' invisible frames. Top 8 + caption 28 preserve the header. -->
        <!-- A nonzero DWM frame prevents WindowChrome from installing a region that disables native rounded corners. -->
        <WindowChrome ResizeBorderThickness="12,8,12,8" CaptionHeight="28" GlassFrameThickness="1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="QuickNoteHoverBrush" Color="#303238"/>
        <SolidColorBrush x:Key="QuickNoteHoverForegroundBrush" Color="#F4F4F6"/>
        <SolidColorBrush x:Key="QuickNoteFocusBrush" Color="#4EA6FF"/>
        <Style x:Key="QuickNoteIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="FontFamily" Value="pack://application:,,,/AiteBar;component/Resources/#FluentSystemIcons-Regular"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="{DynamicResource QuickNoteChromeTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource QuickNoteHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource QuickNoteHoverForegroundBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsKeyboardFocused" Value="True"/>
                                    <Condition Property="local:KeyboardFocusVisualService.ShowKeyboardFocusCue" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource QuickNoteFocusBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                            </MultiTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource QuickNoteHoverBrush}"/>
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormatButtonStyle" TargetType="Button" BasedOn="{StaticResource QuickNoteIconButtonStyle}">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style x:Key="QuickNoteScrollThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Border x:Name="Indicator" Width="2" HorizontalAlignment="Right" Margin="0,0,1,0"
                                    CornerRadius="1" Background="#8C8D92" Opacity="0.88"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Indicator" Property="Width" Value="4"/>
                                <Setter TargetName="Indicator" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Indicator" Property="Width" Value="4"/>
                                <Setter TargetName="Indicator" Property="Opacity" Value="1"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="Horizontal">
                                <Setter TargetName="Indicator" Property="Width" Value="Auto"/>
                                <Setter TargetName="Indicator" Property="Height" Value="2"/>
                                <Setter TargetName="Indicator" Property="HorizontalAlignment" Value="Stretch"/>
                                <Setter TargetName="Indicator" Property="VerticalAlignment" Value="Bottom"/>
                                <Setter TargetName="Indicator" Property="Margin" Value="0,0,0,1"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuickNoteScrollBarStyle"
               TargetType="ScrollBar"
               BasedOn="{StaticResource DarkScrollBarStyle}">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="PageDecrease" Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource QuickNoteScrollThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton x:Name="PageIncrease" Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                                <Setter TargetName="PageDecrease" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/>
                                <Setter TargetName="PageIncrease" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="6"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="QuickNoteEditorStyle" TargetType="RichTextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RichTextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Background="Transparent"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Margin="0" CornerRadius="0" Background="#383838" BorderBrush="#3A3B40" BorderThickness="1">

            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="HeaderBar" Grid.Row="0" BorderThickness="0" Background="Transparent">
                <Grid Margin="6,2" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ToggleButton x:Name="BtnPin"
                                  WindowChrome.IsHitTestVisibleInChrome="True"
                                  HorizontalAlignment="Left"
                                  Style="{StaticResource WindowPinToggleButtonStyle}" Foreground="{DynamicResource QuickNoteChromeTextBrush}"
                                  FontFamily="pack://application:,,,/AiteBar;component/Resources/#FluentSystemIcons-Regular"
                                  ToolTip="{local:Loc ResourceKey=QuickNote_Pin}"
                                  AutomationProperties.Name="{local:Loc ResourceKey=QuickNote_Pin}"
                                  IsChecked="{Binding IsPinned, RelativeSource={RelativeSource AncestorType=local:DarkWindow}, Mode=TwoWay}"
                                  Checked="BtnPin_Checked"
                                  Unchecked="BtnPin_Checked"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Content="&#xF199;" Style="{StaticResource QuickNoteIconButtonStyle}" Command="ApplicationCommands.Undo" CommandTarget="{Binding ElementName=TxtNote}" ToolTip="{local:Loc ResourceKey=QuickNote_Undo}" AutomationProperties.Name="{local:Loc ResourceKey=QuickNote_Undo}"/>
                        <Button Content="&#xF16E;" Style="{StaticResource QuickNoteIconButtonStyle}" Command="ApplicationCommands.Redo" CommandTarget="{Binding ElementName=TxtNote}" ToolTip="{local:Loc ResourceKey=QuickNote_Redo}" AutomationProperties.Name="{local:Loc ResourceKey=QuickNote_Redo}"/>
                        <Button Content="&#xF2F5;" Style="{StaticResource QuickNoteIconButtonStyle}" Click="BtnTheme_Click" ToolTip="{local:Loc ResourceKey=QuickNote_Theme}" AutomationProperties.Name="{local:Loc ResourceKey=QuickNote_Theme}"/>
                        <Button Style="{StaticResource WindowCloseButtonStyle}" Foreground="{DynamicResource QuickNoteChromeTextBrush}" FontFamily="pack://application:,,,/AiteBar;component/Resources/#FluentSystemIcons-Regular" ToolTip="{local:Loc ResourceKey=Common_Close}" AutomationProperties.Name="{local:Loc ResourceKey=Common_Close}" Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>


            <Border Grid.Row="1" Margin="8,2,0,0" CornerRadius="0" Background="Transparent" BorderThickness="0">
                <Grid>
                    <RichTextBox x:Name="TxtNote"
                                 AutomationProperties.Name="{local:Loc ResourceKey=QuickNote_Title}"
                                 Style="{StaticResource QuickNoteEditorStyle}"
                                 Margin="0"
                                 Background="Transparent"
                                 Foreground="#F6F0E6"
                                 BorderBrush="Transparent"
                                 BorderThickness="0"
                                 AcceptsTab="True"
                                 IsDocumentEnabled="True"
                                 IsInactiveSelectionHighlightEnabled="True"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Segoe UI"
                                 FontWeight="Normal"
                                 FontStyle="Normal"
                                 FontSize="14"
                                 Padding="0,4,0,4"
                                 CaretBrush="#70B7FF"
                                 TextChanged="TxtNote_TextChanged"
                                 SelectionChanged="TxtNote_SelectionChanged"
                                 PreviewKeyDown="TxtNote_PreviewKeyDown"
                                 PreviewMouseDown="TxtNote_PreviewMouseDown"
                                 PreviewMouseMove="TxtNote_PreviewMouseMove"
                                 AllowDrop="True"
                                 DragOver="TxtNote_DragOver"
                                 Drop="TxtNote_Drop">
                        <RichTextBox.ContextMenu>
                            <ContextMenu Style="{StaticResource DarkContextMenu}"
                                         TextBlock.LineHeight="NaN"
                                         TextBlock.LineStackingStrategy="MaxHeight">
                                <MenuItem Header="{local:Loc ResourceKey=QuickNote_Undo}" Command="ApplicationCommands.Undo" InputGestureText="Ctrl+Z">
                                    <MenuItem.Icon>
                                        <local:CenteredGlyphTextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xF199;"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{local:Loc ResourceKey=QuickNote_Redo}" Command="ApplicationCommands.Redo" InputGestureText="Ctrl+Y">
                                    <MenuItem.Icon>
                                        <local:CenteredGlyphTextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xF16E;"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator Style="{StaticResource DarkMenuSeparator}"/>
                                <MenuItem Header="{local:Loc ResourceKey=QuickNote_Cut}" Command="ApplicationCommands.Cut" InputGestureText="Ctrl+X">
                                    <MenuItem.Icon>
                                        <local:CenteredGlyphTextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xF33A;"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{local:Loc ResourceKey=QuickNote_Copy}" Command="ApplicationCommands.Copy" InputGestureText="Ctrl+C">
                                    <MenuItem.Icon>
                                        <local:CenteredGlyphTextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xF381;"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                 <MenuItem Header="{local:Loc ResourceKey=QuickNote_Paste}" Command="ApplicationCommands.Paste" InputGestureText="Ctrl+V">
                                     <MenuItem.Icon>
                                         <local:CenteredGlyphTextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xF2D5;"/>
                                     </MenuItem.Icon>
                                 </MenuItem>
                                 <MenuItem Header="{local:Loc ResourceKey=Common_Delete}" Command="ApplicationCommands.Delete" InputGestureText="Del">
                                     <MenuItem.Icon>
                                         <local:CenteredGlyphTextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xF34C;"/>
                                     </MenuItem.Icon>
                                 </MenuItem>
                                 <MenuItem Header="{local:Loc ResourceKey=QuickNote_SelectAll}" Command="ApplicationCommands.SelectAll" InputGestureText="Ctrl+A">
                                    <MenuItem.Icon>
                                        <local:CenteredGlyphTextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xEA86;"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator Style="{StaticResource DarkMenuSeparator}"/>
                                <MenuItem Header="{local:Loc ResourceKey=QuickNote_Theme}" Click="BtnTheme_Click">
                                    <MenuItem.Icon>
                                        <local:CenteredGlyphTextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xF2F5;"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{local:Loc ResourceKey=QuickNote_Clear}" Click="BtnClear_Click">
                                    <MenuItem.Icon>
                                        <local:CenteredGlyphTextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xF201;"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </RichTextBox.ContextMenu>
                        <RichTextBox.Resources>
                            <Style TargetType="Paragraph">
                                 <Setter Property="Margin" Value="0"/>
                                 <Setter Property="LineHeight" Value="20"/>
                             </Style>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource QuickNoteScrollBarStyle}"/>
                        </RichTextBox.Resources>
                        
                    </RichTextBox>
                </Grid>
            </Border>

            <Border Grid.Row="2" BorderThickness="0" Background="Transparent">
                <StackPanel x:Name="FormattingToolbar" Orientation="Horizontal" Margin="8,0,4,0" VerticalAlignment="Center" KeyboardNavigation.TabNavigation="Continue" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="A-" FontFamily="Segoe UI" FontSize="14" Style="{StaticResource FormatButtonStyle}" ToolTip="{local:Loc ResourceKey=QuickNote_DecreaseFont}" AutomationProperties.Name="{local:Loc ResourceKey=QuickNote_DecreaseFont}" PreviewMouseDown="FormatButton_PreviewMouseDown" Click="BtnDecreaseFontSize_Click"/>
                    <Button Content="A+" FontFamily="Segoe UI" FontSize="14" Style="{StaticResource FormatButtonStyle}" ToolTip="{local:Loc ResourceKey=QuickNote_IncreaseFont}" AutomationProperties.Name="{local:Loc ResourceKey=QuickNote_IncreaseFont}" PreviewMouseDown="FormatButton_PreviewMouseDown" Click="BtnIncreaseFontSize_Click"/>
                    <Button Content="&#xF0291;" FontFamily="pack://application:,,,/AiteBar;component/Resources/#FluentSystemIcons-Regular" Style="{StaticResource FormatButtonStyle}" ToolTip="{local:Loc ResourceKey=QuickNote_BulletList}" AutomationProperties.Name="{local:Loc ResourceKey=QuickNote_BulletList}" PreviewMouseDown="FormatButton_PreviewMouseDown" Click="BtnBullet_Click"/>
                    <Button Content="&#xF7FA;" Style="{StaticResource FormatButtonStyle}" ToolTip="{local:Loc ResourceKey=QuickNote_NumberedList}" AutomationProperties.Name="{local:Loc ResourceKey=QuickNote_NumberedList}" PreviewMouseDown="FormatButton_PreviewMouseDown" Click="BtnNumbered_Click"/>
                    <Button Content="&#xF2A0;" Style="{StaticResource FormatButtonStyle}" ToolTip="{local:Loc ResourceKey=QuickNote_TaskList}" AutomationProperties.Name="{local:Loc ResourceKey=QuickNote_TaskList}" PreviewMouseDown="FormatButton_PreviewMouseDown" Click="BtnTaskList_Click"/>
                    <Button Content="&#xF7A5;" Style="{StaticResource FormatButtonStyle}" ToolTip="{local:Loc ResourceKey=QuickNote_Bold}" AutomationProperties.Name="{local:Loc ResourceKey=QuickNote_Bold}" PreviewMouseDown="FormatButton_PreviewMouseDown" Click="BtnBold_Click"/>
                    <Button Content="&#xF7F4;" Style="{StaticResource FormatButtonStyle}" ToolTip="{local:Loc ResourceKey=QuickNote_Italic}" AutomationProperties.Name="{local:Loc ResourceKey=QuickNote_Italic}" PreviewMouseDown="FormatButton_PreviewMouseDown" Click="BtnItalic_Click"/>
                    <Button Content="&#xED60;" Style="{StaticResource FormatButtonStyle}" ToolTip="{local:Loc ResourceKey=QuickNote_Strikethrough}" AutomationProperties.Name="{local:Loc ResourceKey=QuickNote_Strikethrough}" PreviewMouseDown="FormatButton_PreviewMouseDown" Click="BtnStrikethrough_Click"/>
                    <Button Content="&#xF4E5;" Style="{StaticResource FormatButtonStyle}" ToolTip="{local:Loc ResourceKey=QuickNote_InsertLink}" AutomationProperties.Name="{local:Loc ResourceKey=QuickNote_InsertLink}" PreviewMouseDown="FormatButton_PreviewMouseDown" Click="BtnInsertLink_Click"/>
                    <Button Content="&#xF48C;" Style="{StaticResource FormatButtonStyle}" ToolTip="{local:Loc ResourceKey=QuickNote_InsertImage}" AutomationProperties.Name="{local:Loc ResourceKey=QuickNote_InsertImage}" PreviewMouseDown="FormatButton_PreviewMouseDown" Click="BtnInsertImage_Click"/>
                    <Button Content="&#xF80A;" Style="{StaticResource FormatButtonStyle}" ToolTip="{local:Loc ResourceKey=QuickNote_Underline}" AutomationProperties.Name="{local:Loc ResourceKey=QuickNote_Underline}" PreviewMouseDown="FormatButton_PreviewMouseDown" Click="BtnUnderline_Click"/>
                    <Button Content="&#xF2EF;" Style="{StaticResource FormatButtonStyle}" ToolTip="{local:Loc ResourceKey=QuickNote_Code}" AutomationProperties.Name="{local:Loc ResourceKey=QuickNote_Code}" PreviewMouseDown="FormatButton_PreviewMouseDown" Click="BtnCode_Click"/>
                    <Button Content="&#xF800;" Style="{StaticResource FormatButtonStyle}" ToolTip="{local:Loc ResourceKey=QuickNote_Quote}" AutomationProperties.Name="{local:Loc ResourceKey=QuickNote_Quote}" PreviewMouseDown="FormatButton_PreviewMouseDown" Click="BtnQuote_Click"/>
                    <Button Content="&#xEBD0;" Style="{StaticResource FormatButtonStyle}" ToolTip="{local:Loc ResourceKey=QuickNote_Divider}" AutomationProperties.Name="{local:Loc ResourceKey=QuickNote_Divider}" PreviewMouseDown="FormatButton_PreviewMouseDown" Click="BtnDivider_Click"/>
                    <Button x:Name="BtnClearFormatting" Content="&#xE5E4;" Style="{StaticResource FormatButtonStyle}" ToolTip="{local:Loc ResourceKey=QuickNote_ClearFormatting}" AutomationProperties.Name="{local:Loc ResourceKey=QuickNote_ClearFormatting}" PreviewMouseDown="FormatButton_PreviewMouseDown" Click="BtnClearFormatting_Click">
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource DarkContextMenu}">
                                <MenuItem Header="{local:Loc ResourceKey=QuickNote_ClearFormatting_InlineOnly}" Click="BtnClearFormattingInlineOnly_Click">
                                    <MenuItem.Icon>
                                        <local:CenteredGlyphTextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xE5E4;"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{local:Loc ResourceKey=QuickNote_ClearFormatting_PreserveLinks}" Click="BtnClearFormattingPreserveLinks_Click">
                                    <MenuItem.Icon>
                                        <local:CenteredGlyphTextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xF4E5;"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{local:Loc ResourceKey=QuickNote_ClearFormatting_All}" Click="BtnClearFormattingAll_Click">
                                    <MenuItem.Icon>
                                        <local:CenteredGlyphTextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xF201;"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Border>

            <Border x:Name="FooterBar" Grid.Row="3" BorderThickness="0">
                <Grid Margin="12,2,12,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtSaveStatus" Text="{local:Loc ResourceKey=QuickNote_SavedInitial}"
                               Foreground="#74757A" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.LiveSetting="Polite"/>
                    <Button x:Name="BtnRecoveryCopy" Grid.Column="1" Content="&#xF409;" Width="20" Height="16" FontSize="14" Visibility="Collapsed" Style="{StaticResource QuickNoteIconButtonStyle}" Click="BtnRecoveryCopy_Click" ToolTip="{local:Loc ResourceKey=QuickNote_ShowRecoveryCopy}" AutomationProperties.Name="{local:Loc ResourceKey=QuickNote_ShowRecoveryCopy}"/>
                    <TextBlock x:Name="TxtStats" Grid.Column="2" Foreground="#74757A" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>
            </Border>
            </Grid>
        </Border>

        <Popup x:Name="ThemePopup" Placement="MousePoint" AllowsTransparency="True" StaysOpen="False">
            <Border x:Name="ThemePopupBorder" CornerRadius="8" Background="#F8F8F8" BorderBrush="#DDDDDD" BorderThickness="0" Padding="0">
                <UniformGrid x:Name="ThemePalette" Columns="7"/>
            </Border>
        </Popup>

    </Grid>
</local:DarkWindow>
