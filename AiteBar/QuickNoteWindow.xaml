<local:DarkWindow x:Class="AiteBar.QuickNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AiteBar"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Icon="pack://application:,,,/AiteBar;component/Resources/app.ico"
        Width="580" Height="430" MinWidth="460" MinHeight="320"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="White" ResizeMode="CanResize"
        WindowClass="OverlayWidget"
        ShowInTaskbar="False" Topmost="True"
        Loaded="Window_Loaded" Closing="Window_Closing"
        LocationChanged="Window_LocationChanged" SizeChanged="Window_SizeChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome ResizeBorderThickness="6" CaptionHeight="0" GlassFrameThickness="0" CornerRadius="14"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="QuickNoteHoverBrush" Color="#303238"/>
        <SolidColorBrush x:Key="QuickNoteHoverForegroundBrush" Color="#F4F4F6"/>
        <Style x:Key="QuickNoteIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="FontFamily" Value="pack://application:,,,/Resources/#FluentSystemIcons-Regular"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="#AFAFB7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource QuickNoteHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource QuickNoteHoverForegroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerIconButtonStyle" TargetType="Button" BasedOn="{StaticResource QuickNoteIconButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FF7272"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="FontFamily" Value="pack://application:,,,/Resources/#FluentSystemIcons-Regular"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="#AFAFB7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource QuickNoteHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource QuickNoteHoverForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource QuickNoteHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource QuickNoteHoverForegroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormatButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="#AFAFB7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="pack://application:,,,/Resources/#FluentSystemIcons-Regular"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource QuickNoteHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource QuickNoteHoverForegroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormatComboStyle" TargetType="ComboBox">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="{StaticResource FormControlHeight}"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#AFAFB7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <Border x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="8"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                    </Grid.ColumnDefinitions>

                                    <ToggleButton x:Name="PART_DropDownToggle"
                                                  Grid.ColumnSpan="2"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"
                                                  ClickMode="Press"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>

                                    <TextBlock Text="{TemplateBinding Tag}"
                                               FontFamily="pack://application:,,,/Resources/#FluentSystemIcons-Regular"
                                               FontSize="18"
                                               Foreground="{TemplateBinding Foreground}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"/>

                                    <Path x:Name="Arrow"
                                          Grid.Column="1"
                                          Width="6"
                                          Height="4"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Fill="{TemplateBinding Foreground}"
                                          Data="M 0 0 L 3 4 L 6 0 Z"
                                          IsHitTestVisible="False"/>
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border x:Name="DropDownBorder"
                                        MinWidth="188"
                                        MaxHeight="300"
                                        Background="{StaticResource FormControlBackground}"
                                        BorderBrush="{StaticResource FormControlBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer Margin="3"
                                                  CanContentScroll="True"
                                                  SnapsToDevicePixels="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource QuickNoteHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource QuickNoteHoverForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource QuickNoteHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource QuickNoteHoverForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="40"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#777777"/>
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuickNoteScrollBarStyle"
               TargetType="ScrollBar"
               BasedOn="{StaticResource DarkScrollBarStyle}"/>

        <Style x:Key="QuickNoteEditorStyle" TargetType="RichTextBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RichTextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Background="Transparent"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Margin="8" CornerRadius="14" Background="#383838" BorderBrush="#3A3B40" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.14"/>
            </Border.Effect>

            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="36"/>
            </Grid.RowDefinitions>

            <Border x:Name="HeaderBar" Grid.Row="0" BorderThickness="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="24,6,18,0" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="{StaticResource FormControlHeight}">
                        <Button Content="A−" Style="{StaticResource FormatButtonStyle}" ToolTip="Decrease font size" PreviewMouseDown="FormatButton_PreviewMouseDown" Click="BtnDecreaseFontSize_Click"/>
                        <Button Content="A+" Style="{StaticResource FormatButtonStyle}" ToolTip="Increase font size" PreviewMouseDown="FormatButton_PreviewMouseDown" Click="BtnIncreaseFontSize_Click"/>
                        <Button Content="&#xE8FD;" Style="{StaticResource FormatButtonStyle}" ToolTip="{local:Loc ResourceKey=QuickNote_BulletList}" PreviewMouseDown="FormatButton_PreviewMouseDown" Click="BtnBullet_Click"/>
                        <Button Content="&#xE8D0;" Style="{StaticResource FormatButtonStyle}" ToolTip="{local:Loc ResourceKey=QuickNote_NumberedList}" PreviewMouseDown="FormatButton_PreviewMouseDown" Click="BtnNumbered_Click"/>
                        <Rectangle x:Name="FormatSeparator1" Width="1" Height="18" Fill="#30FFFFFF" Margin="2,0,7,0"/>
                        <Button Content="&#xF7A5;" Style="{StaticResource FormatButtonStyle}" ToolTip="{local:Loc ResourceKey=QuickNote_Bold}" PreviewMouseDown="FormatButton_PreviewMouseDown" Click="BtnBold_Click"/>
                        <Button Content="&#xF7F4;" Style="{StaticResource FormatButtonStyle}" ToolTip="{local:Loc ResourceKey=QuickNote_Italic}" PreviewMouseDown="FormatButton_PreviewMouseDown" Click="BtnItalic_Click"/>
                        <Button Content="&#xED60;" Style="{StaticResource FormatButtonStyle}" ToolTip="{local:Loc ResourceKey=QuickNote_Strikethrough}" PreviewMouseDown="FormatButton_PreviewMouseDown" Click="BtnStrikethrough_Click"/>
                        <Button Content="&#xF4E5;" Style="{StaticResource FormatButtonStyle}" ToolTip="{local:Loc ResourceKey=QuickNote_InsertLink}" PreviewMouseDown="FormatButton_PreviewMouseDown" Click="BtnInsertLink_Click"/>
                        <Rectangle x:Name="FormatSeparator2" Width="1" Height="18" Fill="#30FFFFFF" Margin="2,0,7,0"/>
                        <Button Content="&#xF80A;" Style="{StaticResource FormatButtonStyle}" ToolTip="{local:Loc ResourceKey=QuickNote_Underline}" PreviewMouseDown="FormatButton_PreviewMouseDown" Click="BtnUnderline_Click"/>
                        <Button Content="&#xF2EF;" Style="{StaticResource FormatButtonStyle}" ToolTip="{local:Loc ResourceKey=QuickNote_Code}" PreviewMouseDown="FormatButton_PreviewMouseDown" Click="BtnCode_Click"/>
                        <Rectangle x:Name="FormatSeparator3" Width="1" Height="18" Fill="#30FFFFFF" Margin="2,0,7,0"/>
                        <Button Content="&#xF7BD;" Style="{StaticResource FormatButtonStyle}" ToolTip="{local:Loc ResourceKey=QuickNote_ClearFormatting}" PreviewMouseDown="FormatButton_PreviewMouseDown" Click="BtnClearFormatting_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton x:Name="BtnPin"
                                      Style="{StaticResource WindowPinToggleButtonStyle}"
                                      ToolTip="{local:Loc ResourceKey=QuickNote_Pin}"
                                      IsChecked="{Binding IsPinned, RelativeSource={RelativeSource AncestorType=local:DarkWindow}, Mode=TwoWay}"
                                      Checked="BtnPin_Checked"
                                      Unchecked="BtnPin_Checked"/>
                        <Button Content="⋯" FontFamily="Segoe UI" FontSize="22" Style="{StaticResource QuickNoteIconButtonStyle}" ToolTip="{local:Loc ResourceKey=QuickNote_Menu}" Click="BtnMenu_Click">
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource DarkContextMenu}">
                                    <MenuItem Header="{local:Loc ResourceKey=QuickNote_Theme}" Click="BtnTheme_Click">
                                        <MenuItem.Icon>
                                            <local:CenteredGlyphTextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xF2F5;"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{local:Loc ResourceKey=QuickNote_OpenFile}" Click="BtnOpenFile_Click">
                                        <MenuItem.Icon>
                                            <local:CenteredGlyphTextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xF42E;"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem x:Name="MenuOpenConflictCopy" Header="{local:Loc ResourceKey=QuickNote_OpenConflictCopy}" Click="BtnOpenConflictCopy_Click" IsEnabled="False">
                                        <MenuItem.Icon>
                                            <local:CenteredGlyphTextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xE7BA;"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{local:Loc ResourceKey=QuickNote_Clear}" Click="BtnClear_Click">
                                        <MenuItem.Icon>
                                            <local:CenteredGlyphTextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xF201;"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Style="{StaticResource WindowCloseButtonStyle}" ToolTip="{local:Loc ResourceKey=Common_Close}" Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="24,2,24,0" CornerRadius="0" Background="Transparent" BorderThickness="0">
                <Grid>
                    <RichTextBox x:Name="TxtNote"
                                 Style="{StaticResource QuickNoteEditorStyle}"
                                 ContextMenu="{DynamicResource TextEditingContextMenu}"
                                 FocusVisualStyle="{x:Null}"
                                 Margin="0"
                                 Background="Transparent"
                                 Foreground="#F6F0E6"
                                 BorderBrush="Transparent"
                                 BorderThickness="0"
                                 AcceptsTab="True"
                                 IsDocumentEnabled="True"
                                 IsInactiveSelectionHighlightEnabled="True"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Segoe UI"
                                 FontWeight="Normal"
                                 FontStyle="Normal"
                                 FontSize="14"
                                 Padding="0,14,0,14"
                                 CaretBrush="#70B7FF"
                                 TextChanged="TxtNote_TextChanged"
                                 SelectionChanged="TxtNote_SelectionChanged"
                                 PreviewKeyDown="TxtNote_PreviewKeyDown"
                                 PreviewMouseLeftButtonDown="TxtNote_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="TxtNote_PreviewMouseMove">
                        <RichTextBox.Resources>
                            <Style TargetType="Paragraph">
                                 <Setter Property="Margin" Value="0"/>
                                 <Setter Property="LineHeight" Value="20"/>
                             </Style>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource QuickNoteScrollBarStyle}"/>
                        </RichTextBox.Resources>
                        
                    </RichTextBox>
                    <TextBlock x:Name="TxtPlaceholder"
                               Text="{local:Loc ResourceKey=QuickNote_Placeholder}"
                               Foreground="#7B7B80"
                               FontSize="14"
                               Margin="0,14,0,0"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <Border x:Name="FooterBar" Grid.Row="2" BorderThickness="0">
                <Grid Margin="24,0,24,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtSaveStatus" Text="{local:Loc ResourceKey=QuickNote_SavedInitial}"
                               Foreground="#74757A" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtStats" Grid.Column="2" Foreground="#74757A" FontSize="11" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            </Grid>
        </Border>

        <Popup x:Name="ThemePopup" Placement="MousePoint" AllowsTransparency="True" StaysOpen="False">
            <Border x:Name="ThemePopupBorder" CornerRadius="14" Background="#F8F8F8" BorderBrush="#DDDDDD" BorderThickness="1" Padding="14">
                <UniformGrid x:Name="ThemePalette" Columns="6"/>
            </Border>
        </Popup>

        <Rectangle Height="8" VerticalAlignment="Top" Fill="Transparent" Cursor="SizeNS" Tag="Top" MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"/>
        <Rectangle Height="8" VerticalAlignment="Bottom" Fill="Transparent" Cursor="SizeNS" Tag="Bottom" MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"/>
        <Rectangle Width="8" HorizontalAlignment="Left" Fill="Transparent" Cursor="SizeWE" Tag="Left" MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"/>
        <Rectangle Width="8" HorizontalAlignment="Right" Fill="Transparent" Cursor="SizeWE" Tag="Right" MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"/>
        <Rectangle Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="Transparent" Cursor="SizeNWSE" Tag="TopLeft" MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"/>
        <Rectangle Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="Transparent" Cursor="SizeNESW" Tag="TopRight" MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"/>
        <Rectangle Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="Transparent" Cursor="SizeNESW" Tag="BottomLeft" MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"/>
        <Rectangle Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="Transparent" Cursor="SizeNWSE" Tag="BottomRight" MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"/>
    </Grid>
</local:DarkWindow>
