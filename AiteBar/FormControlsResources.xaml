<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:local="clr-namespace:AiteBar">
    <sys:Double x:Key="FormControlHeight">36</sys:Double>
    <Thickness x:Key="FormInputPlaceholderMargin">8,0,0,0</Thickness>

    <SolidColorBrush x:Key="FormControlBackground" Color="#383838"/>
    <SolidColorBrush x:Key="FormControlBackgroundHover" Color="#404040"/>
    <SolidColorBrush x:Key="FormInputBackground" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="FormInputBackgroundHover" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="FormControlBorderBrush" Color="#3A3A3E"/>
    <SolidColorBrush x:Key="FormControlBorderHoverBrush" Color="#4A4A4E"/>
    <SolidColorBrush x:Key="FormControlFocusBorderBrush" Color="#3ABEFF"/>
    <SolidColorBrush x:Key="FormControlForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FormControlMutedForegroundBrush" Color="#BFC3C8"/>
    <SolidColorBrush x:Key="FormControlDisabledForegroundBrush" Color="#777777"/>
    <SolidColorBrush x:Key="FormControlErrorBorderBrush" Color="#E85A5A"/>
    <SolidColorBrush x:Key="PlaceholderForegroundBrush" Color="#666666"/>

    <!-- ============================================ -->
    <!-- BUTTON STYLES - UNIFIED FOR ALL WINDOWS      -->
    <!-- ============================================ -->

    <!-- Primary Command Button - Accent color, main action -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="15,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Border x:Name="Outline"
                                Background="{TemplateBinding BorderBrush}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True"/>
                        <Border x:Name="Fill"
                                Margin="1"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocused" Value="True"/>
                                <Condition Property="local:KeyboardFocusVisualService.ShowKeyboardFocusCue" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Outline" Property="Background" Value="{StaticResource FormControlFocusBorderBrush}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#1C97EA"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#005A9E"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#333335"/>
                <Setter Property="Foreground" Value="#666666"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Secondary Command Button - Neutral color, secondary actions -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Background" Value="{StaticResource FormControlBackground}"/>
        <Setter Property="Foreground" Value="#E8EDF2"/>
        <Setter Property="BorderBrush" Value="{StaticResource FormControlBorderBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource FormControlBackgroundHover}"/>
                <Setter Property="BorderBrush" Value="{StaticResource FormControlBorderHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#232326"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FormSelectionButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Height" Value="{StaticResource FormControlHeight}"/>
    </Style>

    <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}"/>

    <!-- Icon Button - Small square button with icon only -->
    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="FontFamily" Value="pack://application:,,,/Resources/#FluentSystemIcons-Regular"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Foreground" Value="#AEB6C1"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Border x:Name="Outline"
                                Background="{TemplateBinding BorderBrush}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True"/>
                        <Border x:Name="Fill"
                                Margin="1"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="#25FFFFFF"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocused" Value="True"/>
                                <Condition Property="local:KeyboardFocusVisualService.ShowKeyboardFocusCue" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Outline" Property="Background" Value="{StaticResource FormControlFocusBorderBrush}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toolbar/Format Button - For quick note toolbar and similar -->
    <Style x:Key="ToolbarButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="32"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Margin" Value="0,0,5,0"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Foreground" Value="#AFAFB7"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#303238"/>
                            <Setter Property="Foreground" Value="#F4F4F6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Default button style (implicit) - uses SecondaryButtonStyle -->
    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"/>

    <Style x:Key="BaseTextBoxStyle" TargetType="TextBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="{StaticResource FormInputBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource FormControlForegroundBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource FormControlBorderBrush}"/>
        <Setter Property="Height" Value="{StaticResource FormControlHeight}"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Border x:Name="Outline"
                                Background="{TemplateBinding BorderBrush}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True"/>
                        <Border x:Name="Chrome"
                                Margin="1"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="0"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource FormInputBackgroundHover}"/>
                            <Setter TargetName="Outline" Property="Background" Value="{StaticResource FormControlBorderHoverBrush}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocused" Value="True"/>
                                <Condition Property="local:KeyboardFocusVisualService.ShowKeyboardFocusCue" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Outline" Property="Background" Value="{StaticResource FormControlFocusBorderBrush}"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource FormControlDisabledForegroundBrush}"/>
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource BaseTextBoxStyle}"/>

    <Style x:Key="BasePasswordBoxStyle" TargetType="PasswordBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="{StaticResource FormInputBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource FormControlForegroundBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource FormControlBorderBrush}"/>
        <Setter Property="Height" Value="{StaticResource FormControlHeight}"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <Style TargetType="PasswordBox" BasedOn="{StaticResource BasePasswordBoxStyle}"/>

    <Style x:Key="BaseComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource FormControlForegroundBrush}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource FormControlBackgroundHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#3A3A3E"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource FormControlDisabledForegroundBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource BaseComboBoxItemStyle}"/>

    <Style x:Key="BaseComboBoxStyle" TargetType="ComboBox">
        <Setter Property="local:ComboBoxPopupChrome.IsEnabled" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="{StaticResource FormControlBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource FormControlForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource FormControlBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="{StaticResource FormControlHeight}"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Outline"
                                Background="{TemplateBinding BorderBrush}"
                                CornerRadius="4"/>
                        <Border x:Name="Chrome"
                                Margin="1"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>

                                <ToggleButton x:Name="PART_DropDownToggle"
                                              Grid.ColumnSpan="2"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Focusable="False"
                                              ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <local:MarqueeTextBlock x:Name="ContentSite"
                                                        Margin="{TemplateBinding Padding}"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Stretch"
                                                        IsHitTestVisible="False"
                                                        Text="{TemplateBinding SelectionBoxItem}"
                                                        Foreground="{TemplateBinding Foreground}"
                                                        FontFamily="{TemplateBinding FontFamily}"
                                                        FontSize="{TemplateBinding FontSize}"
                                                        FontStyle="{TemplateBinding FontStyle}"
                                                        FontWeight="{TemplateBinding FontWeight}"
                                                        FontStretch="{TemplateBinding FontStretch}"/>

                                <Path x:Name="Arrow"
                                      Grid.Column="1"
                                      Width="8"
                                      Height="5"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Fill="{StaticResource FormControlMutedForegroundBrush}"
                                      Data="M 0 0 L 4 5 L 8 0 Z"
                                      IsHitTestVisible="False"/>
                            </Grid>
                        </Border>

                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade"
                               VerticalOffset="0">
                            <Border x:Name="DropDownBorder"
                                    Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="300"
                                    Background="{StaticResource FormControlBackground}"
                                    BorderBrush="{Binding Background, ElementName=Outline}"
                                    BorderThickness="1,0,1,1"
                                    CornerRadius="0,0,4,4"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer Margin="3"
                                              CanContentScroll="False"
                                              SnapsToDevicePixels="True">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource FormControlBackgroundHover}"/>
                            <Setter TargetName="Outline" Property="Background" Value="{StaticResource FormControlBorderHoverBrush}"/>
                            <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource FormControlForegroundBrush}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocused" Value="True"/>
                                <Condition Property="local:KeyboardFocusVisualService.ShowKeyboardFocusCue" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Outline" Property="Background" Value="{StaticResource FormControlFocusBorderBrush}"/>
                            <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource FormControlForegroundBrush}"/>
                        </MultiTrigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource FormControlBackgroundHover}"/>
                            <Setter TargetName="Outline" Property="Background" Value="{StaticResource FormControlBorderHoverBrush}"/>
                            <Setter TargetName="Outline" Property="CornerRadius" Value="4,4,0,0"/>
                            <Setter TargetName="Chrome" Property="Margin" Value="1,1,1,0"/>
                            <Setter TargetName="Chrome" Property="CornerRadius" Value="3,3,0,0"/>
                            <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource FormControlForegroundBrush}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsDropDownOpen" Value="True"/>
                                <Condition Property="local:ComboBoxPopupChrome.OpensAbove" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Outline" Property="CornerRadius" Value="0,0,4,4"/>
                            <Setter TargetName="Chrome" Property="Margin" Value="1,0,1,1"/>
                            <Setter TargetName="Chrome" Property="CornerRadius" Value="0,0,3,3"/>
                            <Setter TargetName="DropDownBorder" Property="BorderThickness" Value="1,1,1,0"/>
                            <Setter TargetName="DropDownBorder" Property="CornerRadius" Value="4,4,0,0"/>
                        </MultiTrigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="DropDownBorder" Property="MinHeight" Value="40"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource FormControlDisabledForegroundBrush}"/>
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox" BasedOn="{StaticResource BaseComboBoxStyle}"/>

    <Style x:Key="BaseCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{StaticResource FormControlForegroundBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="8,0,0,0"/>
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <DockPanel LastChildFill="True">
                        <Border x:Name="FocusFrame"
                                Width="20"
                                Height="20"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="1"
                                VerticalAlignment="Center">
                            <Grid Width="16" Height="16" SnapsToDevicePixels="True">
                                <Border x:Name="BoxOutline"
                                        Background="{StaticResource FormControlBorderBrush}"
                                        CornerRadius="3"/>
                                <Border x:Name="Box"
                                        Margin="1"
                                        Background="{StaticResource FormControlBackground}"
                                        CornerRadius="2">
                                    <Path x:Name="CheckMark"
                                          Data="M 3 7 L 6 10 L 13 3"
                                          Stroke="White"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Visibility="Collapsed"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource FormControlBackgroundHover}"/>
                            <Setter TargetName="BoxOutline" Property="Background" Value="{StaticResource FormControlBorderHoverBrush}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocused" Value="True"/>
                                <Condition Property="local:KeyboardFocusVisualService.ShowKeyboardFocusCue" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="FocusFrame" Property="BorderBrush" Value="{StaticResource FormControlFocusBorderBrush}"/>
                        </MultiTrigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentColor}"/>
                            <Setter TargetName="BoxOutline" Property="Background" Value="{DynamicResource AccentColor}"/>
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource FormControlDisabledForegroundBrush}"/>
                            <Setter TargetName="Box" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox" BasedOn="{StaticResource BaseCheckBoxStyle}"/>

    <Style x:Key="InlineCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource BaseCheckBoxStyle}">
        <Setter Property="Margin" Value="0,0,12,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="DenseCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource BaseCheckBoxStyle}">
        <Setter Property="Margin" Value="0,2,0,2"/>
    </Style>

    <Style x:Key="CompactCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource BaseCheckBoxStyle}">
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style x:Key="CenteredCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource BaseCheckBoxStyle}">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SelectionListCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource BaseCheckBoxStyle}">
        <Setter Property="Margin" Value="8,5,8,5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- ============================================ -->
    <!-- SLIDER STYLE - UNIFIED FOR ALL WINDOWS       -->
    <!-- ============================================ -->

    <Style x:Key="BaseSliderStyle" TargetType="Slider">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="32" SnapsToDevicePixels="True">
                        <Border x:Name="SliderFocusRing"
                                Height="14"
                                Margin="7,0"
                                Background="Transparent"
                                BorderBrush="{DynamicResource AccentColor}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Opacity="0"
                                VerticalAlignment="Center"/>
                        <Border x:Name="SliderTrackBackground"
                                Height="6"
                                Margin="13,0"
                                Background="#3B4654"
                                CornerRadius="3"
                                VerticalAlignment="Center"/>
                        <ProgressBar x:Name="SliderActiveTrack"
                                     Height="6"
                                     Margin="13,0"
                                     Minimum="{TemplateBinding Minimum}"
                                     Maximum="{TemplateBinding Maximum}"
                                     Value="{TemplateBinding Value}"
                                     Background="Transparent"
                                     Foreground="{DynamicResource AccentColor}"
                                     IsHitTestVisible="False"
                                     VerticalAlignment="Center">
                            <ProgressBar.Template>
                                <ControlTemplate TargetType="ProgressBar">
                                    <Grid x:Name="PART_Track">
                                        <Border x:Name="PART_Indicator"
                                                Background="{TemplateBinding Foreground}"
                                                CornerRadius="3"
                                                HorizontalAlignment="Left"/>
                                    </Grid>
                                </ControlTemplate>
                            </ProgressBar.Template>
                        </ProgressBar>
                        <Grid Margin="13,0" IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="SliderTick1" Grid.Column="0" Width="4" Height="4" Fill="#AAB4C0"/>
                            <Ellipse x:Name="SliderTick2" Grid.Column="2" Width="4" Height="4" Fill="#AAB4C0"/>
                            <Ellipse x:Name="SliderTick3" Grid.Column="4" Width="4" Height="4" Fill="#AAB4C0"/>
                            <Ellipse x:Name="SliderTick4" Grid.Column="6" Width="4" Height="4" Fill="#AAB4C0"/>
                        </Grid>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                              Background="Transparent"
                                              Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="6"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="3"
                                                    VerticalAlignment="Center"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                              Background="Transparent"
                                              Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="6"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="3"
                                                    VerticalAlignment="Center"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="26" Height="26" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Width="26" Height="26">
                                                <Ellipse x:Name="SliderThumbHalo"
                                                         Fill="{DynamicResource AccentColor}"
                                                         Opacity="0"/>
                                                <Ellipse x:Name="SliderThumbCore"
                                                         Width="18"
                                                         Height="18"
                                                         Fill="{DynamicResource AccentColor}"
                                                         Stroke="#F4F7FA"
                                                         StrokeThickness="2"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="SliderThumbHalo" Property="Opacity" Value="0.22"/>
                                                    <Setter TargetName="SliderThumbCore" Property="Width" Value="20"/>
                                                    <Setter TargetName="SliderThumbCore" Property="Height" Value="20"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="SliderThumbHalo" Property="Opacity" Value="0.38"/>
                                                    <Setter TargetName="SliderThumbCore" Property="Width" Value="20"/>
                                                    <Setter TargetName="SliderThumbCore" Property="Height" Value="20"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.55"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocused" Value="True"/>
                                <Condition Property="local:KeyboardFocusVisualService.ShowKeyboardFocusCue" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="SliderFocusRing" Property="Opacity" Value="0.7"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider" BasedOn="{StaticResource BaseSliderStyle}"/>
</ResourceDictionary>
