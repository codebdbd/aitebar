<local:DarkWindow x:Class="AiteBar.AiteProfilesUtility.AiteProfilesWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:AiteBar"
                  xmlns:ap="clr-namespace:AiteBar.AiteProfilesUtility"
                  Icon="pack://application:,,,/AiteBar;component/Resources/app.ico"
                  Title="{local:Loc ResourceKey=AiteProfiles_Title}"
                  Width="720" Height="420" MinWidth="720" MinHeight="420" MaxWidth="720" MaxHeight="420"
                  WindowStartupLocation="Manual"
                  Background="Transparent" Foreground="#DCDCDC"
                  WindowStyle="None"
                  ResizeMode="NoResize"
                  ShowInTaskbar="False"
                  Topmost="True"
                  Deactivated="Window_Deactivated"
                  PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AiteBar;component/SettingsWindowResources.xaml"/>
                <ResourceDictionary Source="/AiteBar;component/FormControlsResources.xaml"/>
                <ResourceDictionary Source="/AiteBar;component/UtilityWindowResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="AiteProfilesTabButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="Height" Value="34"/>
                <Setter Property="MinWidth" Value="92"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
            </Style>

            <Style x:Key="AiteProfilesIconButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                <Setter Property="Width" Value="34"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                <Setter Property="FontSize" Value="14"/>
            </Style>

            <Style x:Key="AiteProfilesToggleButtonStyle" TargetType="ToggleButton">
                <Setter Property="Width" Value="36"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Foreground" Value="#D7DEE7"/>
                <Setter Property="Background" Value="#2B2B2D"/>
                <Setter Property="BorderBrush" Value="#3A3A3D"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="Background" Value="#16324A"/>
                        <Setter Property="BorderBrush" Value="#007ACC"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="#5A6472"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="AiteProfilesComboBoxStyle" TargetType="ComboBox">
                <Setter Property="Height" Value="36"/>
                <Setter Property="Foreground" Value="#E8EDF2"/>
                <Setter Property="Background" Value="#252526"/>
                <Setter Property="BorderBrush" Value="#3A3A3D"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,0"/>
            </Style>

            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#202023"/>
                <Setter Property="Foreground" Value="#AEB4BA"/>
                <Setter Property="BorderBrush" Value="#303034"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <Style TargetType="DataGridRow">
                <Setter Property="Background" Value="#1A1A1C"/>
                <Setter Property="Foreground" Value="#E8EDF2"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#20242B"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#233247"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="#0C0C0D"
            BorderBrush="#27272A"
            BorderThickness="1"
            CornerRadius="12"
            Padding="12">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource AiteProfilesTabButtonStyle}"
                        Content="{local:Loc ResourceKey=AiteProfiles_AllTab}"
                        Command="{Binding SetAllTabCommand}"/>
                <Button Style="{StaticResource AiteProfilesTabButtonStyle}"
                        Content="{local:Loc ResourceKey=AiteProfiles_FavoritesTab}"
                        Command="{Binding SetFavoritesTabCommand}"/>
                <Button Style="{StaticResource AiteProfilesTabButtonStyle}"
                        Content="{local:Loc ResourceKey=AiteProfiles_FarmTab}"
                        Command="{Binding SetFarmTabCommand}"/>
            </StackPanel>
            <TextBox x:Name="SearchBox"
                     Grid.Column="1"
                     Height="34"
                     Margin="8,0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{local:Loc ResourceKey=AiteProfiles_SearchPlaceholder}"/>
            <Button Grid.Column="2"
                    Height="34"
                    MinWidth="96"
                    Content="{local:Loc ResourceKey=AiteProfiles_Scan}"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"/>
        </Grid>

        <Border Grid.Row="1"
                Background="#151517"
                BorderBrush="#27272A"
                BorderThickness="1"
                CornerRadius="8">
            <DataGrid x:Name="ProfilesGrid"
                      ItemsSource="{Binding Profiles}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserResizeRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#303034"
                      Background="#1A1A1C"
                      BorderThickness="0"
                      RowHeight="68"
                      HorizontalScrollBarVisibility="Disabled"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      SelectionChanged="ProfilesGrid_SelectionChanged"
                      MouseDoubleClick="ProfilesGrid_MouseDoubleClick"
                      PreviewMouseRightButtonDown="ProfilesGrid_PreviewMouseRightButtonDown"
                      Sorting="ProfilesGrid_Sorting">
                <DataGrid.ContextMenu>
                    <ContextMenu Opened="ContextMenu_Opened" Closed="ContextMenu_Closed">
                        <MenuItem Header="{local:Loc ResourceKey=AiteProfiles_Open}" Command="{Binding OpenProfileCommand}">
                            <MenuItem.Icon>
                                <local:CenteredGlyphTextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xF5B0;"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{local:Loc ResourceKey=AiteProfiles_OpenSelected}" Command="{Binding OpenSelectedProfilesCommand}">
                            <MenuItem.Icon>
                                <local:CenteredGlyphTextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xE972;"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{local:Loc ResourceKey=AiteProfiles_OpenIncognito}" Command="{Binding OpenIncognitoCommand}">
                            <MenuItem.Icon>
                                <local:CenteredGlyphTextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xF51B;"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="{local:Loc ResourceKey=AiteProfiles_EditTags}" Command="{Binding EditTagsCommand}">
                            <MenuItem.Icon>
                                <local:CenteredGlyphTextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xE70F;"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{local:Loc ResourceKey=AiteProfiles_ToggleFavorite}" Command="{Binding ToggleFavoriteCommand}">
                            <MenuItem.Icon>
                                <local:CenteredGlyphTextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xF714;"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{local:Loc ResourceKey=AiteProfiles_ToggleFarm}" Command="{Binding ToggleFarmCommand}">
                            <MenuItem.Icon>
                                <local:CenteredGlyphTextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xE82D;"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="{local:Loc ResourceKey=AiteProfiles_Gemini}" Command="{Binding OpenGeminiCommand}">
                            <MenuItem.Icon>
                                <local:CenteredGlyphTextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xE945;"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{local:Loc ResourceKey=AiteProfiles_Gmail}" Command="{Binding OpenGmailCommand}">
                            <MenuItem.Icon>
                                <local:CenteredGlyphTextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xE715;"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{local:Loc ResourceKey=AiteProfiles_Drive}" Command="{Binding OpenDriveCommand}">
                            <MenuItem.Icon>
                                <local:CenteredGlyphTextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xE8B7;"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{local:Loc ResourceKey=AiteProfiles_Account}" Command="{Binding OpenAccountCommand}">
                            <MenuItem.Icon>
                                <local:CenteredGlyphTextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xE77B;"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{local:Loc ResourceKey=AiteProfiles_Compose}" Command="{Binding ComposeEmailCommand}">
                            <MenuItem.Icon>
                                <local:CenteredGlyphTextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xE70F;"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="{local:Loc ResourceKey=AiteProfiles_CopyEmail}" Command="{Binding CopyEmailCommand}">
                            <MenuItem.Icon>
                                <local:CenteredGlyphTextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xE8C8;"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{local:Loc ResourceKey=AiteProfiles_OpenFolder}" Command="{Binding OpenFolderCommand}">
                            <MenuItem.Icon>
                                <local:CenteredGlyphTextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xF42E;"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{local:Loc ResourceKey=AiteProfiles_CreateProfile}" Command="{Binding CreateProfileCommand}">
                            <MenuItem.Icon>
                                <local:CenteredGlyphTextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xF5B4;"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="42">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Click="ProfileCheckBox_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{local:Loc ResourceKey=AiteProfiles_ColumnProfile}" Width="410" MinWidth="410" SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4" Width="400" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="48"
                                            Height="48"
                                            CornerRadius="10"
                                            Background="#2B2F36"
                                            BorderBrush="#3A4654"
                                            BorderThickness="1"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding AvatarPath}"
                                                   Stretch="UniformToFill">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasAvatar}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                            <TextBlock Text="{Binding FallbackGlyph}"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       Foreground="#8FA7C4"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasAvatar}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Name, TargetNullValue='-'}" Foreground="#F2F5F8" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Email, TargetNullValue=''}" Foreground="#8F98A3" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{local:Loc ResourceKey=AiteProfiles_ColumnTime}" Width="105" SortMemberPath="LastTs">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding LastLaunchDate}" Foreground="#E8EDF2"/>
                                    <TextBlock Text="{Binding LastLaunchTime}" Foreground="#8F98A3" FontSize="12"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{local:Loc ResourceKey=AiteProfiles_ColumnInfo}" Width="*" MinWidth="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding CategoryDisplay}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Foreground="#8F98A3" FontSize="12">
                                        <Run Text="{local:Loc ResourceKey=AiteProfiles_BookmarksShort}"/>
                                        <Run Text="{Binding BookmarksDisplay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="2" Margin="0,8,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0"
                      Style="{StaticResource AiteProfilesComboBoxStyle}"
                      IsEditable="True"
                      IsTextSearchEnabled="False"
                      ItemsSource="{Binding QuickLinkSuggestions}"
                      SelectedItem="{Binding SelectedQuickLink, Mode=TwoWay}"
                      DisplayMemberPath="DisplayText"
                      Text="{Binding QuickLinkText, UpdateSourceTrigger=PropertyChanged}"
                      ToolTip="{local:Loc ResourceKey=AiteProfiles_QuickLinkPlaceholder}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                <ToggleButton Style="{StaticResource AiteProfilesToggleButtonStyle}"
                              Margin="0,0,6,0"
                              IsChecked="{Binding RememberQuickLink}"
                              ToolTip="{local:Loc ResourceKey=AiteProfiles_RememberLink}"
                              Content="&#xE735;"/>
                <ToggleButton Style="{StaticResource AiteProfilesToggleButtonStyle}"
                              IsChecked="{Binding RotationEnabled}"
                              ToolTip="{local:Loc ResourceKey=AiteProfiles_Rotation}"
                              Content="&#xE8D7;"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                <Button Style="{StaticResource AiteProfilesIconButtonStyle}" Content="&#xE710;" Command="{Binding AddQuickLinkCommand}" ToolTip="{local:Loc ResourceKey=AiteProfiles_AddLink}"/>
                <Button Style="{StaticResource AiteProfilesIconButtonStyle}" Content="&#xE70F;" Command="{Binding EditQuickLinkCommand}" ToolTip="{local:Loc ResourceKey=AiteProfiles_EditLink}"/>
                <Button Style="{StaticResource AiteProfilesIconButtonStyle}" Content="&#xE8B5;" Command="{Binding ImportQuickLinksCommand}" ToolTip="{local:Loc ResourceKey=AiteProfiles_ImportLinks}"/>
                <Button Style="{StaticResource AiteProfilesIconButtonStyle}" Content="&#xE74E;" Command="{Binding ExportQuickLinksCommand}" ToolTip="{local:Loc ResourceKey=AiteProfiles_ExportLinks}"/>
                <Button Height="36" MinWidth="118" Style="{StaticResource PrimaryButtonStyle}" Content="{local:Loc ResourceKey=AiteProfiles_Launch}" Command="{Binding LaunchCommand}"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="3"
                   Text="{Binding StatusText}"
                   Foreground="#8F98A3"
                   FontSize="12"/>
    </Grid>
    </Border>
</local:DarkWindow>
