<local:DarkWindow x:Class="AiteBar.AiteProfilesUtility.AiteProfilesWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:AiteBar"
                  xmlns:ap="clr-namespace:AiteBar.AiteProfilesUtility"
                  Icon="pack://application:,,,/AiteBar;component/Resources/app.ico"
                  Title="{local:Loc ResourceKey=AiteProfiles_Title}"
                  Width="720" Height="420" MinWidth="720" MinHeight="420" MaxWidth="720" MaxHeight="420"
                  WindowStartupLocation="Manual"
                  Background="Transparent" Foreground="#DCDCDC"
                  AllowsTransparency="True"
                  WindowStyle="None"
                  ResizeMode="NoResize"
                  ShowInTaskbar="False"
                  Topmost="True"
                  Deactivated="Window_Deactivated"
                  PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AiteBar;component/SettingsWindowResources.xaml"/>
                <ResourceDictionary Source="/AiteBar;component/FormControlsResources.xaml"/>
                <ResourceDictionary Source="/AiteBar;component/UtilityWindowResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="AiteProfilesTabButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="Height" Value="34"/>
                <Setter Property="MinWidth" Value="92"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
            </Style>

            <Style x:Key="AiteProfilesIconButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                <Setter Property="Width" Value="44"/>
                <Setter Property="Height" Value="44"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="FontFamily" Value="pack://application:,,,/Resources/#FluentSystemIcons-Regular"/>
                <Setter Property="FontSize" Value="20"/>
            </Style>

            <Style x:Key="AiteProfilesToggleButtonStyle" TargetType="ToggleButton">
                <Setter Property="Width" Value="44"/>
                <Setter Property="Height" Value="44"/>
                <Setter Property="Foreground" Value="#D7DEE7"/>
                <Setter Property="Background" Value="#2B2B2D"/>
                <Setter Property="BorderBrush" Value="#3A3A3D"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontFamily" Value="pack://application:,,,/Resources/#FluentSystemIcons-Regular"/>
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="Background" Value="#16324A"/>
                        <Setter Property="BorderBrush" Value="#007ACC"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="#5A6472"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="AiteProfilesListItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="MinHeight" Value="56"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="#E8EDF2"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Border x:Name="RowBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="#303034"
                                    BorderThickness="0,0,0,1">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background" Value="#20242B"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background" Value="#233247"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AiteProfilesHeaderButtonStyle" TargetType="Button">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="#AEB4BA"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AiteProfilesMutedTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#8F98A3"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <Style x:Key="AiteProfilesPrimaryTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#F2F5F8"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>

            <Style x:Key="AiteProfilesMetaIconStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="pack://application:,,,/Resources/#FluentSystemIcons-Regular"/>
                <Setter Property="Foreground" Value="#7891AF"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="AiteProfilesSmallCheckBoxStyle" TargetType="CheckBox">
                <Setter Property="Width" Value="16"/>
                <Setter Property="Height" Value="16"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="AiteProfilesSuggestionListStyle" TargetType="ListBox">
                <Setter Property="Background" Value="#252526"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="2"/>
                <Setter Property="MinWidth" Value="220"/>
                <Setter Property="MaxHeight" Value="160"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            </Style>

            <Style x:Key="AiteProfilesSuggestionItemStyle" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="Foreground" Value="{StaticResource FormControlForegroundBrush}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="ItemChrome"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="3"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemChrome" Property="Background" Value="#303033"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemChrome" Property="Background" Value="#303033"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Border Background="#FF1689E8"
            CornerRadius="8"
            SnapsToDevicePixels="True">
        <Border Background="{StaticResource PanelBackground}"
                BorderBrush="#14000000"
                BorderThickness="1"
                CornerRadius="7"
                Margin="1"
                Padding="12"
                SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Content="{local:Loc ResourceKey=AiteProfiles_AllTab}"
                        Command="{Binding SetAllTabCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource AiteProfilesTabButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAllTabActive}" Value="True">
                                    <Setter Property="BorderBrush" Value="#007ACC"/>
                                    <Setter Property="Background" Value="#16324A"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{local:Loc ResourceKey=AiteProfiles_FavoritesTab}"
                        Command="{Binding SetFavoritesTabCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource AiteProfilesTabButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFavoritesTabActive}" Value="True">
                                    <Setter Property="BorderBrush" Value="#007ACC"/>
                                    <Setter Property="Background" Value="#16324A"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{local:Loc ResourceKey=AiteProfiles_FarmTab}"
                        Command="{Binding SetFarmTabCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource AiteProfilesTabButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFarmTabActive}" Value="True">
                                    <Setter Property="BorderBrush" Value="#007ACC"/>
                                    <Setter Property="Background" Value="#16324A"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
            <TextBox x:Name="SearchBox"
                     Grid.Column="1"
                     Height="34"
                     Margin="8,0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{local:Loc ResourceKey=AiteProfiles_SearchPlaceholder}"/>
            <Button Grid.Column="2"
                    Style="{StaticResource AiteProfilesIconButtonStyle}"
                    Content="&#xE112;"
                    Foreground="#93C5FD"
                    Command="{Binding RefreshCommand}"
                    ToolTip="{local:Loc ResourceKey=AiteProfiles_Scan}"
                    Margin="0,0,0,0"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Background="Transparent"
                      Height="34"
                      Margin="10,0,10,0"
                      VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="2.3*"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1.7*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0"
                              Style="{StaticResource AiteProfilesSmallCheckBoxStyle}"
                              IsThreeState="False"
                              Click="SelectAllCheckBox_Click"/>
                    <Button Grid.Column="2"
                            Style="{StaticResource AiteProfilesHeaderButtonStyle}"
                            Margin="8,0,0,0"
                            Content="{local:Loc ResourceKey=AiteProfiles_ColumnProfile}"
                            Click="ProfileHeader_Click"/>
                    <Button Grid.Column="3"
                            Style="{StaticResource AiteProfilesHeaderButtonStyle}"
                            Margin="8,0,0,0"
                            Content="{local:Loc ResourceKey=AiteProfiles_ColumnTime}"
                            Click="TimeHeader_Click"/>
                    <TextBlock Grid.Column="4"
                               Text="{local:Loc ResourceKey=AiteProfiles_ColumnInfo}"
                               Foreground="#AEB4BA"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                </Grid>

                <ListView x:Name="ProfilesGrid"
                          Grid.Row="1"
                          ItemsSource="{Binding Profiles}"
                          Background="Transparent"
                          BorderThickness="0"
                          SelectionMode="Extended"
                          HorizontalContentAlignment="Stretch"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ItemContainerStyle="{StaticResource AiteProfilesListItemStyle}"
                          SelectionChanged="ProfilesGrid_SelectionChanged"
                          MouseDoubleClick="ProfilesGrid_MouseDoubleClick"
                          PreviewMouseRightButtonDown="ProfilesGrid_PreviewMouseRightButtonDown">
                    <ListView.ContextMenu>
                    <ContextMenu Opened="ContextMenu_Opened" Closed="ContextMenu_Closed">
                        <MenuItem Header="{local:Loc ResourceKey=AiteProfiles_Open}" Command="{Binding OpenProfileCommand}">
                            <MenuItem.Icon>
                                <local:CenteredGlyphTextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xF582;"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="OpenSelectedMenuItem" Header="{local:Loc ResourceKey=AiteProfiles_OpenSelected}" Command="{Binding OpenSelectedProfilesCommand}">
                            <MenuItem.Icon>
                                <local:CenteredGlyphTextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xF582;"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{local:Loc ResourceKey=AiteProfiles_OpenIncognito}" Command="{Binding OpenIncognitoCommand}">
                            <MenuItem.Icon>
                                <local:CenteredGlyphTextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xF4A1;"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="{local:Loc ResourceKey=AiteProfiles_EditTags}" Command="{Binding EditTagsCommand}">
                            <MenuItem.Icon>
                                <local:CenteredGlyphTextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xF77C;"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="ToggleFavoriteMenuItem" Header="{local:Loc ResourceKey=AiteProfiles_ToggleFavorite}" Command="{Binding ToggleFavoriteCommand}">
                            <MenuItem.Icon>
                                <local:CenteredGlyphTextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xF70F;"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="ToggleFarmMenuItem" Header="{local:Loc ResourceKey=AiteProfiles_ToggleFarm}" Command="{Binding ToggleFarmCommand}">
                            <MenuItem.Icon>
                                <local:CenteredGlyphTextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xF1FC;"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="{local:Loc ResourceKey=AiteProfiles_Gemini}" Command="{Binding OpenGeminiCommand}">
                            <MenuItem.Icon>
                                <local:CenteredGlyphTextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xF45A;"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{local:Loc ResourceKey=AiteProfiles_Gmail}" Command="{Binding OpenGmailCommand}">
                            <MenuItem.Icon>
                                <local:CenteredGlyphTextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xF506;"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{local:Loc ResourceKey=AiteProfiles_Drive}" Command="{Binding OpenDriveCommand}">
                            <MenuItem.Icon>
                                <local:CenteredGlyphTextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xF530;"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{local:Loc ResourceKey=AiteProfiles_Account}" Command="{Binding OpenAccountCommand}">
                            <MenuItem.Icon>
                                <local:CenteredGlyphTextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xF5C1;"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{local:Loc ResourceKey=AiteProfiles_Compose}" Command="{Binding ComposeEmailCommand}">
                            <MenuItem.Icon>
                                <local:CenteredGlyphTextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xF314;"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="{local:Loc ResourceKey=AiteProfiles_CopyEmail}" Command="{Binding CopyEmailCommand}">
                            <MenuItem.Icon>
                                <local:CenteredGlyphTextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xF32B;"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{local:Loc ResourceKey=AiteProfiles_OpenFolder}" Command="{Binding OpenFolderCommand}">
                            <MenuItem.Icon>
                                <local:CenteredGlyphTextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xF42E;"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{local:Loc ResourceKey=AiteProfiles_CreateProfile}" Command="{Binding CreateProfileCommand}">
                            <MenuItem.Icon>
                                <local:CenteredGlyphTextBlock Style="{StaticResource ContextMenuIconTextStyle}" Text="&#xF5C2;"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border MinHeight="56" Padding="10,2,10,2" Background="Transparent">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="2.3*"/>
                                        <ColumnDefinition Width="1.1*"/>
                                        <ColumnDefinition Width="1.7*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <CheckBox Grid.Column="0"
                                              Grid.RowSpan="2"
                                              Style="{StaticResource AiteProfilesSmallCheckBoxStyle}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Click="ProfileCheckBox_Click"/>

                                    <Border Grid.Column="1"
                                            Grid.RowSpan="2"
                                            Width="48"
                                            Height="48"
                                            CornerRadius="10"
                                            Background="#26303B"
                                            BorderBrush="#344150"
                                            BorderThickness="1"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding AvatarImagePath}"
                                                   Stretch="Uniform"
                                                   SnapsToDevicePixels="True"
                                                   UseLayoutRounding="True"
                                                   RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasAvatar}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                            <TextBlock Text="{Binding FallbackGlyph}"
                                                       FontFamily="pack://application:,,,/Resources/#FluentSystemIcons-Regular"
                                                       Foreground="#8FA7C4"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasAvatar}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>

                                    <TextBlock Grid.Column="2"
                                               Grid.Row="0"
                                               Margin="8,0,8,0"
                                               Text="{Binding Name}"
                                               Style="{StaticResource AiteProfilesPrimaryTextStyle}"
                                               VerticalAlignment="Bottom"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2"
                                               Grid.Row="1"
                                               Margin="8,2,8,0"
                                               Text="{Binding Email}"
                                               Style="{StaticResource AiteProfilesMutedTextStyle}"
                                               VerticalAlignment="Top"
                                               TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Grid.Column="3"
                                               Grid.Row="0"
                                               Margin="8,0,8,0"
                                               Text="{Binding LastLaunchDate}"
                                               Style="{StaticResource AiteProfilesMutedTextStyle}"
                                               VerticalAlignment="Bottom"/>
                                    <TextBlock Grid.Column="3"
                                               Grid.Row="1"
                                               Margin="8,2,8,0"
                                               Text="{Binding LastLaunchTime}"
                                               Style="{StaticResource AiteProfilesMutedTextStyle}"
                                               VerticalAlignment="Top"/>

                                    <TextBlock Grid.Column="4"
                                               Grid.Row="0"
                                               Margin="8,0,0,0"
                                               Text="{Binding TagsDisplay}"
                                               Style="{StaticResource AiteProfilesMutedTextStyle}"
                                               VerticalAlignment="Bottom"
                                               TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Grid.Column="4"
                                                Grid.Row="1"
                                                Margin="8,2,0,0"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Top">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                            <TextBlock Text="&#xF70F;" Style="{StaticResource AiteProfilesMetaIconStyle}" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding BookmarksDisplay}" Style="{StaticResource AiteProfilesMutedTextStyle}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE6E3;" Style="{StaticResource AiteProfilesMetaIconStyle}" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding DiskDisplay}" Style="{StaticResource AiteProfilesMutedTextStyle}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="0,8,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <TextBox x:Name="QuickLinkBox"
                         Style="{StaticResource BaseTextBoxStyle}"
                         Height="44"
                         Text="{Binding QuickLinkText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{local:Loc ResourceKey=AiteProfiles_QuickLinkPlaceholder}"
                         GotKeyboardFocus="QuickLinkBox_GotKeyboardFocus"
                         LostKeyboardFocus="QuickLinkBox_LostKeyboardFocus"
                         TextChanged="QuickLinkBox_TextChanged"/>
                <Popup x:Name="QuickLinkSuggestionsPopup"
                       PlacementTarget="{Binding ElementName=QuickLinkBox}"
                       Placement="Top"
                       VerticalOffset="-2"
                       AllowsTransparency="True"
                       Focusable="False"
                       StaysOpen="True"
                       PopupAnimation="Fade">
                    <ListBox x:Name="QuickLinkSuggestionsList"
                             MaxWidth="{Binding ActualWidth, ElementName=QuickLinkBox}"
                             ItemsSource="{Binding QuickLinkSuggestions}"
                             DisplayMemberPath="DisplayText"
                             Style="{StaticResource AiteProfilesSuggestionListStyle}"
                             ItemContainerStyle="{StaticResource AiteProfilesSuggestionItemStyle}"
                             MouseLeftButtonUp="QuickLinkSuggestionsList_MouseLeftButtonUp"/>
                </Popup>
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                <ToggleButton Style="{StaticResource AiteProfilesToggleButtonStyle}"
                              Margin="0,0,6,0"
                              IsChecked="{Binding RememberQuickLink}"
                              ToolTip="{local:Loc ResourceKey=AiteProfiles_RememberLink}">
                    <TextBlock Text="&#xF602;" FontFamily="pack://application:,,,/Resources/#FluentSystemIcons-Regular" FontSize="20">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#FFD166"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </ToggleButton>
                <ToggleButton Style="{StaticResource AiteProfilesToggleButtonStyle}"
                              IsChecked="{Binding RotationEnabled}"
                              ToolTip="{local:Loc ResourceKey=AiteProfiles_Rotation}">
                    <TextBlock Text="&#xF186;" FontFamily="pack://application:,,,/Resources/#FluentSystemIcons-Regular" FontSize="20">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#CDEBB0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </ToggleButton>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                <Button Style="{StaticResource AiteProfilesIconButtonStyle}" Content="&#xF109;" Foreground="#5EEAD4" Command="{Binding AddQuickLinkCommand}" ToolTip="{local:Loc ResourceKey=AiteProfiles_AddLink}"/>
                <Button Style="{StaticResource AiteProfilesIconButtonStyle}" Content="&#xF3DD;" Foreground="#CDEBB0" Command="{Binding EditQuickLinkCommand}" ToolTip="{local:Loc ResourceKey=AiteProfiles_EditLink}"/>
                <Button Style="{StaticResource AiteProfilesIconButtonStyle}" Content="&#xE4DF;" Foreground="#FFD166" Command="{Binding ImportQuickLinksCommand}" ToolTip="{local:Loc ResourceKey=AiteProfiles_ImportLinks}"/>
                <Button Style="{StaticResource AiteProfilesIconButtonStyle}" Content="&#xF401;" Foreground="#FFD166" Command="{Binding ExportQuickLinksCommand}" ToolTip="{local:Loc ResourceKey=AiteProfiles_ExportLinks}"/>
                <Button Height="44" MinWidth="118" Style="{StaticResource PrimaryButtonStyle}" Content="{local:Loc ResourceKey=AiteProfiles_Launch}" Command="{Binding LaunchCommand}"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="3"
                   Text="{Binding StatusText}"
                   Foreground="#8F98A3"
                   FontSize="12"/>
    </Grid>
        </Border>
    </Border>
</local:DarkWindow>
