<local:DarkWindow x:Class="AiteBar.AiteProfilesUtility.AiteProfilesQuickLinkDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:AiteBar"
                  Title="{local:Loc ResourceKey=AiteProfiles_QuickLinkDialogTitle}"
                  Width="520" Height="420"
                  WindowStartupLocation="CenterOwner"
                  ResizeMode="CanResize"
                  MinWidth="440" MinHeight="360"
                  ShowInTaskbar="False"
                  Background="#191919"
                  Foreground="#DCDCDC">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AiteBar;component/SettingsWindowResources.xaml"/>
                <ResourceDictionary Source="/AiteBar;component/FormControlsResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{local:Loc ResourceKey=AiteProfiles_LinkName}" Foreground="#AEB4BA" Margin="0,0,0,4"/>
            <Border x:Name="NameChrome"
                    Background="{StaticResource FormInputBackground}"
                    BorderBrush="{StaticResource FormControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Height="34"
                    SnapsToDevicePixels="True">
                <Grid>
                    <TextBox x:Name="NameBox"
                             Style="{x:Null}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource FormControlForegroundBrush}"
                             CaretBrush="{StaticResource FormControlForegroundBrush}"
                             ContextMenu="{StaticResource TextEditingContextMenu}"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Left"
                             Padding="10,0"
                             TextChanged="Input_TextChanged"/>
                    <TextBlock x:Name="NamePlaceholder"
                               Text="{local:Loc ResourceKey=AiteProfiles_LinkNamePlaceholder}"
                               Foreground="{StaticResource PlaceholderForegroundBrush}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="{local:Loc ResourceKey=AiteProfiles_LinkTags}" Foreground="#AEB4BA" Margin="0,0,0,4"/>
            <Border x:Name="TagsChrome"
                    Background="{StaticResource FormInputBackground}"
                    BorderBrush="{StaticResource FormControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Height="34"
                    SnapsToDevicePixels="True">
                <Grid>
                    <TextBox x:Name="TagsBox"
                             Style="{x:Null}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource FormControlForegroundBrush}"
                             CaretBrush="{StaticResource FormControlForegroundBrush}"
                             ContextMenu="{StaticResource TextEditingContextMenu}"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Left"
                             Padding="10,0"
                             TextChanged="Input_TextChanged"/>
                    <TextBlock x:Name="TagsPlaceholder"
                               Text="{local:Loc ResourceKey=AiteProfiles_LinkTagsPlaceholder}"
                               Foreground="{StaticResource PlaceholderForegroundBrush}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                       Text="{local:Loc ResourceKey=AiteProfiles_LinkUrls}"
                       Foreground="#AEB4BA"
                       Margin="0,0,0,4"/>
            <Border x:Name="UrlsChrome"
                    Grid.Row="1"
                    Background="{StaticResource FormInputBackground}"
                    BorderBrush="{StaticResource FormControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    SnapsToDevicePixels="True">
                <Grid>
                    <TextBox x:Name="UrlsBox"
                             Style="{x:Null}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource FormControlForegroundBrush}"
                             CaretBrush="{StaticResource FormControlForegroundBrush}"
                             ContextMenu="{StaticResource TextEditingContextMenu}"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"
                             Padding="10,8"
                             TextChanged="Input_TextChanged"/>
                    <TextBlock x:Name="UrlsPlaceholder"
                               Text="{local:Loc ResourceKey=AiteProfiles_LinkUrlsPlaceholder}"
                               Foreground="{StaticResource PlaceholderForegroundBrush}"
                               Margin="12,8,0,0"
                               IsHitTestVisible="False"
                               VerticalAlignment="Top"
                               TextWrapping="NoWrap"/>
                </Grid>
            </Border>
        </Grid>

        <CheckBox x:Name="ChkGuestMode"
                  Grid.Row="3"
                  Content="{local:Loc ResourceKey=AiteProfiles_GuestMode}"
                  Foreground="#AEB4BA"
                  Margin="0,0,0,12"/>

        <TextBlock x:Name="ValidationText"
                   Grid.Row="4"
                   Foreground="#E57373"
                   Margin="0,0,0,12"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{local:Loc ResourceKey=Common_Cancel}" Width="110" Height="38" Margin="0,0,8,0" Click="Cancel_Click" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button x:Name="SaveButton" Content="{local:Loc ResourceKey=Common_Save}" Width="110" Height="38" Click="Save_Click" Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</local:DarkWindow>
