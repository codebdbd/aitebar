<Window x:Class="AiteBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AiteBar"
        Title="AiteBar" 
        SizeToContent="WidthAndHeight" MinWidth="150"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded" SourceInitialized="Window_SourceInitialized" PreviewKeyDown="Window_PreviewKeyDown" Left="0" Top="-2000">
    
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#E3E3E3"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontFamily" Value="pack://application:,,,/Resources/#FluentSystemIcons-Regular"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="2,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <Border x:Name="FocusChrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4"/>
                            <Border x:Name="FillChrome" Background="{TemplateBinding Background}" Margin="1" CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FillChrome" Property="Background" Value="#25FFFFFF"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsKeyboardFocused" Value="True"/>
                                    <Condition Property="local:KeyboardFocusVisualService.ShowKeyboardFocusCue" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="FocusChrome" Property="BorderBrush" Value="#3ABEFF"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontFamily" Value="pack://application:,,,/Resources/#FluentSystemIcons-Regular"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="0"/>
        </Style>

        <Style x:Key="CircleAccentButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="2,2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="pack://application:,,,/Resources/#FluentSystemIcons-Regular"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <Border x:Name="FocusChrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4"/>
                            <Border Width="24" Height="24" Background="#2A9CFF" CornerRadius="12"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="CircleBorder">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1E6FD9" TargetName="CircleBorder"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#164C99" TargetName="CircleBorder"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsKeyboardFocused" Value="True"/>
                                    <Condition Property="local:KeyboardFocusVisualService.ShowKeyboardFocusCue" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="FocusChrome" Property="BorderBrush" Value="#3ABEFF"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="Transparent" CornerRadius="9" BorderThickness="0" Margin="10,8,10,16"
            SnapsToDevicePixels="True"
            TextOptions.TextFormattingMode="Ideal"
            AllowDrop="True" DragOver="Border_DragOver" Drop="Border_Drop" PreviewMouseWheel="RootBorder_PreviewMouseWheel" PreviewMouseDown="RootBorder_PreviewMouseDown">
        <Grid ClipToBounds="False">
            <Border Background="#FF1689E8" CornerRadius="8" SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect Color="#008DFF" BlurRadius="4" ShadowDepth="0" Opacity="0.45"/>
                </Border.Effect>
                <Border Background="{StaticResource PanelBackground}" BorderBrush="#14000000" BorderThickness="1" CornerRadius="7" Margin="1" SnapsToDevicePixels="True">
                    <DockPanel x:Name="MainPanel" HorizontalAlignment="Left" VerticalAlignment="Center" LastChildFill="False" Margin="2">
                <Border x:Name="DragHandle"
                        Width="14"
                        Height="44"
                        Margin="0,0,2,0"
                        Background="#01000000"
                        Cursor="SizeAll"
                        DockPanel.Dock="Left"
                        MouseLeftButtonDown="DragHandle_MouseLeftButtonDown"
                        MouseMove="DragHandle_MouseMove"
                        MouseLeftButtonUp="DragHandle_MouseLeftButtonUp"
                        LostMouseCapture="DragHandle_LostMouseCapture">
                    <Border x:Name="DragHandleGrip"
                            Width="4"
                            Height="18"
                            Background="#2A9CFF"
                            CornerRadius="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"/>
                </Border>

                <StackPanel x:Name="FixedPanel" Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <StackPanel x:Name="ControlBlock" Orientation="Horizontal">
                        <Button x:Name="ContextIndicator" Width="40" Height="40" Margin="2,2"
                                ToolTipService.InitialShowDelay="0" Click="ContextIndicator_Click">
                            <Border Width="24" Height="24" Background="#2A9CFF" CornerRadius="12" 
                                    HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="ContextIndicatorCircle">
                                <TextBlock x:Name="ContextIndicatorText" Text="1" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0"/>
                            </Border>
                        </Button>
                        <Button x:Name="BtnAdd" Content="&#xF10A;" Click="BtnAdd_Click" Style="{StaticResource CircleAccentButtonStyle}"/>
                    </StackPanel>

                    <Rectangle x:Name="SepSystem" Width="1" Height="20" Fill="#332A9CFF" Margin="2,0" VerticalAlignment="Center"/>
                </StackPanel>

                <local:OverflowWrapPanel x:Name="UnifiedButtonsPanel" Orientation="Horizontal" ClipToBounds="True" VerticalAlignment="Center"/>

                <StackPanel x:Name="AppSettingsBlock" Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Rectangle x:Name="SepAppSettings" Width="1" Height="20" Fill="#332A9CFF" Margin="4,0" VerticalAlignment="Center"/>
                    <Button x:Name="BtnAppSettings" Content="&#xF6A8;" Click="BtnAppSettings_Click" Foreground="#2A9CFF" FontFamily="pack://application:,,,/Resources/#FluentSystemIcons-Regular" FontSize="20" Focusable="True"/>
                </StackPanel>
                    </DockPanel>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
