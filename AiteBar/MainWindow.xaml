<Window x:Class="AiteBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AiteBar"
        Title="AiteBar" 
        SizeToContent="WidthAndHeight" MinWidth="150"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded" SourceInitialized="Window_SourceInitialized" PreviewKeyDown="Window_PreviewKeyDown" Left="0" Top="-2000">
    
    <Window.Resources>
        <Style x:Key="ButtonFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="#2A9CFF" BorderThickness="1" CornerRadius="4" Margin="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#E3E3E3"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontFamily" Value="pack://application:,,,/Resources/#FluentSystemIcons-Regular"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="2,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FocusChrome" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#25FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Background" Value="#2A2A2C"/>
                                <Setter TargetName="FocusChrome" Property="BorderBrush" Value="#2A9CFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontFamily" Value="pack://application:,,,/Resources/#FluentSystemIcons-Regular"/>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="{StaticResource BorderColor}" CornerRadius="8" BorderBrush="#332A9CFF" BorderThickness="0.7" Margin="3"
            SnapsToDevicePixels="True"
            TextOptions.TextFormattingMode="Ideal"
            AllowDrop="True" DragOver="Border_DragOver" Drop="Border_Drop" PreviewMouseWheel="RootBorder_PreviewMouseWheel" PreviewMouseDown="RootBorder_PreviewMouseDown">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="1" Opacity="0.25"/>
        </Border.Effect>
        <Border Background="{StaticResource PanelBackground}" CornerRadius="7" SnapsToDevicePixels="True">
        <DockPanel x:Name="MainPanel" HorizontalAlignment="Left" VerticalAlignment="Center" LastChildFill="False" Margin="2">
                <Border x:Name="DragHandle"
                        Width="14"
                        Height="44"
                        Margin="0,0,2,0"
                        Background="#01000000"
                        Cursor="SizeAll"
                        DockPanel.Dock="Left"
                        MouseLeftButtonDown="DragHandle_MouseLeftButtonDown"
                        MouseMove="DragHandle_MouseMove"
                        MouseLeftButtonUp="DragHandle_MouseLeftButtonUp"
                        LostMouseCapture="DragHandle_LostMouseCapture">
                    <Border x:Name="DragHandleGrip"
                            Width="4"
                            Height="18"
                            Background="#2A9CFF"
                            CornerRadius="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"/>
                </Border>

                <StackPanel x:Name="FixedPanel" Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <StackPanel x:Name="ControlBlock" Orientation="Horizontal">
                        <Button x:Name="BtnAdd" Content="&#xF10A;" Click="BtnAdd_Click" Width="40" Height="40" Margin="2,2" FontSize="14" Padding="0"
                                Foreground="#FFFFFF" Focusable="True">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="FocusChrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4">
                                        <Border Width="24" Height="24" Background="#2A9CFF" CornerRadius="12" 
                                                HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="CircleBorder">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                        </Border>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1E6FD9" TargetName="CircleBorder"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#164C99" TargetName="CircleBorder"/>
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="FocusChrome" Property="BorderBrush" Value="#2A9CFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <Rectangle x:Name="SepSystem" Width="1" Height="20" Fill="#332A9CFF" Margin="2,0" VerticalAlignment="Center"/>

                    <local:OverflowWrapPanel x:Name="SystemUtilsPanel" Orientation="Horizontal">
                        <Button x:Name="BtnSearch" Content="&#xEA7C;" Click="BtnSearch_Click" Foreground="#3ABEFF" Focusable="True"/>
                        <Button x:Name="BtnScreenshot" Content="&#xF68E;" Click="BtnScreenshotRegion_Click" Foreground="#60A5FA" Focusable="True"/>
                        <Button x:Name="BtnRecord" Content="&#xF535;" Click="BtnRecordVideo_Click" Foreground="#FB7185" Focusable="True"/>
                        <Button x:Name="BtnCalc" Content="&#xF06C;" Click="BtnCalc_Click" Foreground="#A3E635" Focusable="True"/>
                        <Button x:Name="BtnExplorer" Content="&#xF42F;" Click="BtnExplorer_Click" Foreground="#F59E0B" Focusable="True"/>
                        <Button x:Name="BtnDownloads" Content="&#xF151;" Click="BtnDownloads_Click" Foreground="#34D399" Focusable="True"/>
                        <Button x:Name="BtnFileSorter" Content="&#xF202;" Click="BtnFileSorter_Click" Foreground="#60A5FA" Focusable="True"/>
                        <Button x:Name="BtnTimerStopwatch" Content="&#xED88;" Click="BtnTimerStopwatch_Click" Foreground="#38BDF8" Focusable="True"/>
                        <Button x:Name="BtnColorPicker" Content="&#xE5FE;" Click="BtnColorPicker_Click" Foreground="#A855F7" Focusable="True"/>
                        <Button x:Name="BtnQuickNote" Content="&#xF56F;" Click="BtnQuickNote_Click" Foreground="#22D3EE" Focusable="True"/>
                    </local:OverflowWrapPanel>

                    <Rectangle x:Name="SepControl" Width="1" Height="20" Fill="#332A9CFF" Margin="4,0" VerticalAlignment="Center"/>
                </StackPanel>

                <local:OverflowWrapPanel x:Name="UserButtonsPanel" Orientation="Horizontal" ClipToBounds="True" VerticalAlignment="Center"/>

                <StackPanel x:Name="AppSettingsBlock" Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Rectangle x:Name="SepAppSettings" Width="1" Height="20" Fill="#332A9CFF" Margin="4,0" VerticalAlignment="Center"/>
                    <Button x:Name="BtnAppSettings" Content="&#xF6A8;" Click="BtnAppSettings_Click" Foreground="#2A9CFF" Focusable="True"/>
                </StackPanel>
        </DockPanel>
        </Border>
    </Border>
</Window>