<local:DarkWindow x:Class="AiteBar.ZenEditorDocumentPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AiteBar"
        Title="{local:Loc ResourceKey=ZenEditor_OpenDocument}"
        Width="700" Height="520" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F4F0E7"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewTextInput="Window_PreviewTextInput">
    <Border x:Name="Frame" BorderThickness="1" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="PickerTitle"
                       Text="{local:Loc ResourceKey=ZenEditor_OpenDocument}"
                       FontSize="17" Margin="4,0,4,14"/>

            <ListBox x:Name="DocumentList"
                     Grid.Row="1"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     AutomationProperties.Name="{local:Loc ResourceKey=ZenEditor_OpenDocument}"
                     MouseDoubleClick="DocumentList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="8,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding CurrentMarker}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Modified}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="3" 
                                    Content="&#xF34D;" 
                                    FontFamily="pack://application:,,,/Resources/#FluentSystemIcons-Regular"
                                    FontSize="16"
                                    Width="28" Height="28"
                                    Margin="8,0,0,0"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#DCDCDC"
                                    Click="DeleteButton_Click"
                                    ToolTip="{local:Loc ResourceKey=ZenEditor_DeleteDocument}"
                                    Tag="{Binding Id}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="#FF6B6B"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</local:DarkWindow>
