<local:DarkWindow x:Class="AiteBar.ZenEditorDocumentPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AiteBar"
        Title="{local:Loc ResourceKey=ZenEditor_OpenDocument}"
        Width="700" Height="520" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F4F0E7"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewTextInput="Window_PreviewTextInput">
    <Window.Resources>
        <SolidColorBrush x:Key="ZenDeleteButtonForeground" Color="#9BA1A6"/>
        <SolidColorBrush x:Key="ZenDeleteButtonHoverBackground" Color="#382326"/>
        <SolidColorBrush x:Key="ZenDeleteButtonHoverBorder" Color="#5C282C"/>
        <SolidColorBrush x:Key="ZenDeleteButtonHoverForeground" Color="#FF6B6B"/>
        <SolidColorBrush x:Key="ZenDeleteButtonPressedBackground" Color="#482226"/>
        <SolidColorBrush x:Key="ZenDeleteButtonPressedBorder" Color="#6E2E33"/>

        <Style x:Key="ZenEditorDeleteButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="pack://application:,,,/Resources/#FluentSystemIcons-Regular"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource ZenDeleteButtonForeground}"/>
            <Setter Property="Visibility" Value="Visible"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              SnapsToDevicePixels="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ZenDeleteButtonHoverBackground}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ZenDeleteButtonHoverBorder}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ZenDeleteButtonHoverForeground}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ZenDeleteButtonPressedBackground}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ZenDeleteButtonPressedBorder}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ZenDeleteButtonHoverForeground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanDelete}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border x:Name="Frame" BorderThickness="1" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="PickerTitle"
                       Text="{local:Loc ResourceKey=ZenEditor_OpenDocument}"
                       FontSize="17" Margin="4,0,4,14"/>

            <ListBox x:Name="DocumentList"
                     Grid.Row="1"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     AutomationProperties.Name="{local:Loc ResourceKey=ZenEditor_OpenDocument}"
                     MouseDoubleClick="DocumentList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="8,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding CurrentMarker}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Modified}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="3" 
                                    Content="&#xF34D;" 
                                    Style="{StaticResource ZenEditorDeleteButtonStyle}"
                                    Click="DeleteButton_Click"
                                    AutomationProperties.Name="{local:Loc ResourceKey=ZenEditor_DeleteDocument}"
                                    ToolTip="{local:Loc ResourceKey=ZenEditor_DeleteDocument}"
                                    Tag="{Binding Id}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</local:DarkWindow>
