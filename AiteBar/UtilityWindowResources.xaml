<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="UtilityHeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}"/>

    <Style x:Key="UtilityCommandButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"/>

    <Style x:Key="UtilityPrimaryCommandButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}"/>

    <Style x:Key="HeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}"/>
    <Style x:Key="CommandButtonStyle" TargetType="Button" BasedOn="{StaticResource UtilityCommandButtonStyle}"/>
    <Style x:Key="PrimaryCommandButtonStyle" TargetType="Button" BasedOn="{StaticResource UtilityPrimaryCommandButtonStyle}"/>
</ResourceDictionary>
