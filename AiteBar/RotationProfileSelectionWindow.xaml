<local:DarkWindow x:Class="AiteBar.RotationProfileSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AiteBar"
        Icon="pack://application:,,,/Resources/app.ico"
        Title="{local:Loc ResourceKey=RotationProfiles_Title}" Width="560" Height="440"
        WindowStartupLocation="CenterOwner" Background="#1A1A1C" Foreground="#DCDCDC"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsWindowResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{local:Loc ResourceKey=RotationProfiles_Profiles}" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock Text="{local:Loc ResourceKey=RotationProfiles_DefaultHint}" Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,3,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#2D2D30" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="10,4" VerticalAlignment="Top">
                <TextBlock x:Name="TxtSelectionCount" Foreground="{StaticResource MutedText}" FontSize="11"/>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <TextBox x:Name="TxtSearch" TextChanged="TxtSearch_TextChanged" Height="30"/>
            <TextBlock x:Name="TxtSearchPlaceholder" Text="{local:Loc ResourceKey=RotationProfiles_SearchPlaceholder}" Margin="10,0" VerticalAlignment="Center" Foreground="#666666" IsHitTestVisible="False"/>
        </Grid>

        <Border Grid.Row="2" Background="#202022" BorderBrush="#3A3A3E" BorderThickness="1" CornerRadius="6" Padding="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PanelProfiles"/>
            </ScrollViewer>
        </Border>

        <UniformGrid Grid.Row="3" Columns="4" Margin="0,14,0,0">
            <Button Style="{StaticResource SecondaryButtonStyle}" Content="{local:Loc ResourceKey=RotationProfiles_SelectAll}" Click="BtnSelectAll_Click" Height="36" Margin="0,0,6,0"/>
            <Button Style="{StaticResource SecondaryButtonStyle}" Content="{local:Loc ResourceKey=RotationProfiles_Clear}" Click="BtnClear_Click" Height="36" Margin="6,0,6,0"/>
            <Button x:Name="BtnCancel" Style="{StaticResource SecondaryButtonStyle}" Content="{local:Loc ResourceKey=Common_Cancel}" Click="BtnCancel_Click" Height="36" Margin="6,0,6,0" IsCancel="True"/>
            <Button x:Name="BtnSave" Style="{StaticResource ActionButtonStyle}" Content="{local:Loc ResourceKey=Common_Save}" Click="BtnSave_Click" Height="36" Margin="6,0,0,0" IsDefault="True"/>
        </UniformGrid>
    </Grid>
</local:DarkWindow>
