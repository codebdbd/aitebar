<local:DarkWindow x:Class="AiteBar.PromptBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AiteBar"
        Icon="pack://application:,,,/AiteBar;component/Resources/app.ico"
        Title="{local:Loc ResourceKey=PromptBuilder_Title}"
        Width="1280" Height="840"
        MinWidth="1000" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryText}"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
        ShowInTaskbar="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged"
        SizeChanged="Window_SizeChanged"
        LocationChanged="Window_LocationChanged"
        PreviewKeyDown="Window_PreviewKeyDown"
        Activated="Window_Activated"
        Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsWindowResources.xaml"/>
                <ResourceDictionary Source="FormControlsResources.xaml"/>
                <ResourceDictionary Source="UtilityWindowResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="PromptBuilderCardBrush" Color="#252526"/>
            <SolidColorBrush x:Key="PromptBuilderCardHoverBrush" Color="#2D2D30"/>
            <SolidColorBrush x:Key="PromptBuilderWarningBrush" Color="#FFB400"/>
            <SolidColorBrush x:Key="PromptBuilderWarningBackgroundBrush" Color="#2A210F"/>
            <SolidColorBrush x:Key="PromptBuilderErrorBrush" Color="#E85A5A"/>
            <SolidColorBrush x:Key="PromptBuilderErrorBackgroundBrush" Color="#2C1919"/>
            <SolidColorBrush x:Key="PromptBuilderDiffAddedBrush" Color="#67C587"/>
            <SolidColorBrush x:Key="PromptBuilderDiffRemovedBrush" Color="#E47777"/>

            <Style x:Key="PromptBuilderTabItemStyle" TargetType="TabItem">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Foreground" Value="{DynamicResource MutedText}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="TabChrome"
                                    Margin="0,0,16,0" Padding="12,9"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0,0,0,3"
                                    CornerRadius="0">
                                <ContentPresenter ContentSource="Header"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  TextElement.FontSize="14"
                                                  TextElement.FontWeight="SemiBold"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="EditorTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="VerticalContentAlignment" Value="Top"/>
                <Setter Property="CaretBrush" Value="{DynamicResource PrimaryText}"/>
                <Setter Property="SelectionBrush" Value="{DynamicResource AccentColor}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="EditorFocusBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent" BorderThickness="1" CornerRadius="4">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsKeyboardFocused" Value="True"/>
                                        <Condition Property="local:KeyboardFocusVisualService.ShowKeyboardFocusCue" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="EditorFocusBorder" Property="BorderBrush" Value="#3ABEFF"/>
                                </MultiTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.7"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <ScrollViewer x:Name="LayoutViewport"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Stretch"
                      Focusable="False">
            <Grid Margin="32,16,32,24">
                <DockPanel x:Name="ContentHost"
                           HorizontalAlignment="Center" VerticalAlignment="Stretch">

            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                <TextBlock Text="{local:Loc ResourceKey=PromptBuilder_Title}"
                           FontSize="30" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryText}"/>
                <TextBlock Text="{local:Loc ResourceKey=PromptBuilder_Description}"
                           Margin="0,4,0,0" FontSize="14"
                           Foreground="{DynamicResource MutedText}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="0,0,0,1" Margin="0,0,0,16">
                <TabControl x:Name="ModeTabs" Height="42"
                            Style="{StaticResource UnderlineTabControlStyle}"
                            SelectionChanged="ModeTabs_SelectionChanged">
                    <TabItem x:Name="ModeProgramming" Tag="Programming" IsSelected="True"
                             Header="{local:Loc ResourceKey=PromptBuilder_ModeProgramming}"
                             Style="{StaticResource PromptBuilderTabItemStyle}"
                             AutomationProperties.Name="{local:Loc ResourceKey=PromptBuilder_ModeProgramming}"/>
                    <TabItem x:Name="ModeImages" Tag="Images"
                             Header="{local:Loc ResourceKey=PromptBuilder_ModeImages}"
                             Style="{StaticResource PromptBuilderTabItemStyle}"
                             AutomationProperties.Name="{local:Loc ResourceKey=PromptBuilder_ModeImages}"/>
                    <TabItem x:Name="ModeTexts" Tag="Texts"
                             Header="{local:Loc ResourceKey=PromptBuilder_ModeTexts}"
                             Style="{StaticResource PromptBuilderTabItemStyle}"
                             AutomationProperties.Name="{local:Loc ResourceKey=PromptBuilder_ModeTexts}"/>
                    <TabItem x:Name="ModeVideoAudio" Tag="VideoAudio"
                             Header="{local:Loc ResourceKey=PromptBuilder_ModeVideoAudio}"
                             Style="{StaticResource PromptBuilderTabItemStyle}"
                             AutomationProperties.Name="{local:Loc ResourceKey=PromptBuilder_ModeVideoAudio}"/>
                    <TabItem x:Name="ModeAnalysisIdeas" Tag="AnalysisIdeas"
                             Header="{local:Loc ResourceKey=PromptBuilder_ModeAnalysisIdeas}"
                             Style="{StaticResource PromptBuilderTabItemStyle}"
                             AutomationProperties.Name="{local:Loc ResourceKey=PromptBuilder_ModeAnalysisIdeas}"/>
                </TabControl>
            </Border>

            <Border x:Name="ModeStatusHost" DockPanel.Dock="Top" Height="52" Margin="0,0,0,16"
                    Background="Transparent" BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1" CornerRadius="6">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   Foreground="{DynamicResource AccentColor}" Margin="0,0,12,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtModeDescription"
                                   FontSize="14" Foreground="{DynamicResource PrimaryText}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                    <Border x:Name="StatusBorder"
                            Background="{StaticResource PromptBuilderErrorBackgroundBrush}"
                            BorderBrush="{StaticResource PromptBuilderErrorBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="14,8"
                            Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive">
                        <TextBlock x:Name="TxtStatusMessage" TextWrapping="Wrap"
                                   FontSize="13" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="LimitBorder" DockPanel.Dock="Top"
                    Background="{StaticResource PromptBuilderWarningBackgroundBrush}"
                    BorderBrush="{StaticResource PromptBuilderWarningBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="14,10" Margin="0,0,0,12"
                    Visibility="Collapsed">
                <TextBlock Text="{local:Loc ResourceKey=TextProcessing_ErrorTooLong}"
                           FontSize="13" Foreground="{StaticResource PromptBuilderWarningBrush}"
                           TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
            </Border>

            <Grid DockPanel.Dock="Bottom" Height="52" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="FooterCommandColumn" Width="150"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{local:Loc ResourceKey=TextProcessing_ModelLabel}"
                           FontSize="13" Foreground="{DynamicResource MutedText}"
                           VerticalAlignment="Center"/>
                <ComboBox x:Name="CmbModels" Grid.Column="2"
                          Height="36" VerticalAlignment="Center"
                          SelectionChanged="CmbModels_SelectionChanged"
                          DropDownOpened="CmbModels_DropDownOpened"
                          AutomationProperties.Name="{local:Loc ResourceKey=TextProcessing_ModelLabel}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding FullDisplay}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding FullDisplay}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button x:Name="BtnRefreshModels" Grid.Column="3"
                        Width="36" Height="36" MinWidth="36" MaxWidth="36"
                        Padding="0" Margin="6,0,0,0"
                        HorizontalAlignment="Left"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Style="{StaticResource CommandButtonStyle}"
                        Click="BtnRefreshModels_Click"
                        ToolTip="{local:Loc ResourceKey=TextProcessing_RefreshModels}"
                        AutomationProperties.Name="{local:Loc ResourceKey=TextProcessing_RefreshModels}">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                </Button>

                <Button x:Name="BtnProcess" Grid.Column="5"
                        Style="{StaticResource PrimaryCommandButtonStyle}"
                        Click="BtnProcess_Click">
                    <TextBlock x:Name="ProcessButtonLabel" VerticalAlignment="Center"/>
                </Button>
            </Grid>

            <TextBlock DockPanel.Dock="Bottom"
                       Text="{local:Loc ResourceKey=PromptBuilder_DataWarning}"
                       FontSize="12" Foreground="{DynamicResource MutedText}"
                       TextWrapping="Wrap" Margin="0,4,0,0"
                       AutomationProperties.LiveSetting="Polite"/>

            <Grid MinHeight="284">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="738"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition x:Name="RailCommandColumn" Width="150"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="EditorCard" Grid.Column="0"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                        CornerRadius="8" Background="{StaticResource PromptBuilderCardBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="36"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBox x:Name="TxtEditor"
                                     Style="{StaticResource EditorTextBoxStyle}"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled"
                                     FontSize="17" TextBlock.LineHeight="27"
                                     Padding="12,10"
                                     AcceptsTab="False"
                                     IsUndoEnabled="True"
                                     UndoLimit="100"
                                     ContextMenu="{StaticResource TextEditingContextMenu}"
                                     TextChanged="TxtEditor_TextChanged"
                                     AutomationProperties.Name="{local:Loc ResourceKey=PromptBuilder_Title}"
                                     AutomationProperties.HelpText="{local:Loc ResourceKey=PromptBuilder_Placeholder}"/>
                            <RichTextBox x:Name="DiffViewer"
                                         Visibility="Collapsed"
                                         IsReadOnly="True"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="{DynamicResource PrimaryText}"
                                         FontSize="17"
                                         Padding="12,10"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Disabled"
                                         ContextMenu="{StaticResource TextEditingContextMenu}"
                                         AutomationProperties.Name="{local:Loc ResourceKey=TextProcessing_ButtonShowDiff}"/>
                            <TextBlock x:Name="TxtPlaceholder"
                                       Text="{local:Loc ResourceKey=PromptBuilder_Placeholder}"
                                       FontSize="17" Foreground="{DynamicResource MutedText}"
                                       Margin="13,11,0,0" TextWrapping="Wrap" IsHitTestVisible="False"
                                       Visibility="Visible"/>
                        </Grid>
                        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="0,1,0,0" Padding="12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtCounters"
                                           FontSize="13" Foreground="{DynamicResource MutedText}"
                                           VerticalAlignment="Center"
                                           AutomationProperties.LiveSetting="Polite"/>
                                <TextBlock x:Name="TxtModelState" Grid.Column="1"
                                           Margin="20,0,0,0"
                                           FontSize="12" Foreground="{DynamicResource MutedText}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Visibility="Collapsed"
                                           AutomationProperties.LiveSetting="Polite"/>
                                <Button x:Name="BtnOpenSettings" Grid.Column="1"
                                        Margin="20,0,0,0"
                                        FontSize="12" Padding="0"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Visibility="Collapsed" Background="Transparent"
                                        BorderThickness="0" Cursor="Hand"
                                        Click="BtnOpenSettings_Click">
                                    <TextBlock Text="{local:Loc ResourceKey=TextProcessing_OpenSettings}"
                                               Foreground="{DynamicResource AccentColor}"
                                               TextDecorations="Underline"/>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                    <Button x:Name="BtnPaste"
                            Style="{StaticResource CommandButtonStyle}"
                            Click="BtnPaste_Click" Margin="0,0,0,8"
                            AutomationProperties.Name="{local:Loc ResourceKey=TextProcessing_ButtonPaste}"
                            ToolTip="{local:Loc ResourceKey=TextProcessing_ButtonPaste}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE77F;" FontFamily="Segoe MDL2 Assets" FontSize="18" FontWeight="Normal" Margin="0,0,10,0"/>
                            <TextBlock Text="{local:Loc ResourceKey=TextProcessing_ButtonPaste}"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnCopy"
                            Style="{StaticResource CommandButtonStyle}"
                            Click="BtnCopy_Click" Margin="0,0,0,8"
                            AutomationProperties.Name="{local:Loc ResourceKey=TextProcessing_ButtonCopy}"
                            ToolTip="{local:Loc ResourceKey=TextProcessing_ButtonCopy}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="18" FontWeight="Normal" Margin="0,0,10,0"/>
                            <TextBlock Text="{local:Loc ResourceKey=TextProcessing_ButtonCopy}"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnRepeat"
                            Style="{StaticResource CommandButtonStyle}"
                            Click="BtnRepeat_Click" Margin="0,0,0,8"
                            IsEnabled="False"
                            AutomationProperties.Name="{local:Loc ResourceKey=TextProcessing_ButtonRepeat}"
                            ToolTip="{local:Loc ResourceKey=TextProcessing_ButtonRepeat}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="18" FontWeight="Normal" Margin="0,0,10,0"/>
                            <TextBlock Text="{local:Loc ResourceKey=TextProcessing_ButtonRepeat}"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnToggleVersion"
                            Style="{StaticResource CommandButtonStyle}"
                            Click="BtnToggleVersion_Click" Margin="0,0,0,8"
                            IsEnabled="False">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="ToggleVersionIcon"
                                       Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="18" FontWeight="Normal" Margin="0,0,10,0"/>
                            <TextBlock x:Name="ToggleVersionLabel"
                                       Text="{local:Loc ResourceKey=PromptBuilder_ButtonBeforeProcessing}"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnShowDiff"
                            Style="{StaticResource CommandButtonStyle}"
                            Click="BtnShowDiff_Click" Margin="0,0,0,8"
                            IsEnabled="False"
                            AutomationProperties.Name="{local:Loc ResourceKey=TextProcessing_ButtonShowDiff}"
                            ToolTip="{local:Loc ResourceKey=TextProcessing_ButtonShowDiff}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE8A1;" FontFamily="Segoe MDL2 Assets" FontSize="18" FontWeight="Normal" Margin="0,0,10,0"/>
                            <TextBlock x:Name="ShowDiffLabel"
                                       Text="{local:Loc ResourceKey=TextProcessing_ButtonShowDiff}"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnClear"
                            Style="{StaticResource CommandButtonStyle}"
                            Click="BtnClear_Click"
                            AutomationProperties.Name="{local:Loc ResourceKey=TextProcessing_ButtonClear}"
                            ToolTip="{local:Loc ResourceKey=TextProcessing_ButtonClear}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="18" FontWeight="Normal" Margin="0,0,10,0"/>
                            <TextBlock Text="{local:Loc ResourceKey=TextProcessing_ButtonClear}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

            </Grid>

                </DockPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</local:DarkWindow>
