<local:DarkWindow x:Class="AiteBar.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AiteBar"
        Icon="pack://application:,,,/Resources/app.ico"
        Title="{local:Loc ResourceKey=SettingsWindow_Title}" Width="880" SizeToContent="Height" MinHeight="500"
        WindowStartupLocation="CenterScreen" Background="#191919" Foreground="#DCDCDC"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsWindowResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>


        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <!-- EDIT BUTTON FORM -->
        <Grid Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0" Grid.ColumnSpan="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: FORM -->
                    <StackPanel Grid.Column="0" Margin="0,0,30,0">
                        <TextBlock Text="{local:Loc ResourceKey=SettingsWindow_ButtonName}" Foreground="{StaticResource MutedText}" Margin="0,0,0,5" FontSize="12"/>
                        <Grid Margin="0,0,0,15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <TextBox x:Name="TxtName" TextChanged="TxtName_TextChanged" GotFocus="TxtName_GotFocus" LostFocus="TxtName_LostFocus"/>
                                <TextBlock x:Name="TxtNamePlaceholder" Margin="{StaticResource FormInputPlaceholderMargin}" VerticalAlignment="Center" Foreground="{StaticResource PlaceholderForegroundBrush}" IsHitTestVisible="False" Text="{local:Loc ResourceKey=SettingsWindow_ButtonNamePlaceholder}"/>
                            </Grid>
                            <TextBlock x:Name="TxtNameError" Grid.Row="1" Margin="2,6,0,0" Foreground="{StaticResource FormControlErrorBorderBrush}" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"/>
                        </Grid>

                        <UniformGrid Columns="2" Margin="0,0,0,15">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="{local:Loc ResourceKey=SettingsWindow_ActionType}" Foreground="{StaticResource MutedText}" Margin="0,0,0,5" FontSize="12"/>
                                <ComboBox x:Name="CmbActionType" SelectionChanged="CmbActionType_SelectionChanged">
                        </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="{local:Loc ResourceKey=SettingsWindow_Panel}" Foreground="{StaticResource MutedText}" Margin="0,0,0,5" FontSize="12"/>
                                <ComboBox x:Name="CmbContext"/>
                            </StackPanel>
                        </UniformGrid>

                        <!-- Action Value -->
                        <StackPanel x:Name="PanelStandardAction">
                            <TextBlock x:Name="LblActionValue" Text="{local:Loc ResourceKey=SettingsWindow_UrlOrPath}" Foreground="{StaticResource MutedText}" Margin="0,0,0,5" FontSize="12"/>
                            <Grid Margin="0,0,0,15">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtActionValue" TextChanged="TxtActionValue_TextChanged" GotFocus="TxtActionValue_GotFocus" LostFocus="TxtActionValue_LostFocus"/>
                                    <TextBlock x:Name="TxtActionPlaceholder" Margin="{StaticResource FormInputPlaceholderMargin}" VerticalAlignment="Center" Foreground="{StaticResource PlaceholderForegroundBrush}" IsHitTestVisible="False"/>
                                    <Button x:Name="BtnBrowse" Grid.Column="1" Width="80" Margin="5,0,0,0" Click="BtnBrowse_Click" Style="{StaticResource FormSelectionButtonStyle}" Content="{local:Loc ResourceKey=Common_Browse}"/>
                                </Grid>
                                <TextBlock x:Name="TxtActionValueError" Grid.Row="1" Margin="2,6,0,0" Foreground="{StaticResource FormControlErrorBorderBrush}" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"/>
                            </Grid>

                            <!-- Browser Settings -->
                            <StackPanel x:Name="PanelWebSettings" Margin="0,0,0,15">
                                    <TextBlock Text="{local:Loc ResourceKey=SettingsWindow_Browser}" Foreground="{StaticResource MutedText}" Margin="0,0,0,5" FontSize="12"/>
                                    <ComboBox x:Name="CmbBrowser" SelectionChanged="CmbBrowser_SelectionChanged" Margin="0,0,0,15"/>

                                    <TextBlock Text="{local:Loc ResourceKey=SettingsWindow_Profile}" Foreground="{StaticResource MutedText}" Margin="0,0,0,5" FontSize="12"/>
                                    <Grid Margin="0,0,0,12">
                                        <TextBox x:Name="TxtProfile" IsReadOnly="True" Cursor="Hand" PreviewMouseDown="TxtProfile_PreviewMouseDown" Focusable="False"/>
                                        <TextBlock x:Name="TxtProfilePlaceholder" Margin="{StaticResource FormInputPlaceholderMargin}" VerticalAlignment="Center" Foreground="{StaticResource PlaceholderForegroundBrush}" IsHitTestVisible="False" Text="{local:Loc ResourceKey=SettingsWindow_ProfilePlaceholder}"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.Resources>
                                            <Style TargetType="CheckBox" BasedOn="{StaticResource DenseCheckBoxStyle}"/>
                                        </Grid.Resources>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="ChkAppMode" Grid.Column="0" Content="{local:Loc ResourceKey=SettingsWindow_AppMode}"/>
                                        <CheckBox x:Name="ChkIncognito" Grid.Column="1" Content="{local:Loc ResourceKey=SettingsWindow_Incognito}" Margin="5,2,0,2"/>
                                    </Grid>
                            </StackPanel>

                            <!-- Script Settings -->
                            <Border x:Name="PanelScriptSettings" Background="Transparent" CornerRadius="6" Padding="12" Margin="0,0,0,15" BorderThickness="1" BorderBrush="#3A3A3E" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="{local:Loc ResourceKey=SettingsWindow_ScriptArguments}" Foreground="{StaticResource MutedText}" Margin="0,0,0,4" FontSize="11"/>
                                    <Grid Margin="0,0,0,10">
                                        <TextBox x:Name="TxtScriptArguments" TextChanged="TxtScriptArguments_TextChanged"/>
                                        <TextBlock x:Name="TxtScriptArgumentsPlaceholder" Margin="{StaticResource FormInputPlaceholderMargin}" VerticalAlignment="Center" Foreground="{StaticResource PlaceholderForegroundBrush}" IsHitTestVisible="False" Text="{local:Loc ResourceKey=SettingsWindow_ScriptArgumentsPlaceholder}"/>
                                    </Grid>
                                    <StackPanel>
                                        <StackPanel.Resources>
                                            <Style TargetType="CheckBox" BasedOn="{StaticResource DenseCheckBoxStyle}"/>
                                        </StackPanel.Resources>
                                        <CheckBox x:Name="ChkSkipScriptConfirmation" IsChecked="True" Content="{local:Loc ResourceKey=SettingsWindow_SkipScriptConfirmation}" Margin="0,0,0,4"/>
                                        <CheckBox x:Name="ChkScriptHideWindow" Content="{local:Loc ResourceKey=SettingsWindow_ScriptHideWindow}" Margin="0,0,0,4" Checked="ChkScriptHideWindow_Changed" Unchecked="ChkScriptHideWindow_Changed"/>
                                        <CheckBox x:Name="ChkScriptKeepOpen" IsChecked="True" Content="{local:Loc ResourceKey=SettingsWindow_ScriptKeepOpen}" Margin="0,0,0,4"/>
                                        <CheckBox x:Name="ChkScriptRunAsAdmin" Content="{local:Loc ResourceKey=SettingsWindow_ScriptRunAsAdmin}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Hotkey Settings -->
                        <StackPanel x:Name="PanelHotkeyAction" Visibility="Collapsed" Margin="0,0,0,15">
                            <TextBlock Text="{local:Loc ResourceKey=SettingsWindow_HotkeyCombination}" Foreground="{StaticResource MutedText}" Margin="0,0,0,5" FontSize="12"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <StackPanel.Resources>
                                    <Style TargetType="CheckBox" BasedOn="{StaticResource InlineCheckBoxStyle}"/>
                                </StackPanel.Resources>
                                <CheckBox x:Name="ChkCtrl" Content="Ctrl"/>
                                <CheckBox x:Name="ChkShift" Content="Shift"/>
                                <CheckBox x:Name="ChkAlt" Content="Alt"/>
                                <CheckBox x:Name="ChkWin" Content="Win"/>
                            </StackPanel>
                            <ComboBox x:Name="CmbKey" Width="200" HorizontalAlignment="Left" SelectionChanged="CmbKey_SelectionChanged"/>
                        </StackPanel>

                <Border x:Name="ActionHelpBox" Background="#383838" Padding="10" CornerRadius="4" Visibility="Collapsed">
                            <TextBlock x:Name="TxtActionHelp" Foreground="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>

                    <!-- RIGHT: PREVIEW & COLORS -->
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{local:Loc ResourceKey=SettingsWindow_IconPicker}" Foreground="{StaticResource MutedText}" Margin="0,0,0,5" FontSize="12"/>
                        <Border Background="Transparent" CornerRadius="8" Padding="20" BorderThickness="1" BorderBrush="#3A3A3E" VerticalAlignment="Top">
                            <StackPanel x:Name="MiddleColumnGrid">
                                <!-- Icon Preview and Source Buttons -->
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                            
                                    <Border x:Name="BorderPreview" Grid.Column="0" Background="#383838" Width="80" Height="80" CornerRadius="12" BorderThickness="1" BorderBrush="#3A3A3E" Cursor="Hand" MouseLeftButtonDown="BorderPreview_MouseLeftButtonDown">
                                        <Grid>
                                            <TextBlock x:Name="PreviewIcon" Text="&#xF45B;" FontFamily="pack://application:,,,/Resources/#FluentSystemIcons-Regular" FontSize="36" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image x:Name="PreviewImage" Width="64" Height="64" Stretch="Uniform" Visibility="Collapsed"/>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                                        <Button x:Name="BtnOpenCatalog" Style="{StaticResource FormSelectionButtonStyle}" Content="{local:Loc ResourceKey=SettingsWindow_ChooseFromLibrary}" Click="BtnOpenCatalog_Click" Margin="0,0,0,10"/>
                                        <Button x:Name="BtnSelectCustomIcon" Style="{StaticResource FormSelectionButtonStyle}" Content="{local:Loc ResourceKey=SettingsWindow_CustomIcon}" Click="BtnSelectCustomIcon_Click"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{local:Loc ResourceKey=SettingsWindow_IconColor}" Foreground="{StaticResource MutedText}" Margin="0,0,0,10" FontSize="12"/>
                                <UniformGrid x:Name="GridColors" Columns="5" Margin="0,0,0,15"/>
                        
                                <!-- Скрытый HEX ввод для обратной совместимости кода -->
                                <Grid Margin="0,0,0,5" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="#" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" Margin="0,0,5,0"/>
                                    <TextBox x:Name="TxtHexColor" Grid.Column="1" TextChanged="TxtHexColor_TextChanged"/>
                                    <TextBlock x:Name="TxtHexPlaceholder" Grid.Column="1" Margin="{StaticResource FormInputPlaceholderMargin}" VerticalAlignment="Center" Foreground="{StaticResource PlaceholderForegroundBrush}" IsHitTestVisible="False" Text="{local:Loc ResourceKey=SettingsWindow_HexPlaceholder}" Visibility="Collapsed"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- BOTTOM: BUTTONS -->
            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,15,0,0">
                <Border BorderBrush="#3A3A3E" BorderThickness="0,1,0,0" Margin="0,0,0,15"/>
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button x:Name="BtnCancel" Style="{StaticResource CommandButtonStyle}" Content="{local:Loc ResourceKey=Common_Cancel}" Click="BtnCancel_Click" Width="150" Margin="0,0,10,0" IsCancel="True"/>
                    <Button x:Name="BtnSave" Style="{StaticResource PrimaryCommandButtonStyle}" Content="{local:Loc ResourceKey=Common_Save}" Click="BtnSave_Click" Width="180" IsDefault="True"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Grid>
    </Grid>
</local:DarkWindow>
